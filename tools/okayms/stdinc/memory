// okay-ms own standard header: std::unique_ptr and std::make_unique, written from ISO/IEC 14882 [unique.ptr]. Own
// minimal version: one owner, deleted with `delete` (no custom deleter, no array form), moved with std::move, not
// copyable. std::shared_ptr is not here (it needs a thread-safe reference count, which this compiler cannot make yet).
#pragma once
#include <cstddef>
#include <utility>
namespace std {
template <typename T>
class unique_ptr {
    T* p_;

public:
    typedef T element_type;
    unique_ptr() : p_(0) {}
    unique_ptr(T* p) : p_(p) {}
    unique_ptr(unique_ptr&& other) : p_(other.p_) { other.p_ = 0; }
    ~unique_ptr() {
        if (p_) delete p_;
    }
    unique_ptr& operator=(unique_ptr&& other) {
        if (this != &other) {
            T* old = p_;
            p_ = other.p_;
            other.p_ = 0;
            if (old) delete old;
        }
        return *this;
    }
    T* get() const { return p_; }
    T& operator*() const { return *p_; }
    T* operator->() const { return p_; }
    T* release() {
        T* p = p_;
        p_ = 0;
        return p;
    }
    void reset() {
        T* old = p_;
        p_ = 0;
        if (old) delete old;
    }
    void reset(T* p) {
        T* old = p_;
        p_ = p;
        if (old) delete old;
    }
    bool operator!() const { return p_ == 0; }
    explicit operator bool() const { return p_ != 0; }
};
template <typename T> unique_ptr<T> make_unique() { return unique_ptr<T>(new T()); }
template <typename T, typename A> unique_ptr<T> make_unique(const A& a) { return unique_ptr<T>(new T(a)); }
template <typename T, typename A, typename B> unique_ptr<T> make_unique(const A& a, const B& b) { return unique_ptr<T>(new T(a, b)); }
}
