// <cstdlib> for okay-cc (ISO/IEC 14882 [cstdlib.syn], ISO C 7.22). Our own header: the memory and
// number functions of lib/alloc.c, lib/exit.c, lib/str.c and lib/extra.c (atoi, atol, the strtol
// family, strtod, strtof, atof), getenv (lib/extra.c) and abs for the integer types.
#pragma once
extern "C" {
void *malloc(unsigned long n);
void *calloc(unsigned long n, unsigned long size);
void *realloc(void *p, unsigned long n);
void free(void *p);
void exit(int code);
void abort(void);
int atoi(const char *s);
long atol(const char *s);
long strtol(const char *s, char **end, int base);
unsigned long strtoul(const char *s, char **end, int base);
long long strtoll(const char *s, char **end, int base);
unsigned long long strtoull(const char *s, char **end, int base);
double strtod(const char *s, char **end);
float strtof(const char *s, char **end);
double atof(const char *s);
char *getenv(const char *name);
}
