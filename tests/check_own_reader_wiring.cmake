# Run with: cmake -DROOT_CMAKE=<CMakeLists.txt> -DENGINE_CMAKE=<engine/CMakeLists.txt> -DMODEL_IMPORT=<ModelImport.cpp> -P check_own_reader_wiring.cmake
#
# Every opt-in own reader in the import table (the rows of kOptIn[] in ModelImport.cpp that name an environment variable
# OKAY_OWN_<FMT>) must be wired in four places, or "-DOKAY_OWN_<FMT>=ON" silently does nothing:
#   1. an option(OKAY_OWN_<FMT> ...) in the root CMakeLists.txt,
#   2. a place in engine/CMakeLists.txt that turns the option into the compile definition OKAY_OWN_<FMT>_DEFAULT: either a literal
#      target_compile_definitions(... OKAY_OWN_<FMT>_DEFAULT) or the name in a foreach(_fmt ...) loop whose body defines
#      OKAY_OWN_${_fmt}_DEFAULT,
#   3. an #ifdef OKAY_OWN_<FMT>_DEFAULT in ModelImport.cpp (it is what the table row reads),
#   4. a CMake option that is not in the table at all (an option that reads "Read .xyz ... with our own" but has no row) is an error too.
# A merge once dropped a name from the loop of (2) and nothing failed. This check fails with the names that are missing.
cmake_minimum_required(VERSION 3.16)
foreach(_v ROOT_CMAKE ENGINE_CMAKE MODEL_IMPORT)
    if(NOT EXISTS "${${_v}}")
        message(FATAL_ERROR "check_own_reader_wiring: ${_v} (${${_v}}) does not exist")
    endif()
endforeach()
file(READ "${ROOT_CMAKE}" _root)
file(READ "${ENGINE_CMAKE}" _engine)
file(READ "${MODEL_IMPORT}" _import)

# the table rows: {"OKAY_OWN_XXX",
string(REGEX MATCHALL "\\{\"OKAY_OWN_[A-Z0-9_]+\"" _rows "${_import}")
set(_table "")
foreach(_r IN LISTS _rows)
    string(REGEX REPLACE "^\\{\"OKAY_OWN_([A-Z0-9_]+)\"$" "\\1" _n "${_r}")
    list(APPEND _table "${_n}")
endforeach()
list(LENGTH _table _count)
if(_count LESS 20)
    message(FATAL_ERROR "check_own_reader_wiring: found only ${_count} rows in kOptIn[] of ${MODEL_IMPORT}: the table format changed, update this check")
endif()

# every name that sits in a foreach(_fmt ...) / foreach(_f ...) list of the engine file whose body defines OKAY_OWN_${_fmt}_DEFAULT
set(_looped "")
string(REGEX MATCHALL "foreach\\(_fmt[^)]*\\)" _heads "${_engine}")
foreach(_h IN LISTS _heads)
    string(REGEX REPLACE "^foreach\\(_fmt[ \t\n]*" "" _list "${_h}")
    string(REGEX REPLACE "\\)$" "" _list "${_list}")
    string(REGEX REPLACE "[ \t\n]+" ";" _list "${_list}")
    # the list may be a variable: foreach(_fmt ${NAME}) or foreach(_fmt IN LISTS NAME); expand set(NAME a b c) from the file
    set(_expanded "")
    set(_pending ${_list})
    set(_guard 0)
    while(_pending AND _guard LESS 200)
        math(EXPR _guard "${_guard}+1")
        list(POP_FRONT _pending _w)
        if(_w STREQUAL "IN" OR _w STREQUAL "LISTS" OR _w STREQUAL "")
            continue()
        endif()
        if(_w MATCHES "^\\$\\{([A-Za-z0-9_]+)\\}$")
            set(_var "${CMAKE_MATCH_1}")
        elseif(_list MATCHES "(^|;)IN;LISTS;" AND _w MATCHES "^[A-Za-z0-9_]+$" AND _w MATCHES "[a-z]")
            set(_var "${_w}")
        else()
            list(APPEND _expanded "${_w}")
            continue()
        endif()
        if(_engine MATCHES "set\\(${_var}[ \t\n]+([^)]*)\\)")
            string(REGEX REPLACE "[ \t\n]+" ";" _vals "${CMAKE_MATCH_1}")
            list(PREPEND _pending ${_vals})
        else()
            message(FATAL_ERROR "check_own_reader_wiring: foreach(_fmt ... ${_var} ...) uses a list this check cannot expand (no set(${_var} ...) in engine/CMakeLists.txt): update this check")
        endif()
    endwhile()
    set(_list ${_expanded})
    # only the loops that really define the compile definition count (the Assimp importer loop does not)
    string(FIND "${_engine}" "${_h}" _pos)
    string(SUBSTRING "${_engine}" ${_pos} 400 _body)
    if(_body MATCHES "OKAY_OWN_\\$\\{_fmt\\}_DEFAULT")
        list(APPEND _looped ${_list})
    endif()
endforeach()

set(_problems "")
foreach(_n IN LISTS _table)
    string(REGEX MATCH "option\\(OKAY_OWN_${_n}[ \t]" _opt "${_root}")
    if(NOT _opt)
        string(APPEND _problems "  OKAY_OWN_${_n}: no option(OKAY_OWN_${_n} ...) in the root CMakeLists.txt\n")
    endif()
    set(_defined FALSE)
    if(_n IN_LIST _looped)
        set(_defined TRUE)
    endif()
    string(REGEX MATCH "(target_compile_definitions\\(okay_engine PRIVATE|COMPILE_DEFINITIONS) OKAY_OWN_${_n}_DEFAULT\\)" _lit "${_engine}")
    if(_lit)
        set(_defined TRUE)
    endif()
    if(NOT _defined)
        string(APPEND _problems "  OKAY_OWN_${_n}: not in any foreach(_fmt ...) loop of engine/CMakeLists.txt that defines OKAY_OWN_<FMT>_DEFAULT, and no literal target_compile_definitions for it: -DOKAY_OWN_${_n}=ON would do nothing\n")
    endif()
    if(NOT _import MATCHES "#ifdef OKAY_OWN_${_n}_DEFAULT[ \t\r\n]")
        string(APPEND _problems "  OKAY_OWN_${_n}: no #ifdef OKAY_OWN_${_n}_DEFAULT in ModelImport.cpp\n")
    endif()
endforeach()

# the reverse: an option that says it reads a format with our own reader but is not in the table
string(REGEX MATCHALL "option\\(OKAY_OWN_[A-Z0-9_]+[ \t]+\"Read \\." _readOpts "${_root}")
foreach(_o IN LISTS _readOpts)
    string(REGEX REPLACE "^option\\(OKAY_OWN_([A-Z0-9_]+)[ \t]+.*$" "\\1" _n "${_o}")
    if(NOT _n IN_LIST _table)
        string(APPEND _problems "  OKAY_OWN_${_n}: an option that reads a format, but no row in kOptIn[]\n")
    endif()
endforeach()

if(_problems)
    message(FATAL_ERROR "own reader wiring is incomplete:\n${_problems}")
endif()
list(LENGTH _table _n)
message(STATUS "own reader wiring: ${_n} opt-in readers, each has its option, its compile definition and its #ifdef")
