// okay-ms own standard header: <clocale> ([clocale.syn]): the declarations only. A program that calls setlocale needs a C library
// that has it (okay-ms's runtime does not): the declaration is here so that code naming it compiles.
#pragma once
namespace std {
extern "C" char *setlocale(int category, const char *locale);
// localeconv ([locale.syn]): the "C" locale's numeric conventions, the only locale here.
struct lconv {
    char* decimal_point;
    char* thousands_sep;
    char* grouping;
};
inline lconv* localeconv() {
    static lconv conv = {(char*)".", (char*)"", (char*)""};
    return &conv;
}
}
#define LC_ALL 0
#define LC_NUMERIC 4
