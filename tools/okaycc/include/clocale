// <clocale> for okay-cc (ISO/IEC 14882 [c.locales], ISO C 7.11). Our own header. Only the "C"
// locale exists: setlocale accepts "C", "POSIX" and "" (which is "C" here) and refuses the rest;
// localeconv describes the C locale (decimal point ".", no grouping, CHAR_MAX for the numbers).
#pragma once
#include <cstring>
#define LC_CTYPE 0
#define LC_NUMERIC 1
#define LC_TIME 2
#define LC_COLLATE 3
#define LC_MONETARY 4
#define LC_MESSAGES 5
#define LC_ALL 6
namespace std {
struct lconv {
    char *decimal_point;
    char *thousands_sep;
    char *grouping;
    char *int_curr_symbol;
    char *currency_symbol;
    char *mon_decimal_point;
    char *mon_thousands_sep;
    char *mon_grouping;
    char *positive_sign;
    char *negative_sign;
    char int_frac_digits;
    char frac_digits;
    char p_cs_precedes;
    char p_sep_by_space;
    char n_cs_precedes;
    char n_sep_by_space;
    char p_sign_posn;
    char n_sign_posn;
};
inline lconv *localeconv() {
    static lconv c;
    static int made = 0;
    if (!made) {
        made = 1;
        c.decimal_point = (char *)".";
        c.thousands_sep = (char *)"";
        c.grouping = (char *)"";
        c.int_curr_symbol = (char *)"";
        c.currency_symbol = (char *)"";
        c.mon_decimal_point = (char *)"";
        c.mon_thousands_sep = (char *)"";
        c.mon_grouping = (char *)"";
        c.positive_sign = (char *)"";
        c.negative_sign = (char *)"";
        c.int_frac_digits = 127;
        c.frac_digits = 127;
        c.p_cs_precedes = 127;
        c.p_sep_by_space = 127;
        c.n_cs_precedes = 127;
        c.n_sep_by_space = 127;
        c.p_sign_posn = 127;
        c.n_sign_posn = 127;
    }
    return &c;
}
inline char *setlocale(int category, const char *name) {
    (void)category;
    if (!name || !*name || strcmp(name, "C") == 0 || strcmp(name, "POSIX") == 0) return (char *)"C";
    return nullptr;
}
}  // namespace std
using std::lconv;
using std::localeconv;
using std::setlocale;
