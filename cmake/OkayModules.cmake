# Engine modules, stage 0 (docs/design/modular_gameplay_contracts.md, section 9, PR 1): group the engine's source files
# into modules and label the tests by module. Nothing is moved and nothing changes in the build: okay_engine keeps its one
# source list, in the same order, and links into the same programs. The groups are bookkeeping that later stages build on
# (per-module libraries, the size report, stripping).
#
# Each module is a folder engine/modules/<name>/ with a module.okaymodule file (key=value lines, # comments):
#   name=      lower-case id                     requires=  modules it needs (comma separated)
#   core=1     the always-on core                sources=   engine/-relative file patterns it owns (space separated, * = anything;
#                                                           the most specific pattern wins when two modules match a file)
#   tests=     test name patterns (space separated, * = anything), the tests that get the ctest label module:<name>
# Other keys (title, components, serializers, ...) are read by the engine's ModuleManifest parser in a later stage.
#
#   okay_add_module(<name> [REQUIRES <module>...] [SOURCES <pattern>...] [TESTS <pattern>...])  declare one module
#   okay_modules_read()             declare every module from engine/modules/*/module.okaymodule (checks names and requires)
#   okay_modules_group(<target>)    (call in the folder that made <target>, after its last target_sources) put each source of <target> in the first module whose sources= matches it, else core;
#                                   writes <build>/okay_modules.tsv ("module<TAB>file") and the source property OKAY_MODULE
#   okay_modules_label_tests()      in a tests folder (deferred to its end): label every test module:<name> (module:core when none claims it)
#
# Written for this repository from the design document; no outside code.

# A file pattern ("src/Render/*Reader.cpp") or a test pattern ("net_*") as a regular expression.
function(_okay_glob_regex pattern any out)
    string(REGEX REPLACE "([][.+?^$(){}|\\\\])" "\\\\\\1" _r "${pattern}")
    string(REPLACE "*" "${any}" _r "${_r}")
    set(${out} "^${_r}$" PARENT_SCOPE)
endfunction()

function(okay_add_module name)
    cmake_parse_arguments(M "CORE" "" "REQUIRES;SOURCES;TESTS" ${ARGN})
    if(NOT name MATCHES "^[a-z0-9_]+$")
        message(FATAL_ERROR "okay_add_module: '${name}' is not a module name (lower-case letters, digits and _)")
    endif()
    get_property(_names GLOBAL PROPERTY OKAY_MODULE_NAMES)
    if(name IN_LIST _names)
        message(FATAL_ERROR "okay_add_module: module '${name}' is declared twice")
    endif()
    set_property(GLOBAL APPEND PROPERTY OKAY_MODULE_NAMES "${name}")
    set_property(GLOBAL PROPERTY OKAY_MODULE_REQUIRES_${name} "${M_REQUIRES}")
    set_property(GLOBAL PROPERTY OKAY_MODULE_SOURCES_${name} "${M_SOURCES}")
    set_property(GLOBAL PROPERTY OKAY_MODULE_TESTS_${name} "${M_TESTS}")
    set_property(GLOBAL PROPERTY OKAY_MODULE_CORE_${name} "${M_CORE}")
endfunction()

# Fails configure on a module that requires one that does not exist, or on a requirement cycle.
function(_okay_modules_check)
    get_property(_names GLOBAL PROPERTY OKAY_MODULE_NAMES)
    foreach(_n IN LISTS _names)
        get_property(_req GLOBAL PROPERTY OKAY_MODULE_REQUIRES_${_n})
        foreach(_r IN LISTS _req)
            if(NOT _r IN_LIST _names)
                message(FATAL_ERROR "module '${_n}' requires '${_r}', which is not a module (engine/modules/${_n}/module.okaymodule)")
            endif()
        endforeach()
    endforeach()
    # cycle check: repeatedly take away modules whose requirements are all taken away already
    set(_left "${_names}")
    set(_done "")
    set(_moved TRUE)
    while(_moved)
        set(_moved FALSE)
        set(_next "")
        foreach(_n IN LISTS _left)
            get_property(_req GLOBAL PROPERTY OKAY_MODULE_REQUIRES_${_n})
            set(_ready TRUE)
            foreach(_r IN LISTS _req)
                if(NOT _r IN_LIST _done AND NOT _r STREQUAL _n)
                    set(_ready FALSE)
                endif()
            endforeach()
            if(_ready)
                list(APPEND _done "${_n}")
                set(_moved TRUE)
            else()
                list(APPEND _next "${_n}")
            endif()
        endforeach()
        set(_left "${_next}")
    endwhile()
    if(_left)
        string(REPLACE ";" ", " _l "${_left}")
        message(FATAL_ERROR "module requirements form a cycle among: ${_l}")
    endif()
endfunction()

function(okay_modules_read)
    file(GLOB _manifests "${PROJECT_SOURCE_DIR}/engine/modules/*/module.okaymodule")
    list(SORT _manifests)
    foreach(_m IN LISTS _manifests)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_m}")
        file(STRINGS "${_m}" _lines)
        set(_name "")
        set(_req "")
        set(_src "")
        set(_tests "")
        set(_core "")
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "^name=(.*)$")
                set(_name "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^requires=(.*)$")
                string(REPLACE "," ";" _req "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^sources=(.*)$")
                separate_arguments(_src UNIX_COMMAND "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^tests=(.*)$")
                separate_arguments(_tests UNIX_COMMAND "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^core=(1|on|true|yes)$")
                set(_core CORE)
            endif()
        endforeach()
        string(STRIP "${_name}" _name)
        list(TRANSFORM _req STRIP)
        list(REMOVE_ITEM _req "" "core")   # every module may use the core
        okay_add_module("${_name}" ${_core} REQUIRES ${_req} SOURCES ${_src} TESTS ${_tests})
    endforeach()
    _okay_modules_check()
endfunction()

function(okay_modules_group target)
    get_target_property(_srcs ${target} SOURCES)
    get_target_property(_dir ${target} SOURCE_DIR)
    get_property(_names GLOBAL PROPERTY OKAY_MODULE_NAMES)
    set(_tsv "")
    set(_inmod 0)
    set(_incore 0)
    foreach(_s IN LISTS _srcs)
        if(IS_ABSOLUTE "${_s}")
            file(RELATIVE_PATH _rel "${_dir}" "${_s}")
        else()
            set(_rel "${_s}")
        endif()
        # The most specific pattern wins: the one with the longest fixed start before its first *. On a tie the module
        # that comes first by name wins. (scripts/check_modules.py uses the same rule.)
        set(_owner "core")
        set(_best -1)
        foreach(_n IN LISTS _names)
            get_property(_pats GLOBAL PROPERTY OKAY_MODULE_SOURCES_${_n})
            foreach(_p IN LISTS _pats)
                _okay_glob_regex("${_p}" ".*" _re)
                if(_rel MATCHES "${_re}")
                    string(FIND "${_p}" "*" _lit)
                    if(_lit EQUAL -1)
                        string(LENGTH "${_p}" _lit)
                    endif()
                    if(_lit GREATER _best)
                        set(_owner "${_n}")
                        set(_best ${_lit})
                    endif()
                endif()
            endforeach()
        endforeach()
        if(_rel MATCHES "^modules/([a-z0-9_]+)/" AND CMAKE_MATCH_1 IN_LIST _names)
            set(_owner "${CMAKE_MATCH_1}")   # engine/modules/<name>/register.cpp and friends
        endif()
        if(_owner STREQUAL "core")
            math(EXPR _incore "${_incore} + 1")
        else()
            math(EXPR _inmod "${_inmod} + 1")
        endif()
        set_property(GLOBAL APPEND PROPERTY OKAY_MODULE_FILES_${_owner} "${_rel}")
        set_source_files_properties("${_s}" PROPERTIES OKAY_MODULE "${_owner}")
        string(APPEND _tsv "${_owner}\t${_rel}\n")
    endforeach()
    set(_out "${CMAKE_BINARY_DIR}/okay_modules.tsv")
    set(_old "")
    if(EXISTS "${_out}")
        file(READ "${_out}" _old)
    endif()
    if(NOT _old STREQUAL _tsv)
        file(WRITE "${_out}" "${_tsv}")
    endif()
    list(LENGTH _names _count)
    message(STATUS "OkaySpace: ${_count} engine modules; ${_inmod} files of ${target} in modules, ${_incore} in core (okay_modules.tsv)")
endfunction()

function(okay_modules_label_tests)
    get_property(_tests DIRECTORY PROPERTY TESTS)
    get_property(_names GLOBAL PROPERTY OKAY_MODULE_NAMES)
    set(_res "")
    foreach(_n IN LISTS _names)
        get_property(_pats GLOBAL PROPERTY OKAY_MODULE_TESTS_${_n})
        set(_r "")
        foreach(_p IN LISTS _pats)
            _okay_glob_regex("${_p}" ".*" _re)
            list(APPEND _r "${_re}")
        endforeach()
        set(_RE_${_n} "${_r}")
    endforeach()
    foreach(_t IN LISTS _tests)
        set(_hit FALSE)
        foreach(_n IN LISTS _names)
            foreach(_re IN LISTS _RE_${_n})
                if(_t MATCHES "${_re}")
                    set_property(TEST "${_t}" APPEND PROPERTY LABELS "module:${_n}")
                    set(_hit TRUE)
                    break()
                endif()
            endforeach()
        endforeach()
        if(NOT _hit)
            set_property(TEST "${_t}" APPEND PROPERTY LABELS "module:core")
        endif()
    endforeach()
endfunction()

# okay_modules_generate(<out_cpp>): the engine's list of modules, as C++. Every manifest's text is embedded (the engine's
# ModuleManifest parser reads it at start), every module is on in this stage, and the Register_<name> function of each
# module that has engine/modules/<name>/register.cpp is handed to the ModuleRegistry (none exist yet). Written only when
# the text changes, so a re-configure does not rebuild.
function(okay_modules_generate out_cpp)
    file(GLOB _manifests "${PROJECT_SOURCE_DIR}/engine/modules/*/module.okaymodule")
    list(SORT _manifests)
    set(_reg "")
    set(_adds "")
    foreach(_m IN LISTS _manifests)
        get_filename_component(_d "${_m}" DIRECTORY)
        get_filename_component(_n "${_d}" NAME)
        file(READ "${_m}" _text)
        if(_text MATCHES "\\)OKAYMOD\"")
            message(FATAL_ERROR "${_m} contains the text )OKAYMOD\" which ends the embedded string; reword it")
        endif()
        string(APPEND _adds "    r.AddText(R\"OKAYMOD(${_text})OKAYMOD\", true);\n")
        if(EXISTS "${_d}/register.cpp")
            list(APPEND _reg "${_n}")
            set_property(GLOBAL APPEND PROPERTY OKAY_MODULE_REGISTER_SOURCES "${_d}/register.cpp")
        endif()
    endforeach()
    set(_body "// GENERATED by cmake/OkayModules.cmake from engine/modules/*/module.okaymodule. Do not edit.\n")
    string(APPEND _body "#include \"okay/Modules/ModuleRegistry.hpp\"\n\nnamespace okay {\nnamespace modules {\n")
    foreach(_n IN LISTS _reg)
        string(APPEND _body "void Register_${_n}(ModuleContext&);\n")
    endforeach()
    string(APPEND _body "} // namespace modules\nnamespace detail {\n\nvoid RegisterGeneratedModules(ModuleRegistry& r) {\n${_adds}")
    foreach(_n IN LISTS _reg)
        string(APPEND _body "    r.SetRegisterHook(\"${_n}\", &modules::Register_${_n});\n")
    endforeach()
    string(APPEND _body "}\n\n} // namespace detail\n} // namespace okay\n")
    set(_old "")
    if(EXISTS "${out_cpp}")
        file(READ "${out_cpp}" _old)
    endif()
    if(NOT _old STREQUAL _body)
        file(WRITE "${out_cpp}" "${_body}")
    endif()
endfunction()
