// Wobble: a jelly-like surface. The vertex block pushes every vertex in and out
// along its normal with two crossing waves that move with time. Works on any
// mesh with normals (Sphere, Capsule, imported models).
shader "Wobble";

property float amount = 0.08 range(0, 0.4);
property float speed = 3.0 range(0, 12);
property float ripples = 12.0 range(1, 40);
property color tint = (0.35, 0.85, 0.45);

vertex {
    float w = sin(time * speed + local.y * ripples) * cos(time * speed * 0.7 + local.x * ripples * 0.6);
    position += normal * (w * amount);
}

surface {
    albedo = albedo * tint;
    specular = 0.4;
    shininess = 40.0;
}
