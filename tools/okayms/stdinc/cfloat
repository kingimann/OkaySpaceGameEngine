// okay-ms own standard header: the characteristics of the floating types, written from ISO/IEC 9899 5.2.4.2.2 for the
// IEEE 754 binary32 (float) and binary64 (double and long double) formats that okay-ms uses. Each value was worked
// out from the format (FLT_MAX = (2 - 2^-23) * 2^127, FLT_MIN = 2^-126, FLT_EPSILON = 2^-23, and the same for double
// with 52 and 1023) and written with enough digits to round to that value.
#pragma once
#define FLT_RADIX 2
#define FLT_MANT_DIG 24
#define DBL_MANT_DIG 53
#define LDBL_MANT_DIG 53
#define FLT_DIG 6
#define DBL_DIG 15
#define LDBL_DIG 15
#define FLT_MIN_EXP (-125)
#define DBL_MIN_EXP (-1021)
#define FLT_MAX_EXP 128
#define DBL_MAX_EXP 1024
#define FLT_MIN_10_EXP (-37)
#define DBL_MIN_10_EXP (-307)
#define FLT_MAX_10_EXP 38
#define DBL_MAX_10_EXP 308
#define FLT_MAX 3.40282347e+38F
#define FLT_MIN 1.17549435e-38F
#define FLT_EPSILON 1.19209290e-07F
#define DBL_MAX 1.7976931348623157e+308
#define DBL_MIN 2.2250738585072014e-308
#define DBL_EPSILON 2.2204460492503131e-16
#define LDBL_MAX DBL_MAX
#define LDBL_MIN DBL_MIN
#define LDBL_EPSILON DBL_EPSILON
#define FLT_EVAL_METHOD 0
#define DECIMAL_DIG 17
