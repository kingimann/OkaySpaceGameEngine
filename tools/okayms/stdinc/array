// okay-ms own standard header: std::array, written from ISO/IEC 14882 [array] (class template array: an aggregate
// holding N elements, element access, iterators as pointers, size, fill). No exceptions: at() does not check.
#pragma once
#include <cstddef>
#include <iterator>
namespace std {
template <typename T, size_t N>
struct array {
    T elems_[N];
    typedef T value_type;
    typedef size_t size_type;
    typedef T* iterator;
    typedef const T* const_iterator;
    T& operator[](size_t i) { return elems_[i]; }
    const T& operator[](size_t i) const { return elems_[i]; }
    T& at(size_t i) { return elems_[i]; }
    const T& at(size_t i) const { return elems_[i]; }
    T& front() { return elems_[0]; }
    const T& front() const { return elems_[0]; }
    T& back() { return elems_[N - 1]; }
    const T& back() const { return elems_[N - 1]; }
    T* data() { return elems_; }
    const T* data() const { return elems_; }
    T* begin() { return elems_; }
    const T* begin() const { return elems_; }
    T* end() { return elems_ + N; }
    const T* end() const { return elems_ + N; }
    std::reverse_iterator<T*> rbegin() { return std::reverse_iterator<T*>(elems_ + N); }
    std::reverse_iterator<const T*> rbegin() const { return std::reverse_iterator<const T*>(elems_ + N); }
    std::reverse_iterator<T*> rend() { return std::reverse_iterator<T*>(elems_); }
    std::reverse_iterator<const T*> rend() const { return std::reverse_iterator<const T*>(elems_); }
    size_t size() const { return N; }
    size_t max_size() const { return N; }
    bool empty() const { return N == 0; }
    void fill(const T& value) { for (size_t i = 0; i < N; ++i) elems_[i] = value; }
};
}
