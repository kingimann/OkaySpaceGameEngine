*3DSMAX_ASCIIEXPORT	200
*COMMENT "synthetic fixture for the own ASE reader"
*SCENE {
	*SCENE_FILENAME "fixture.max"
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 30
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 2
	*MATERIAL 0 {
		*MATERIAL_NAME "plain"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0.2 0.2 0.2
		*MATERIAL_DIFFUSE 0.5 0.25 0.125
		*MATERIAL_SPECULAR 0.9 0.9 0.9
		*MATERIAL_SHINE 0.25
		*MATERIAL_TRANSPARENCY 0.5
		*MAP_DIFFUSE {
			*MAP_NAME "skin"
			*MAP_CLASS "Bitmap"
			*BITMAP "C:\Art\skin.jpg"
			*UVW_U_TILING 2.0000
			*UVW_V_TILING 1.0000
		}
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "multi"
		*MATERIAL_CLASS "Multi/Sub-Object"
		*NUMSUBMTLS 2
		*SUBMATERIAL 0 {
			*MATERIAL_NAME "red"
			*MATERIAL_DIFFUSE 1.0 0.0 0.0
		}
		*SUBMATERIAL 1 {
			*MATERIAL_NAME "blue"
			*MATERIAL_DIFFUSE 0.0 0.0 1.0
			*MAP_DIFFUSE {
				*BITMAP "blue.png"
			}
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "Plate"
	*NODE_TM {
		*NODE_NAME "Plate"
		*TM_ROW0 1.0000	0.0000	0.0000
		*TM_ROW1 0.0000	1.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 10.0000	0.0000	0.0000
		*TM_POS 10.0000	0.0000	0.0000
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 3
		*MESH_VERTEX_LIST {
			*MESH_VERTEX    0	10.0000	0.0000	0.0000
			*MESH_VERTEX    1	11.0000	0.0000	0.0000
			*MESH_VERTEX    2	11.0000	1.0000	0.0000
			*MESH_VERTEX    3	10.0000	1.0000	0.0000
		}
		*MESH_FACE_LIST {
			*MESH_FACE    0:    A:    0 B:    1 C:    2 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
			*MESH_FACE    1:    A:    0 B:    2 C:    3 AB:    0 BC:    1 CA:    1	 *MESH_SMOOTHING 1,2 	*MESH_MTLID 1
			*MESH_FACE    2:    A:    0 B:    1 C:    9 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 0 	*MESH_MTLID 0
		}
		*MESH_NUMTVERTEX 4
		*MESH_TVERTLIST {
			*MESH_TVERT 0	0.0000	0.0000	0.0000
			*MESH_TVERT 1	1.0000	0.0000	0.0000
			*MESH_TVERT 2	1.0000	1.0000	0.0000
			*MESH_TVERT 3	0.0000	1.0000	0.0000
		}
		*MESH_NUMTVFACES 3
		*MESH_TFACELIST {
			*MESH_TFACE 0	0	1	2
			*MESH_TFACE 1	0	2	3
			*MESH_TFACE 2	0	1	2
		}
		*MESH_NUMCVERTEX 1
		*MESH_CVERTLIST {
			*MESH_VERTCOL 0	1.0000	1.0000	1.0000
		}
	}
	*PROP_MOTIONBLUR 0
	*MATERIAL_REF 1
	*TM_ANIMATION {
		*NODE_NAME "Plate"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0	10.0000	0.0000	0.0000
			*CONTROL_POS_SAMPLE 4800	10.0000	5.0000	0.0000
		}
		*CONTROL_ROT_TRACK {
			*CONTROL_ROT_SAMPLE 0	0.0000	0.0000	1.0000	0.0000
			*CONTROL_ROT_SAMPLE 4800	0.0000	0.0000	1.0000	1.5707963
		}
	}
}
*GEOMOBJECT {
	*NODE_NAME "Child"
	*NODE_PARENT "Plate"
	*NODE_TM {
		*NODE_NAME "Child"
		*TM_ROW0 0.0000	1.0000	0.0000
		*TM_ROW1 -1.0000	0.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 10.0000	2.0000	0.0000
	}
	*MESH {
		*MESH_NUMVERTEX 3
		*MESH_NUMFACES 1
		*MESH_VERTEX_LIST {
			*MESH_VERTEX    0	10.0000	2.0000	0.0000
			*MESH_VERTEX    1	10.0000	3.0000	0.0000
			*MESH_VERTEX    2	9.0000	2.0000	0.0000
		}
		*MESH_FACE_LIST {
			*MESH_FACE    0:    A:    0 B:    1 C:    2 AB:    1 BC:    1 CA:    1	 *MESH_SMOOTHING 	*MESH_MTLID 0
		}
		*MESH_NORMALS {
			*MESH_FACENORMAL 0	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 0	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 1	0.0000	0.0000	1.0000
				*MESH_VERTEXNORMAL 2	0.0000	0.0000	1.0000
		}
	}
	*MATERIAL_REF 0
}
*HELPEROBJECT {
	*NODE_NAME "Dummy"
	*NODE_TM {
		*NODE_NAME "Dummy"
		*TM_ROW0 1.0000	0.0000	0.0000
		*TM_ROW1 0.0000	1.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 0.0000	0.0000	5.0000
	}
}
*CAMERAOBJECT {
	*NODE_NAME "Cam"
	*CAMERA_TYPE Target
	*NODE_TM {
		*NODE_NAME "Cam"
		*TM_ROW0 1.0000	0.0000	0.0000
		*TM_ROW1 0.0000	1.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 0.0000	-20.0000	3.0000
	}
	*NODE_TM {
		*NODE_NAME "Cam.Target"
		*TM_ROW3 0.0000	0.0000	3.0000
	}
	*CAMERA_SETTINGS {
		*TIMEVALUE 0
		*CAMERA_NEAR 0.0000
		*CAMERA_FAR 1000.0000
		*CAMERA_FOV 0.8000
	}
	*TM_ANIMATION {
		*NODE_NAME "Cam"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0	0.0000	-20.0000	3.0000
			*CONTROL_POS_SAMPLE 4800	0.0000	-25.0000	3.0000
		}
	}
	*TM_ANIMATION {
		*NODE_NAME "Cam.Target"
		*CONTROL_POS_TRACK {
			*CONTROL_POS_SAMPLE 0	0.0000	0.0000	3.0000
			*CONTROL_POS_SAMPLE 4800	0.0000	9.0000	3.0000
		}
	}
}
*LIGHTOBJECT {
	*NODE_NAME "Lamp"
	*LIGHT_TYPE Omni
	*NODE_TM {
		*NODE_NAME "Lamp"
		*TM_ROW0 1.0000	0.0000	0.0000
		*TM_ROW1 0.0000	1.0000	0.0000
		*TM_ROW2 0.0000	0.0000	1.0000
		*TM_ROW3 3.0000	3.0000	9.0000
	}
}
