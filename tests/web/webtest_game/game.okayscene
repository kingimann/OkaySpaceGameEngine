  script "okayscript" "// The web player test (tests/scripts/test_web_player.js): prints what reached the game and keeps a count in a save.
var n = 0
function start() {
  n = load(\"presses\", 0)
  print(\"WEBTEST start presses=\" + n + \" prefs=\" + prefs_get(\"pp\", 0))
}
function update(dt) {
  if (key_down(\"space\")) {
    n = n + 1
    save(\"presses\", n)
    print(\"WEBTEST key presses=\" + n)
  }
  if (key_down(\"p\")) {
    prefs_set(\"pp\", prefs_get(\"pp\", 0) + 1)
    print(\"WEBTEST prefs pp=\" + prefs_get(\"pp\", 0))
  }
  if (mouse_down(1)) { print(\"WEBTEST mouse right\") }
  if (gamepad_down(0)) { print(\"WEBTEST pad a\") }
}
" "" 0
