# UI screens as data. One builder (engine/include/okay/Scene/UIScreens.hpp) turns each [screen] into objects under the Canvas.
# Layout language: see the header of UIScreens.hpp. Every screen is checked by tests/test_ui_screens.cpp (builds, no widget off screen
# or outside its card at the sizes it says it fits, saves and loads back, buttons that say act= really carry a script).
# Written from scratch for this engine; no other project's layouts, art or text were used.

[section menus]
name = Menus
tip = Title, pause, settings, credits, level choice and game over screens.
[section hud]
name = In-Game HUD
tip = What the player sees while playing, laid out for a kind of game.
[section items]
name = Inventory & Items
tip = Bags, crafting, shops, character sheets and skill trees.
[section dialogue]
name = Dialogue & Quests
tip = Talking to characters, quest lists and journals.
[section social]
name = Multiplayer & Social
tip = Lobbies, scoreboards, leaderboards, chat and friends.
[section popups]
name = Popups & Notifications
tip = Questions, toasts, tooltips, achievements and errors.
[section forms]
name = Forms & Accounts
tip = Login, sign-up and feedback forms.
[section mobile]
name = Mobile & Touch
tip = Screens made for thumbs: big buttons and touch controls.
[section loading]
name = Loading
tip = Screens that show while a level loads.

# ------------------------------------------------------------------ Menus
[screen main_menu]
name = Main Menu
section = menus
desc = A title screen: Play, Settings, Credits and Quit in a centred card.
tags = title, start, play, quit, home
variants = Centered|Left side|Right side|Dimmed backdrop
replaces = UITemplates::AddMainMenu (fixed card, buttons did nothing)
group Main Menu
  dim Dim v=3 a=0.45
  panel Card card=1 anchor=center size=400,460 lift=1 cr=16
    caption Caption "WELCOME TO" pos=36,34 size=328,18
    text Title "MY GAME" pos=36,54 size=328,48 px=40 bold=1
    divider Line pos=36,118 size=328,1
    button PlayButton "Play" pos=36,146 size=328,52 act="hide:main_menu;show:hud_shooter" icon=play
    button SettingsButton "Settings" pos=36,210 size=328,48 btn=secondary act="show:settings" icon=gear
    button CreditsButton "Credits" pos=36,270 size=328,48 btn=secondary act="swap:main_menu>credits" icon=star
    button QuitButton "Quit" pos=36,330 size=328,48 btn=ghost act=quit icon=door
    text Version "v1.0" anchor=bottomleft pos=36,-14 size=120,18 px=12 color=dim

[screen pause_menu]
name = Pause Menu
section = menus
desc = Resume, Settings, Give up and Quit to menu over a dimmed game. Pauses the game while open.
tags = pause, resume, quit, escape
variants = Centered|Left side|Right side
replaces = UITemplates::AddPauseMenu
group Pause Menu
  dim Dim a=0.55
  panel Card card=1 anchor=center size=360,400 lift=1 cr=16
    caption Caption "GAME" pos=32,28 size=296,18
    text Title "Paused" pos=32,46 size=296,40 px=32 bold=1
    button ResumeButton "Resume" pos=32,110 size=296,50 act="hide:pause_menu;pause:0" icon=play
    button SettingsButton "Settings" pos=32,172 size=296,46 btn=secondary act="show:settings" icon=gear
    button GiveUpButton "Give up" pos=32,230 size=296,46 btn=secondary act="hide:pause_menu;pause:0;hide:hud_shooter;show:game_over" icon=flag
    button MenuButton "Quit to menu" pos=32,288 size=296,46 btn=ghost act="hide:pause_menu;pause:0;hide:hud_shooter;show:main_menu" icon=home

[screen settings]
name = Settings
section = menus
desc = Settings on four tabs: Video, Audio, Controls and Accessibility. The Volume slider works with no script.
tags = options, audio, video, controls, accessibility, volume, graphics
variants = Centered|Left side|Right side
replaces = UITemplates::AddSettings (one crowded page, fixed 960x640)
group Settings
  dim Dim a=0.5
  panel Card card=1 anchor=center size=640,520 lift=1 cr=16 block=1
    text Title "Settings" pos=28,18 size=584,36 px=28 bold=1
    tabs Tabs pos=28,64 size=584,36 tabs="Video|Audio|Controls|Accessibility" pages="Video|Audio|Controls|Access" style=underline
    panel Video page=1 pos=28,112 size=584,330 fill=none cr=0
      text L1 "Display mode" pos=0,8 size=200,24 px=16
      dropdown Mode pos=260,4 size=320,32 options="Windowed|Borderless|Fullscreen" value=0
      text L2 "Resolution" pos=0,56 size=200,24 px=16
      dropdown Res pos=260,52 size=320,32 options="1280 x 720|1920 x 1080|2560 x 1440" value=1
      text L3 "Quality" pos=0,104 size=200,24 px=16
      dropdown Quality pos=260,100 size=320,32 options="Low|Medium|High|Ultra" value=2
      text L4 "VSync" pos=0,152 size=200,24 px=16
      toggle VSync pos=260,152 on=1
      text L5 "Show FPS" pos=0,196 size=200,24 px=16
      toggle Fps pos=260,196 on=0
    panel Audio page=1 off=1 pos=28,112 size=584,330 fill=none cr=0
      text L1 "Master volume" pos=0,8 size=200,24 px=16
      slider Master pos=220,14 size=340,12 value=0.8 act=volume
      text L2 "Music" pos=0,56 size=200,24 px=16
      slider Music pos=220,62 size=340,12 value=0.7
      text L3 "Effects" pos=0,104 size=200,24 px=16
      slider Sfx pos=220,110 size=340,12 value=0.8
      text L4 "Voices" pos=0,152 size=200,24 px=16
      slider Voice pos=220,158 size=340,12 value=0.9
      text L5 "Mute when in background" pos=0,200 size=260,24 px=16
      toggle MuteBg pos=300,200 on=1
    panel Controls page=1 off=1 pos=28,112 size=584,330 fill=none cr=0
      text L1 "Mouse sensitivity" pos=0,8 size=200,24 px=16
      slider Sens pos=220,14 size=340,12 value=0.5
      text L2 "Invert Y axis" pos=0,56 size=200,24 px=16
      toggle Invert pos=260,56 on=0
      text L3 "Vibration" pos=0,100 size=200,24 px=16
      toggle Rumble pos=260,100 on=1
      button Rebind "Change keys..." pos=0,160 size=260,44 btn=secondary act="show:rebinding" icon=keyboard
    panel Access page=1 off=1 pos=28,112 size=584,330 fill=none cr=0
      text L1 "Text size" pos=0,8 size=200,24 px=16
      dropdown TextSize pos=260,4 size=320,32 options="Small|Normal|Large|Extra large" value=1
      text L2 "Colour filter" pos=0,56 size=200,24 px=16
      dropdown Filter pos=260,52 size=320,32 options="Off|Protanopia|Deuteranopia|Tritanopia" value=0
      text L3 "High contrast" pos=0,104 size=200,24 px=16
      toggle Contrast pos=260,104 on=0
      text L4 "Reduce motion" pos=0,148 size=200,24 px=16
      toggle Motion pos=260,148 on=0
      text L5 "Subtitles" pos=0,192 size=200,24 px=16
      toggle Subs pos=260,192 on=1
    button CloseButton "Done" pos=28,456 size=584,44 act="hide:settings" btn=primary

[screen rebinding]
name = Controls Rebinding
section = menus
desc = Eight actions with a keyboard box and a controller box each: click one, press a key or button, and the action really changes. Reset puts every default back.
tags = keybinds, keys, controls, input, remap
variants = Centered|Left side|Right side
group Controls Rebinding
  dim Dim a=0.5
  panel Card card=1 anchor=center size=560,560 lift=1 cr=16 block=1
    text Title "Controls" pos=28,18 size=504,36 px=28 bold=1
    text Hdr1 "KEYBOARD AND MOUSE" pos=40,66 size=250,16 px=12 color=accent up=1
    text Hdr2 "CONTROLLER" pos=326,66 size=180,16 px=12 color=accent up=1
    keybind Jump "Jump" anchor=topleft pos=28,88 size=270,32 action=Jump def=key:space,pad:a
    keybind JumpPad "Jump" anchor=topleft pos=310,88 size=222,32 action=Jump pad=1
    keybind Fire "Fire" pos=28,130 size=270,32 action=Fire def=key:f,pad:rt
    keybind FirePad "Fire" pos=310,130 size=222,32 action=Fire pad=1
    keybind Interact "Use" pos=28,172 size=270,32 action=Interact def=key:e,pad:x
    keybind InteractPad "Use" pos=310,172 size=222,32 action=Interact pad=1
    keybind Reload "Reload" pos=28,214 size=270,32 action=Reload def=key:r,pad:y
    keybind ReloadPad "Reload" pos=310,214 size=222,32 action=Reload pad=1
    keybind Crouch "Crouch" pos=28,256 size=270,32 action=Crouch def=key:c,pad:b
    keybind CrouchPad "Crouch" pos=310,256 size=222,32 action=Crouch pad=1
    keybind Sprint "Sprint" pos=28,298 size=270,32 action=Sprint def=key:shift,pad:ls
    keybind SprintPad "Sprint" pos=310,298 size=222,32 action=Sprint pad=1
    keybind Map "Map" pos=28,340 size=270,32 action=OpenMap def=key:m,pad:back
    keybind MapPad "Map" pos=310,340 size=222,32 action=OpenMap pad=1
    keybind Pause "Pause" pos=28,382 size=270,32 action=PauseGame def=key:p,pad:start
    keybind PausePad "Pause" pos=310,382 size=222,32 action=PauseGame pad=1
    text Tip "Click a box, then press the key or button you want. Backspace puts the default back." pos=28,430 size=504,44 px=14 color=dim wrap=1
    button Reset "Reset all" pos=28,500 size=250,40 btn=secondary act=resetkeys
    button Done "Done" pos=290,500 size=242,40 act="hide:rebinding"

[screen credits]
name = Credits
section = menus
desc = Scrolling-style credit list with sections for the team, thanks and the tools used, and a Back button.
tags = thanks, team, about, end
variants = Centered|Left side|Right side
group Credits
  dim Dim a=0.6
  panel Card card=1 anchor=center size=520,560 lift=1 cr=16 block=1
    text Title "Credits" pos=28,20 size=464,40 px=30 bold=1 align=c
    caption Role1 "GAME DESIGN" pos=28,84 size=464,18
    text N1 "Your Name" pos=28,106 size=464,26 px=20 align=c
    caption Role2 "PROGRAMMING" pos=28,150 size=464,18
    text N2 "Your Name" pos=28,172 size=464,26 px=20 align=c
    caption Role3 "ART AND MUSIC" pos=28,216 size=464,18
    text N3 "Your Name" pos=28,238 size=464,26 px=20 align=c
    caption Role4 "SPECIAL THANKS" pos=28,282 size=464,18
    text N4 "Everyone who played the early versions" pos=28,304 size=464,26 px=16 align=c color=dim
    divider Line pos=28,360 size=464,1
    text Made "Made with OkaySpace Game Engine" pos=28,374 size=464,24 px=14 align=c color=dim
    button Back "Back" pos=28,490 size=464,44 act="swap:credits>main_menu"

[screen level_select]
name = Level Select
section = menus
desc = A grid of level cards with stars and a lock on the ones not reached yet.
tags = levels, stages, map, campaign
variants = Centered|Dimmed backdrop
group Level Select
  dim Dim v=1 a=0.45
  panel Card card=1 anchor=center size=660,480 lift=1 cr=16
    text Title "Choose a level" pos=28,18 size=604,36 px=28 bold=1
    rep n=8 cols=4 dx=152 dy=170
      panel Level pos=28,70 size=140,150 fill=card cr=10 border=1
        panel Thumb pos=10,10 size=120,80 fill=field cr=6
          icon Mark "flag" pos=44,24 size=32,32 color=dim
        text Name "Level {i}" pos=0,96 size=140,22 px=16 align=c bold=1
        icon Star1 "star" pos=34,122 size=20,20 color=warning
        icon Star2 "star" pos=60,122 size=20,20 color=warning
        icon Star3 "star" pos=86,122 size=20,20 color=dim
    button Back "Back" pos=28,420 size=180,40 btn=secondary act="swap:level_select>main_menu"

[screen game_over]
name = Game Over
section = menus
desc = The end screen: a big title, the final score and Retry, Menu and Quit buttons.
tags = death, lose, retry, end, score
variants = Centered|Dimmed backdrop
replaces = UITemplates::AddGameOver
group Game Over
  dim Dim a=0.65
  panel Card card=1 anchor=center size=420,420 lift=1 cr=16
    text Title "GAME OVER" pos=24,28 size=372,56 px=44 bold=1 align=c color=danger
    divider Line pos=40,100 size=340,1
    caption Score "FINAL SCORE" pos=40,120 size=340,18
    text Value "12,450" pos=40,142 size=340,44 px=36 bold=1 align=c
    text Best "Best 18,200" pos=40,192 size=340,22 px=15 align=c color=dim
    button RetryButton "Try again" pos=40,236 size=340,50 act="hide:game_over;show:hud_shooter" icon=redo
    button MenuButton "Main menu" pos=40,298 size=340,46 btn=secondary act="hide:game_over;show:main_menu" icon=home
    button QuitButton "Quit" pos=40,356 size=340,44 btn=ghost act=quit

# ------------------------------------------------------------------ In-Game HUD
[screen hud_shooter]
name = HUD Shooter
section = hud
desc = Health and armour bars, ammo counter, crosshair, a round timer and a pause button.
tags = fps, shooter, ammo, health, crosshair
portrait = 0
replaces = UITemplates::AddHUD (kept as "HUD (health + score)")
group HUD Shooter
  panel Health anchor=bottomleft pos=24,-24 size=280,64 fill=backdrop cr=10
    icon Heart "heart" pos=12,10 size=22,22 color=danger
    bar HealthBar pos=44,14 size=216,14 value=0.8 fill=danger
    icon Shield "shield" pos=12,36 size=22,22 color=accent
    bar ArmorBar pos=44,40 size=216,10 value=0.4 fill=accent
  panel Ammo anchor=bottomright pos=-24,-24 size=216,64 fill=backdrop cr=10
    icon AmmoIcon "bullet" pos=12,16 size=32,32 color=accent
    text Mag "24" pos=52,6 size=62,52 px=40 bold=1
    text Reserve "/ 120" pos=114,24 size=90,30 px=22 color=dim
  icon Cross "crosshair" anchor=center pos=0,0 size=28,28 color=text
  text Timer "02:45" anchor=topcenter pos=0,16 size=160,34 px=28 bold=1 align=c
  button Pause "Pause" anchor=topright pos=-20,16 size=124,38 btn=secondary act="show:pause_menu;pause:1" icon=pause

[screen hud_rpg]
name = HUD RPG
section = hud
desc = Portrait with health, mana and experience bars, a skill hotbar and a quest hint.
tags = rpg, mana, xp, hotbar, quest, skills
portrait = 0
group HUD RPG
  panel Portrait anchor=topleft pos=20,20 size=300,92 fill=backdrop cr=12
    avatar Face "Hero" pos=12,12 d=68
    text Name "Hero  Lv 12" pos=92,8 size=190,22 px=16 bold=1
    bar Hp pos=92,34 size=190,14 value=0.75 fill=danger
    bar Mp pos=92,54 size=190,12 value=0.5 fill=accent
    bar Xp pos=92,72 size=190,8 value=0.3 fill=warning
