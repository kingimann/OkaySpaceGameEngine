// <vector> for okay-cc (ISO/IEC 14882 [vector]). Our own header, minimal. The elements live in raw
// memory from malloc and are built and destroyed one by one (placement new, p->~T()), so T needs no
// default constructor; growing moves the elements into the new block. Iterators are pointers.
#pragma once
#include <cstddef>
#include <cstdlib>
#include <initializer_list>
#include <new>
#include <utility>
namespace std {
template <typename T>
class vector {
public:
    // the member types ([vector.overview]); the iterators are pointers
    typedef T value_type;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef unsigned long size_type;
    typedef T &reference;
    typedef const T &const_reference;
    vector() : data_(nullptr), size_(0), cap_(0) {}
    explicit vector(unsigned long n) : data_(nullptr), size_(0), cap_(0) { resize(n); }
    vector(const T *first, const T *last) : data_(nullptr), size_(0), cap_(0) {
        reserve((unsigned long)(last - first));
        for (const T *p = first; p != last; ++p) {
            new (data_ + size_) T(*p);
            ++size_;
        }
    }
    vector(unsigned long n, const T &v) : data_(nullptr), size_(0), cap_(0) {
        reserve(n);
        for (unsigned long i = 0; i < n; ++i) new (data_ + i) T(v);
        size_ = n;
    }
    vector(initializer_list<T> il) : data_(nullptr), size_(0), cap_(0) {
        reserve(il.size());
        for (const T *p = il.begin(); p != il.end(); ++p) {
            new (data_ + size_) T(*p);
            ++size_;
        }
    }
    vector(const vector<T> &o) : data_(nullptr), size_(0), cap_(0) {
        reserve(o.size_);
        for (unsigned long i = 0; i < o.size_; ++i) new (data_ + i) T(o.data_[i]);
        size_ = o.size_;
    }
    vector(vector<T> &&o) : data_(o.data_), size_(o.size_), cap_(o.cap_) {
        o.data_ = nullptr;
        o.size_ = 0;
        o.cap_ = 0;
    }
    ~vector() {
        clear();
        free(data_);
    }
    vector<T> &operator=(const vector<T> &o) {
        if (this == &o) return *this;
        clear();
        reserve(o.size_);
        for (unsigned long i = 0; i < o.size_; ++i) new (data_ + i) T(o.data_[i]);
        size_ = o.size_;
        return *this;
    }
    vector<T> &operator=(vector<T> &&o) {
        if (this == &o) return *this;
        clear();
        free(data_);
        data_ = o.data_;
        size_ = o.size_;
        cap_ = o.cap_;
        o.data_ = nullptr;
        o.size_ = 0;
        o.cap_ = 0;
        return *this;
    }

    void swap(vector<T> &o) {
        T *d = data_;
        unsigned long s = size_;
        unsigned long c = cap_;
        data_ = o.data_;
        size_ = o.size_;
        cap_ = o.cap_;
        o.data_ = d;
        o.size_ = s;
        o.cap_ = c;
    }
    // ==, != and < ([container.reqmts], [container.opt.reqmts]: element by element, < in
    // lexicographical order); members here, so a vector of a class with its own == compares too.
    bool operator==(const vector &o) const {
        if (size_ != o.size_) return false;
        for (unsigned long i = 0; i < size_; ++i)
            if (!(data_[i] == o.data_[i])) return false;
        return true;
    }
    bool operator!=(const vector &o) const { return !(*this == o); }
    bool operator<(const vector &o) const {
        for (unsigned long i = 0; i < size_ && i < o.size_; ++i) {
            if (data_[i] < o.data_[i]) return true;
            if (o.data_[i] < data_[i]) return false;
        }
        return size_ < o.size_;
    }
    unsigned long size() const { return size_; }
    unsigned long capacity() const { return cap_; }
    bool empty() const { return size_ == 0; }
    T *data() { return data_; }
    T *begin() { return data_; }
    T *end() { return data_ + size_; }
    T &operator[](unsigned long i) { return data_[i]; }
    T &at(unsigned long i) { return data_[i]; }
    T &front() { return data_[0]; }
    T &back() { return data_[size_ - 1]; }

    void reserve(unsigned long n) {
        if (n <= cap_) return;
        T *grown = (T *)malloc(n * sizeof(T));
        for (unsigned long i = 0; i < size_; ++i) {
            new (grown + i) T(std::move(data_[i]));
            (data_ + i)->~T();
        }
        free(data_);
        data_ = grown;
        cap_ = n;
    }
    void push_back(const T &v) {
        if (size_ == cap_) {
            T keep = v;  // v may be an element of this vector
            reserve(cap_ == 0 ? 4 : cap_ * 2);
            new (data_ + size_) T(std::move(keep));
        } else {
            new (data_ + size_) T(v);
        }
        ++size_;
    }
    void push_back(T &&v) {
        if (size_ == cap_) {
            T keep = std::move(v);
            reserve(cap_ == 0 ? 4 : cap_ * 2);
            new (data_ + size_) T(std::move(keep));
        } else {
            new (data_ + size_) T(std::move(v));
        }
        ++size_;
    }
    // emplace_back(args...) ([sequence.reqmts] p71): the element is built from the arguments in
    // place; when the block must grow, it is built first in a spare cell, as an argument may refer
    // to an element of this vector.
    template <typename... A>
    T &emplace_back(A &&...a) {
        if (size_ == cap_) {
            T *spare = (T *)malloc(sizeof(T));
            new (spare) T(std::forward<A>(a)...);
            reserve(cap_ == 0 ? 4 : cap_ * 2);
            new (data_ + size_) T(std::move(*spare));
            spare->~T();
            free(spare);
        } else {
            new (data_ + size_) T(std::forward<A>(a)...);
        }
        ++size_;
        return data_[size_ - 1];
    }
    void pop_back() {
        --size_;
        (data_ + size_)->~T();
    }
    void clear() {
        for (unsigned long i = 0; i < size_; ++i) (data_ + i)->~T();
        size_ = 0;
    }
    void assign(unsigned long n, const T &v) {
        T copy = v;  // v may be one of the elements
        clear();
        reserve(n);
        for (unsigned long i = 0; i < n; ++i) new (data_ + i) T(copy);
        size_ = n;
    }
    // assign(first, last) and assign(list) ([sequence.reqmts]); two integers are a count and a value.
    template <class It>
    void assign(It first, It last) {
        if constexpr (__okay_is_integral(It)) {
            assign((unsigned long)first, (T)last);
        } else {
            vector<T> tmp;  // the range may be in this vector: copy it first
            for (; first != last; ++first) tmp.push_back(*first);
            swap(tmp);
        }
    }
    void assign(initializer_list<T> il) { assign(il.begin(), il.end()); }
    void resize(unsigned long n) {
        while (size_ > n) pop_back();
        reserve(n);
        for (unsigned long i = size_; i < n; ++i) new (data_ + i) T();
        size_ = n;
    }
    void resize(unsigned long n, const T &v) {  // new elements are copies of v ([vector.capacity])
        T copy = v;  // v may be one of the elements
        while (size_ > n) pop_back();
        reserve(n);
        for (unsigned long i = size_; i < n; ++i) new (data_ + i) T(copy);
        size_ = n;
    }
    T *erase(T *pos) {
        T *last = data_ + size_;
        for (T *p = pos; p + 1 != last; ++p) *p = std::move(*(p + 1));
        pop_back();
        return pos;
    }
    // Remove [first, last): the elements after it move down, the last ones are destroyed.
    T *erase(T *first, T *last) {
        if (first == last) return first;
        T *end = data_ + size_;
        T *to = first;
        for (T *p = last; p != end; ++p, ++to) *to = std::move(*p);
        unsigned long gone = (unsigned long)(last - first);
        for (unsigned long i = 0; i < gone; ++i) pop_back();
        return first;
    }
    T *insert(T *pos, const T &v) {
        T keep = v;  // v may be an element of this vector: copy it before anything moves or is freed
        unsigned long at = (unsigned long)(pos - data_);
        push_back(keep);
        for (unsigned long i = size_ - 1; i > at; --i) data_[i] = std::move(data_[i - 1]);
        data_[at] = std::move(keep);
        return data_ + at;
    }
    // insert(pos, n, v) and insert(pos, first, last) ([vector.modifiers]): the new elements go at
    // the end, then turn into place. Two integers are a count and a value ([sequence.reqmts] p14).
    T *insert(T *pos, unsigned long n, const T &v) {
        T keep = v;
        unsigned long at = (unsigned long)(pos - data_);
        for (unsigned long i = 0; i < n; ++i) push_back(keep);
        turnEnd(at, n);
        return data_ + at;
    }
    template <class It>
    T *insert(T *pos, It first, It last) {
        unsigned long at = (unsigned long)(pos - data_);
        if constexpr (__okay_is_integral(It)) {
            return insert(pos, (unsigned long)first, (T)last);
        } else {
            unsigned long n = 0;
            vector<T> tmp;  // the range may be in this vector: copy it first
            for (; first != last; ++first) tmp.push_back(*first);
            for (unsigned long i = 0; i < tmp.size_; ++i) push_back(std::move(tmp.data_[i]));
            n = tmp.size_;
            turnEnd(at, n);
            return data_ + at;
        }
    }
    T *insert(T *pos, initializer_list<T> il) { return insert(pos, il.begin(), il.end()); }

private:
    // The last n elements move to place at, the ones from at on move up behind them: three
    // reversals (a rotation).
    void turnEnd(unsigned long at, unsigned long n) {
        if (n == 0 || at + n >= size_ + 0 && at + n == size_) return;
        flip(at, size_ - n);
        flip(size_ - n, size_);
        flip(at, size_);
    }
    void flip(unsigned long a, unsigned long b) {
        while (b > a + 1) {
            --b;
            T t = std::move(data_[a]);
            data_[a] = std::move(data_[b]);
            data_[b] = std::move(t);
            ++a;
        }
    }
    T *data_;
    unsigned long size_;
    unsigned long cap_;
};
}  // namespace std
