// getline ([string.io] p7): characters up to delim (which is taken and not stored); failbit when
// nothing at all was taken.
inline istream &getline(istream &is, string &s, char delim) {
    s.clear();
    if (is.fail()) return is;
    long taken = 0;
    for (;;) {
        int c = is.__sb ? is.__sb->__get() : -1;
        if (c < 0) {
            is.setstate(ios_base::eofbit);
            break;
        }
        ++taken;
        if (c == delim) break;
        s.push_back((char)c);
    }
    if (taken == 0) is.setstate(ios_base::failbit);
    return is;
}
inline istream &getline(istream &is, string &s) { return getline(is, s, '\n'); }

// The string channel of the string streams: one string, a read position and a write position.
class __stringbuf : public streambuf {
public:
    string __s;
    long __r;
    long __w;
    __stringbuf() : __r(0), __w(0) {}
    long __write(const char *p, long n) {
        for (long k = 0; k < n; ++k) {
            if (__w < (long)__s.size()) __s[(unsigned long)__w] = p[k];
            else __s.push_back(p[k]);
            ++__w;
        }
        return n;
    }
    int __get() {
        if (__r >= (long)__s.size()) return -1;
        return (unsigned char)__s[(unsigned long)__r++];
    }
    int __peek() {
        if (__r >= (long)__s.size()) return -1;
        return (unsigned char)__s[(unsigned long)__r];
    }
    bool __unget() {
        if (__r == 0) return false;
        --__r;
        return true;
    }
    long __seek(long off, int dir, bool forRead) {
        long base = dir == 0 ? 0 : dir == 1 ? (forRead ? __r : __w) : (long)__s.size();
        long p = base + off;
        if (p < 0 || p > (long)__s.size()) return -1;
        if (forRead) __r = p;
        else __w = p;
        return p;
    }
    long __tell(bool forRead) { return forRead ? __r : __w; }
};

// String streams ([string.streams]). The stream owns its channel; str() copies the text out.
class ostringstream : public ostream {
public:
    ostringstream() { __sb = &__buf; }
    explicit ostringstream(openmode m) {
        __sb = &__buf;
        (void)m;
    }
    explicit ostringstream(const string &s, openmode m = out) {
        __sb = &__buf;
        __buf.__s = s;
        if (m & (ate | app)) __buf.__w = (long)s.size();
    }
    string str() const { return __buf.__s; }
    void str(const string &s) {
        __buf.__s = s;
        __buf.__r = 0;
        __buf.__w = 0;
    }
    __stringbuf *rdbuf() { return &__buf; }

private:
    __stringbuf __buf;
};
class istringstream : public istream {
public:
    istringstream() { __sb = &__buf; }
