# The UI components, for the gallery and the catalogue. scripts/gen_ui_catalogue.py checks each class exists under engine/include/okay/Components.
# menu = the id of its entry in GameObject > UI (editor/UIMenuModel.hpp); empty = added with Add Component or by another part.

[component UIPanel]
category = Basics
tags = box,card,background,container
desc = A coloured box with shape, border, gradient and shadow.
menu = ui.panel

