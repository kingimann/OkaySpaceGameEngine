# Module manifest. Format: docs/engine/modular_engine.md. One key per line, lists are comma separated.
name=render3d_effects
title=3D render effects
area=Rendering
description=Decals, LOD groups, occluders, volumes, water, lines, cables, mesh modifiers, optimisation helpers.
default=on
core=0
requires=core
provides=
components=Cable,Decal,LODGroup,LineRenderer,MeshModifiers,Occluder,TrailRenderer,Volume,Water
