// <ctime> for okay-cc (ISO/IEC 14882 [ctime.syn], ISO C 7.27). Our own header for lib/time.c. Local
// time is UTC (no time zone database).
#pragma once
#define CLOCKS_PER_SEC 1000000L
extern "C" {
typedef long time_t;
typedef long clock_t;
struct tm {
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
    long tm_gmtoff;
    const char *tm_zone;
};
struct timespec {
    long tv_sec;
    long tv_nsec;
};
time_t time(time_t *out);
clock_t clock(void);
double difftime(time_t a, time_t b);
struct tm *gmtime(const time_t *t);
struct tm *localtime(const time_t *t);
struct tm *gmtime_r(const time_t *t, struct tm *out);
struct tm *localtime_r(const time_t *t, struct tm *out);
time_t mktime(struct tm *t);
time_t timegm(struct tm *t);
unsigned long strftime(char *s, unsigned long max, const char *fmt, const struct tm *t);
long __okay_clock_ns(int clk);
}
namespace std {
typedef long time_t;
typedef long clock_t;
typedef ::tm tm;
typedef ::timespec timespec;
extern "C" {
time_t time(time_t *out);
clock_t clock(void);
double difftime(time_t a, time_t b);
tm *gmtime(const time_t *t);
tm *localtime(const time_t *t);
time_t mktime(tm *t);
unsigned long strftime(char *s, unsigned long max, const char *fmt, const tm *t);
}
}  // namespace std
