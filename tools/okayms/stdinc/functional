// okay-ms own standard header: the small part of <functional> that is class templates, written from ISO/IEC 14882
// [function.objects]: hash for the integer types, and the comparison and arithmetic function objects.
// std::function ([func.wrap.func]): a copyable holder of any callable with the call signature R(A...). Own version:
// the callable is kept in a heap object behind a virtual call; okay-ms maps function<R(A...)> to function__fn<R, A...>
// (see instantiate_class). target<T>() and target_type() ([func.wrap.func.targ]) compare typeid of the kept callable
// with T (Round 34; only the const form of target, which returns const T*). No allocator; calling an empty function returns R() for a
// value type instead of throwing bad_function_call (there are no exceptions). okay-ms reads nullptr as the number 0, so
// construction, assignment and comparison with nullptr take an int: any int would be taken as "empty" (not standard).
#pragma once
#include <cstddef>
#include <cstdlib>
#include <new>
#include <typeinfo>
#include <utility>
namespace std {
template <typename F> class function {};
// The holder and the object that keeps one callable (member class templates are not read by okay-ms, so they are at
// namespace scope).
template <typename R, typename... A>
struct function_holder__ {
    virtual ~function_holder__() {}
    virtual R call(A... args) = 0;
    virtual function_holder__* clone() const = 0;
    virtual const type_info& type__() const = 0;
    virtual const void* get__() const = 0;
};
template <typename F, typename R, typename... A>
struct function_impl__ : public function_holder__<R, A...> {
    F fn;
    function_impl__(const F& f) : fn(f) {}
    R call(A... args) { return fn(args...); }
    function_holder__<R, A...>* clone() const { return new function_impl__<F, R, A...>(fn); }
    const type_info& type__() const { return typeid(F); }
    const void* get__() const { return &fn; }
};
template <typename R, typename... A>
class function__fn {
    typedef function_holder__<R, A...> Holder;
    Holder* held_;

public:
    function__fn() : held_(nullptr) {}
    function__fn(int null_pointer) : held_(nullptr) { (void)null_pointer; }  // function<...> f = nullptr;
    template <typename F>
    function__fn(F f) : held_(new function_impl__<F, R, A...>(f)) {}
    function__fn(const function__fn& o) : held_(o.held_ ? o.held_->clone() : nullptr) {}
    function__fn(function__fn&& o) : held_(o.held_) { o.held_ = nullptr; }
    ~function__fn() { delete held_; }
    function__fn& operator=(const function__fn& o) {
        if (this != &o) {
            Holder* copy = o.held_ ? o.held_->clone() : nullptr;
            delete held_;
            held_ = copy;
        }
        return *this;
    }
    function__fn& operator=(function__fn&& o) {
        if (this != &o) {
            delete held_;
            held_ = o.held_;
            o.held_ = nullptr;
        }
        return *this;
    }
    function__fn& operator=(int null_pointer) {
        (void)null_pointer;
        delete held_;
        held_ = nullptr;
        return *this;
    }
    bool operator==(int null_pointer) const { return (void)null_pointer, held_ == nullptr; }
    bool operator!=(int null_pointer) const { return (void)null_pointer, held_ != nullptr; }
    explicit operator bool() const { return held_ != nullptr; }
    R operator()(A... args) const { return held_->call(args...); }
    const type_info& target_type() const { return held_ ? held_->type__() : typeid(void); }
    template <typename T> const T* target() const {
        return held_ && held_->type__() == typeid(T) ? (const T*)held_->get__() : nullptr;
    }
    void swap(function__fn& o) {
        Holder* t = held_;
        held_ = o.held_;
        o.held_ = t;
    }
};

template <typename T> struct hash;
template <> struct hash<bool> { size_t operator()(bool v) const { return (size_t)v; } };
template <> struct hash<char> { size_t operator()(char v) const { return (size_t)v; } };
template <> struct hash<short> { size_t operator()(short v) const { return (size_t)v; } };
template <> struct hash<int> { size_t operator()(int v) const { return (size_t)v; } };
template <> struct hash<unsigned> { size_t operator()(unsigned v) const { return (size_t)v; } };
template <> struct hash<long long> { size_t operator()(long long v) const { return (size_t)v; } };
template <> struct hash<unsigned long long> { size_t operator()(unsigned long long v) const { return (size_t)v; } };
// Pointers ([unord.hash] 2: hash<T*> for every T; Round 33, JsRuntime.cpp's std::hash<const void*>): the address.
template <typename T> struct hash<T*> { size_t operator()(T* p) const { return (size_t)p; } };

// less and greater are in <utility> (the ordered containers use them without the rest of this header).
template <typename T> struct less_equal { bool operator()(const T& a, const T& b) const { return a <= b; } };
template <typename T> struct greater_equal { bool operator()(const T& a, const T& b) const { return a >= b; } };
template <typename T> struct equal_to { bool operator()(const T& a, const T& b) const { return a == b; } };
template <typename T> struct not_equal_to { bool operator()(const T& a, const T& b) const { return a != b; } };
template <typename T> struct plus { T operator()(const T& a, const T& b) const { return a + b; } };
template <typename T> struct minus { T operator()(const T& a, const T& b) const { return a - b; } };
template <typename T> struct multiplies { T operator()(const T& a, const T& b) const { return a * b; } };
template <typename T> struct divides { T operator()(const T& a, const T& b) const { return a / b; } };
template <typename T> struct negate { T operator()(const T& a) const { return -a; } };
template <typename T> struct logical_not { bool operator()(const T& a) const { return !a; } };
}
