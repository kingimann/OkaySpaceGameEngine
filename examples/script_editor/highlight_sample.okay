// Script Editor sample. Open it in the Script Editor to try the code editor:
// colours for keywords, types, strings, numbers and comments, matching brackets,
// hover help on built-in names, and a red mark when something is wrong.
# A line that starts with # is a comment in OkayScript too.
/* A block comment
   that runs over two lines. */

[Header("Movement")]
public float speed = 5;        // public: shows in the Inspector
public int maxHops = 3;
int hops = 0;

enum State { Idle, Run }

void Start()
{
    Debug.Log($"{gameObject.name} is ready, speed {speed}");
}

void Update()
{
    float h = Input.GetAxis("Horizontal");
    transform.position += new Vector3(h, 0, 0) * speed * Time.deltaTime;

    if (Input.GetKeyDown(KeyCode.Space) && hops < maxHops)
    {
        hops++;
        StartCoroutine(Hop());
    }
}

IEnumerator Hop()
{
    transform.position += Vector3.up * 1.5;
    yield return new WaitForSeconds(0.25);
    transform.position -= Vector3.up * 1.5;
}
