// <utility> for okay-cc (ISO/IEC 14882 [utility], [pairs]). Our own header. move takes an lvalue (a
// temporary cannot be moved from here) and returns T&&, so a class with a move constructor or a
// move assignment is moved; forward<T>(x) gives x back as T&&. pair compares with member operators
// (okay-cc has no non-member operator templates yet).
#pragma once
namespace std {
template <typename T>
T &&move(T &x) { return x; }
template <typename T>
T &&forward(T &x) { return x; }
template <typename T>
void swap(T &a, T &b) {
    T t = std::move(a);
    a = std::move(b);
    b = std::move(t);
}
template <typename A, typename B>
struct pair {
    A first;
    B second;
    pair() : first(), second() {}
    pair(const A &a, const B &b) : first(a), second(b) {}
    template <typename U, typename W>
    pair(U &&a, W &&b) : first(std::forward<U>(a)), second(std::forward<W>(b)) {}
    template <typename U, typename W>
    pair(const pair<U, W> &o) : first(o.first), second(o.second) {}
    bool operator==(const pair<A, B> &o) const { return first == o.first && second == o.second; }
    bool operator!=(const pair<A, B> &o) const { return !(*this == o); }
    bool operator<(const pair<A, B> &o) const { return first < o.first || (!(o.first < first) && second < o.second); }
};
template <typename A, typename B>
pair<A, B> make_pair(A a, B b) {
    return pair<A, B>(a, b);
}
}  // namespace std
