// okay-ms own standard header (ISO/IEC 14882 [ctime.syn], ISO/IEC 9899 7.27): the types and the declarations of the C
// time functions. Declarations only: okay-ms's runtime (tools/okayms/runtime) does not define them yet, so a program
// that calls one links only against a library that does. time_t is 64 bits, as on Windows x64. The functions are
// extern "C" so they link by their plain names. std::time_t and std::tm name the global types (a std:: in front of a type is dropped by okay-ms).
#pragma once
#include <cstddef>
typedef long long time_t;
typedef long clock_t;
#define CLOCKS_PER_SEC 1000
struct tm {
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
};
namespace std {
extern "C" {
time_t time(time_t *t);
clock_t clock(void);
double difftime(time_t end, time_t start);
time_t mktime(struct tm *t);
struct tm *gmtime(const time_t *t);
struct tm *localtime(const time_t *t);
size_t strftime(char *out, size_t n, const char *format, const struct tm *t);
}
}
// The Microsoft C runtime's thread-safe forms (Microsoft's documentation of localtime_s and gmtime_s): they fill the
// caller's tm and return 0, or an error number. In the runtime DLL they are the 64-bit-time functions _localtime64_s and
// _gmtime64_s, which these call.
extern "C" {
int _localtime64_s(struct tm *out, const time_t *t);
int _gmtime64_s(struct tm *out, const time_t *t);
}
// Macros, not inline functions: okay-ms emits every inline function of a file, and the program would then always import
// the two runtime functions.
#define localtime_s(out, t) _localtime64_s((out), (t))
#define gmtime_s(out, t) _gmtime64_s((out), (t))
// The POSIX thread-safe forms localtime_r and gmtime_r (POSIX.1-2017, <time.h>): they fill the caller's tm and return
// it, or null. The Microsoft C runtime has no such functions; here they are the forms above. Function templates (made
// only where they are called, so a file that only includes <ctime> imports nothing), named through macros so that
// ::localtime_r(&t, &out) reads as well.
template <typename T> struct tm *__okay_localtime_r(const T *t, struct tm *out) {
    return _localtime64_s(out, t) == 0 ? out : (struct tm *)0;
}
template <typename T> struct tm *__okay_gmtime_r(const T *t, struct tm *out) {
    return _gmtime64_s(out, t) == 0 ? out : (struct tm *)0;
}
#define localtime_r __okay_localtime_r
#define gmtime_r __okay_gmtime_r
