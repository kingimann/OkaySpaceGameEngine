// okay-ms own standard header: std::from_chars and std::to_chars, written from ISO/IEC 14882 [charconv]. They read and
// write numbers in [first, last) with no locale, no leading whitespace and no '+' sign; a result has the position after
// the last character used and an errc (errc() when it worked, invalid_argument when no number starts there,
// result_out_of_range when it does not fit, value_too_large when the output does not fit).
// Own version: the integer forms are exact in bases 2 to 36. The floating forms read the decimal form (and "inf", "nan")
// with our own digit loop (decimal_value), which is not correctly rounded: the last bit can differ from the nearest
// double. Hexadecimal floats and chars_format are not read. to_chars of a floating value is not here.
#pragma once
#include <cstddef>
#include <system_error>
namespace std {
struct from_chars_result {
    const char* ptr;
    errc ec;
};
struct to_chars_result {
    char* ptr;
    errc ec;
};
enum class chars_format { scientific = 1, fixed = 2, hex = 4, general = 3 };

namespace okay_charconv {
inline int digit_of(char c, int base) {
    int d = 99;
    if (c >= '0' && c <= '9') d = c - '0';
    else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;
    else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;
    return d < base ? d : -1;
}
// The magnitude of an integer at first: its digits, whether it overflowed `limit`, and where they end.
inline from_chars_result read_magnitude(const char* first, const char* last, int base, unsigned long long limit,
                                        unsigned long long* out) {
    unsigned long long v = 0;
    bool over = false;
    const char* p = first;
    while (p < last) {
        const int d = digit_of(*p, base);
        if (d < 0) break;
        if (v > (limit - (unsigned long long)d) / (unsigned long long)base) over = true;
        else v = v * (unsigned long long)base + (unsigned long long)d;
        ++p;
    }
    from_chars_result r;
    r.ptr = p;
    r.ec = errc();
    if (p == first) {
        r.ptr = first;
        r.ec = errc::invalid_argument;
    } else if (over) {
        r.ec = errc::result_out_of_range;
    }
    *out = v;
    return r;
}
inline from_chars_result read_signed(const char* first, const char* last, int base, long long lo, long long hi,
                                     long long* out) {
    const bool neg = first < last && *first == '-';
    const char* digits = neg ? first + 1 : first;
    const unsigned long long limit = neg ? (unsigned long long)(-(lo + 1)) + 1ull : (unsigned long long)hi;
    unsigned long long mag = 0;
    from_chars_result r = read_magnitude(digits, last, base, limit, &mag);
    if (r.ec == errc::invalid_argument) {
        r.ptr = first;
        return r;
    }
    if (r.ec == errc()) *out = neg ? (long long)(0ull - mag) : (long long)mag;
    return r;
}
inline from_chars_result read_unsigned(const char* first, const char* last, int base, unsigned long long hi,
                                       unsigned long long* out) {
    unsigned long long v = 0;
    from_chars_result r = read_magnitude(first, last, base, hi, &v);
    if (r.ec == errc()) *out = v;
    return r;
}
// The value of text that read_double accepted: up to 19 significant digits are kept exactly in an integer, then scaled by
// a power of ten built by repeated multiplication (not correctly rounded: the last bit can differ from the nearest double).
inline double decimal_value(const char* first, const char* last) {
    const char* p = first;
    const bool neg = p < last && *p == '-';
    if (neg) ++p;
    if (last - p >= 3 && (p[0] == 'i' || p[0] == 'I')) return neg ? -1.0 / 0.0 : 1.0 / 0.0;
    if (last - p >= 3 && (p[0] == 'n' || p[0] == 'N')) return 0.0 / 0.0;
    unsigned long long mant = 0;
    int digits = 0;
    int exp10 = 0;
    bool point = false;
    for (; p < last && ((*p >= '0' && *p <= '9') || *p == '.'); ++p) {
        if (*p == '.') {
            point = true;
            continue;
        }
        if (digits < 19) {
            if (mant != 0 || *p != '0') ++digits;
            mant = mant * 10 + (unsigned long long)(*p - '0');
            if (point) --exp10;
        } else if (!point) {
            ++exp10;  // a digit past the 19 kept ones, before the point
        }
    }
    if (p < last && (*p == 'e' || *p == 'E')) {
        ++p;
        bool eneg = false;
        if (p < last && (*p == '-' || *p == '+')) eneg = *p++ == '-';
        int e = 0;
        for (; p < last && *p >= '0' && *p <= '9'; ++p)
            if (e < 10000) e = e * 10 + (*p - '0');
        exp10 += eneg ? -e : e;
    }
    double v = (double)mant;
    double scale = 1.0;
    int k = exp10 < 0 ? -exp10 : exp10;
    double step = 10.0;
    while (k > 0) {  // 10^k by squaring
        if (k & 1) scale *= step;
        step *= step;
        k >>= 1;
    }
    v = exp10 < 0 ? v / scale : v * scale;
    return neg ? -v : v;
}
inline from_chars_result read_double(const char* first, const char* last, double* out) {
    // The longest text that is a number here: sign, digits, point, digits, exponent ([charconv.from.chars] 7).
    const char* p = first;
    if (p < last && *p == '-') ++p;
    const char* body = p;
    bool any = false;
    if (last - p >= 3 && (p[0] == 'i' || p[0] == 'I') && (p[1] == 'n' || p[1] == 'N') && (p[2] == 'f' || p[2] == 'F')) {
        p += 3;
        any = true;
    } else if (last - p >= 3 && (p[0] == 'n' || p[0] == 'N') && (p[1] == 'a' || p[1] == 'A') && (p[2] == 'n' || p[2] == 'N')) {
        p += 3;
        any = true;
    } else {
        while (p < last && *p >= '0' && *p <= '9') {
            ++p;
            any = true;
        }
        if (p < last && *p == '.') {
            ++p;
            while (p < last && *p >= '0' && *p <= '9') {
                ++p;
                any = true;
            }
        }
        if (any && p < last && (*p == 'e' || *p == 'E')) {
            const char* e = p + 1;
            if (e < last && (*e == '-' || *e == '+')) ++e;
            if (e < last && *e >= '0' && *e <= '9') {
                while (e < last && *e >= '0' && *e <= '9') ++e;
                p = e;
            }
        }
    }
    from_chars_result r;
    if (!any || p == body) {
        r.ptr = first;
        r.ec = errc::invalid_argument;
        return r;
    }
    *out = decimal_value(first, p);
    r.ptr = p;
    r.ec = errc();
    return r;
}
inline to_chars_result write_unsigned(char* first, char* last, unsigned long long v, int base, bool neg) {
    char tmp[72];
    int n = 0;
    do {
        const int d = (int)(v % (unsigned long long)base);
        tmp[n++] = (char)(d < 10 ? '0' + d : 'a' + d - 10);
        v /= (unsigned long long)base;
    } while (v != 0);
    to_chars_result r;
    if (last - first < n + (neg ? 1 : 0)) {
        r.ptr = last;
        r.ec = errc::value_too_large;
        return r;
    }
    char* p = first;
    if (neg) *p++ = '-';
    while (n > 0) *p++ = tmp[--n];
    r.ptr = p;
    r.ec = errc();
    return r;
}
}  // namespace okay_charconv

inline from_chars_result from_chars(const char* first, const char* last, int& value, int base = 10) {
    long long v = 0;
    from_chars_result r = okay_charconv::read_signed(first, last, base, -2147483647LL - 1, 2147483647LL, &v);
    if (r.ec == errc()) value = (int)v;
    return r;
}
inline from_chars_result from_chars(const char* first, const char* last, long long& value, int base = 10) {
    long long v = 0;
    from_chars_result r = okay_charconv::read_signed(first, last, base, -9223372036854775807LL - 1, 9223372036854775807LL, &v);
    if (r.ec == errc()) value = v;
    return r;
}
inline from_chars_result from_chars(const char* first, const char* last, unsigned& value, int base = 10) {
    unsigned long long v = 0;
    from_chars_result r = okay_charconv::read_unsigned(first, last, base, 4294967295ULL, &v);
    if (r.ec == errc()) value = (unsigned)v;
    return r;
}
inline from_chars_result from_chars(const char* first, const char* last, unsigned long long& value, int base = 10) {
    unsigned long long v = 0;
    from_chars_result r = okay_charconv::read_unsigned(first, last, base, 18446744073709551615ULL, &v);
    if (r.ec == errc()) value = v;
    return r;
}
inline from_chars_result from_chars(const char* first, const char* last, double& value) {
    double v = 0;
    from_chars_result r = okay_charconv::read_double(first, last, &v);
    if (r.ec == errc()) value = v;
    return r;
}
inline from_chars_result from_chars(const char* first, const char* last, float& value) {
    double v = 0;
    from_chars_result r = okay_charconv::read_double(first, last, &v);
    if (r.ec == errc()) {
        if (v > 3.40282347e+38 || v < -3.40282347e+38) {
            if (v == v && v - v == v - v) r.ec = errc::result_out_of_range;  // finite but too big for a float
            else value = (float)v;
        } else {
            value = (float)v;
        }
    }
    return r;
}
inline to_chars_result to_chars(char* first, char* last, int value, int base = 10) {
    const bool neg = value < 0;
    const unsigned long long mag = neg ? 0ull - (unsigned long long)(long long)value : (unsigned long long)value;
    return okay_charconv::write_unsigned(first, last, mag, base, neg);
}
inline to_chars_result to_chars(char* first, char* last, long long value, int base = 10) {
    const bool neg = value < 0;
    const unsigned long long mag = neg ? 0ull - (unsigned long long)value : (unsigned long long)value;
    return okay_charconv::write_unsigned(first, last, mag, base, neg);
}
inline to_chars_result to_chars(char* first, char* last, unsigned value, int base = 10) {
    return okay_charconv::write_unsigned(first, last, value, base, false);
}
inline to_chars_result to_chars(char* first, char* last, unsigned long long value, int base = 10) {
    return okay_charconv::write_unsigned(first, last, value, base, false);
}
}
