// <string> for okay-cc (ISO/IEC 14882 [basic.string]). Our own header, minimal: a std::string of
// char that owns a zero-terminated buffer. No templates (basic_string) yet; iterators are pointers.
#pragma once
#include <cctype>  // (std::tolower and the others, as g++'s <string> gives them)
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <functional>
#include <__string_view>
#include <__reverse_iterator>
namespace std {
class string {
public:
    typedef char value_type;
    typedef char *iterator;
    typedef const char *const_iterator;
    typedef unsigned long size_type;
    string() : p_(nullptr), n_(0), cap_(0) { release(grow(0)); }
    string(const char *s) : p_(nullptr), n_(0), cap_(0) {
        unsigned long n = s ? strlen(s) : 0;
        release(grow(n));
        for (unsigned long i = 0; i < n; ++i) p_[i] = s[i];
        n_ = n;
        p_[n_] = 0;
    }
    string(const string &o) : p_(nullptr), n_(0), cap_(0) {
        release(grow(o.n_));
        for (unsigned long i = 0; i < o.n_; ++i) p_[i] = o.p_[i];
        n_ = o.n_;
        p_[n_] = 0;
    }
    string(const char *s, unsigned long n) : p_(nullptr), n_(0), cap_(0) { assignChars(s, n); }
    // at most n characters of o from pos ([string.cons] p3)
    string(const string &o, unsigned long pos, unsigned long n = (unsigned long)-1) : p_(nullptr), n_(0), cap_(0) {
        if (pos > o.n_) pos = o.n_;
        assignChars(o.p_ + pos, o.n_ - pos < n ? o.n_ - pos : n);
    }
    // from a string_view ([string.cons] p8, explicit as there)
    explicit string(string_view v) : p_(nullptr), n_(0), cap_(0) { assignChars(v.data(), v.size()); }
    // n characters of v from pos ([string.cons] p6: the template taking a T that converts to a view)
    string(string_view v, unsigned long pos, unsigned long n) : p_(nullptr), n_(0), cap_(0) {
        if (pos > v.size()) pos = v.size();
        assignChars(v.data() + pos, v.size() - pos < n ? v.size() - pos : n);
    }
    string(unsigned long n, char c) : p_(nullptr), n_(0), cap_(0) {
        release(grow(n));
        for (unsigned long i = 0; i < n; ++i) p_[i] = c;
        n_ = n;
        p_[n_] = 0;
    }
    string(const char *first, const char *last) : p_(nullptr), n_(0), cap_(0) {
        assignChars(first, (unsigned long)(last - first));
    }
    // From any input iterators ([string.cons] p16): istreambuf_iterator, vector<char>::iterator.
    template <typename It>
    string(It first, It last) : p_(nullptr), n_(0), cap_(0) {
        release(grow(0));
        for (; first != last; ++first) push_back((char)*first);
    }
    ~string() { delete[] p_; }
    string &operator=(const string &o) {
        if (this == &o) return *this;
        n_ = 0;
        release(grow(o.n_));
        for (unsigned long i = 0; i < o.n_; ++i) p_[i] = o.p_[i];
        n_ = o.n_;
        p_[n_] = 0;
        return *this;
    }
    string &operator=(const char *s) {
        string t(s);  // s may point into this string
        return *this = t;
    }
    string &operator=(char c) {
        char one[1] = {c};
        assignChars(one, 1);
        return *this;
    }
    unsigned long size() const { return n_; }
    unsigned long length() const { return n_; }
    bool empty() const { return n_ == 0; }
    const char *c_str() const { return p_; }
    char &operator[](unsigned long i) { return p_[i]; }
    void clear() {
        n_ = 0;
        p_[0] = 0;
    }
    void push_back(char c) {
        release(grow(n_ + 1));
        p_[n_] = c;
        ++n_;
        p_[n_] = 0;
    }
    string &operator+=(const char *s) {
        unsigned long n = strlen(s);
        char *old = grow(n_ + n);
        for (unsigned long i = 0; i < n; ++i) p_[n_ + i] = s[i];
        n_ += n;
        p_[n_] = 0;
        release(old);
        return *this;
    }
    string &append(const string &o) {
        release(grow(n_ + o.n_));
        for (unsigned long i = 0; i < o.n_; ++i) p_[n_ + i] = o.p_[i];
        n_ += o.n_;
        p_[n_] = 0;
        return *this;
    }
    string operator+(const char *s) const {
        string r = *this;
        r += s;
        return r;
    }
    string operator+(const string &o) const {
        string r = *this;
        r.append(o);
        return r;
    }
    string operator+(char c) const {  // ([string.op.plus]) s + 'c'
        string r = *this;
        r.push_back(c);
        return r;
    }
    string &operator+=(const string &o) { return append(o); }
    string &operator+=(string_view v) { return append(v.data(), v.size()); }
    string &append(string_view v) { return append(v.data(), v.size()); }
    string &operator+=(char c) {
        push_back(c);
        return *this;
    }
    static constexpr unsigned long npos = 18446744073709551615UL;
    char &front() { return p_[0]; }
    char &back() { return p_[n_ - 1]; }
    char *begin() { return p_; }
    char *end() { return p_ + n_; }
    reverse_iterator<char *> rbegin() const { return reverse_iterator<char *>(p_ + n_); }
    reverse_iterator<char *> rend() const { return reverse_iterator<char *>(p_); }
    reverse_iterator<char *> crbegin() const { return rbegin(); }
    reverse_iterator<char *> crend() const { return rend(); }
    char &at(unsigned long i) { return p_[i]; }
    void pop_back() { p_[--n_] = 0; }
    void reserve(unsigned long n) { release(grow(n)); }
    void shrink_to_fit() {}  // [string.capacity]: a non-binding request; kept as it is
    void resize(unsigned long n, char c = 0) {
        release(grow(n));
        for (unsigned long i = n_; i < n; ++i) p_[i] = c;
        n_ = n;
        p_[n_] = 0;
    }
    // [string.substr]: at most n characters from pos (pos past the end is cut to the end; the
    // standard throws out_of_range there, which this subset does not do).
    string substr(unsigned long pos = 0, unsigned long n = npos) const {
        if (pos > n_) pos = n_;
        if (n > n_ - pos) n = n_ - pos;
        return string(p_ + pos, n);
    }
    // [string.append] p3: at most n characters of o from pos (pos past the end appends nothing;
    // the standard throws out_of_range there, which this subset does not do).
    string &append(const string &o, unsigned long pos, unsigned long n = npos) {
        if (pos > o.n_) pos = o.n_;
        if (n > o.n_ - pos) n = o.n_ - pos;
        string part(o.p_ + pos, n);  // (o may be this string)
        return append(part.p_, n);
    }
    string &append(unsigned long n, char c) {  // [string.append] n copies of c
        for (unsigned long i = 0; i < n; ++i) push_back(c);
        return *this;
    }
    string &append(const char *s, unsigned long n) {
        char *old = grow(n_ + n);
        for (unsigned long i = 0; i < n; ++i) p_[n_ + i] = s[i];
        n_ += n;
        p_[n_] = 0;
        release(old);
        return *this;
    }
    // [string.assign]: the contents replaced.
    string &assign(const char *s, unsigned long n) {
        string t(s, n);  // s may point into this string
        swap(t);
        return *this;
    }
    string &assign(const char *s) { return assign(s, strlen(s)); }
    string &assign(const string &o) { return assign(o.p_, o.n_); }
    string &assign(const string &o, unsigned long pos, unsigned long n = npos) {
        if (pos > o.n_) pos = o.n_;
        return assign(o.p_ + pos, o.n_ - pos < n ? o.n_ - pos : n);
    }
    string &assign(string_view v, unsigned long pos, unsigned long n = npos) {
        if (pos > v.size()) pos = v.size();
        return assign(v.data() + pos, v.size() - pos < n ? v.size() - pos : n);
    }
    string &assign(unsigned long n, char c) {
        string t(n, c);
        swap(t);
        return *this;
    }
    string &erase(unsigned long pos = 0, unsigned long n = npos) {
        if (pos > n_) pos = n_;
        if (n > n_ - pos) n = n_ - pos;
        for (unsigned long i = pos; i + n <= n_; ++i) p_[i] = p_[i + n];
        n_ -= n;
        return *this;
    }
    // [string.erase] erase(p): the character at p; returns where it was.
    char *erase(char *p) {
        unsigned long pos = (unsigned long)(p - p_);
        erase(pos, 1);
        return p_ + pos;
    }
    // [string.erase] erase(first, last): the characters in [first, last); returns where they were.
    char *erase(char *first, char *last) {
        unsigned long pos = (unsigned long)(first - p_);
        erase(pos, (unsigned long)(last - first));
        return p_ + pos;
    }
    string &insert(unsigned long pos, const char *s) {
        string tail = substr(pos);
        n_ = pos < n_ ? pos : n_;
        p_[n_] = 0;
        *this += s;
        return append(tail);
    }
    string &insert(unsigned long pos, const string &s) { return insert(pos, s.c_str()); }
    // [string.insert]: n characters from s (which may point into this string), and n copies of c.
    string &insert(unsigned long pos, const char *s, unsigned long n) {
        string part(s, n);
        string tail = substr(pos);
        n_ = pos < n_ ? pos : n_;
        p_[n_] = 0;
        append(part.p_, n);
        return append(tail);
    }
    string &insert(unsigned long pos, unsigned long n, char c) {
        string part;
        part.append(n, c);
        return insert(pos, part.p_, n);
    }
    // [string.insert] insert(p, c): c before the character at p; returns where it is. (Our iterator
    // is a pointer, so insert(p, n, c) is left out: insert(0, n, c) would be ambiguous.)
    char *insert(const char *p, char c) {
        unsigned long pos = (unsigned long)(p - p_);
        insert(pos, 1ul, c);
        return p_ + pos;
    }
    // [string.replace]: the n1 characters at pos (fewer at the end) become the given ones (s may
    // point into this string).
    string &replace(unsigned long pos, unsigned long n1, const char *s, unsigned long n2) {
        if (pos > n_) pos = n_;
        if (n1 > n_ - pos) n1 = n_ - pos;
        string r(p_, pos);
        r.append(s, n2);
        r.append(p_ + pos + n1, n_ - pos - n1);
        swap(r);
        return *this;
    }
    string &replace(unsigned long pos, unsigned long n1, const char *s) { return replace(pos, n1, s, strlen(s)); }
    string &replace(unsigned long pos, unsigned long n1, const string &s) { return replace(pos, n1, s.p_, s.n_); }
    string &replace(unsigned long pos, unsigned long n1, unsigned long n2, char c) {
        string t(n2, c);
        return replace(pos, n1, t.p_, n2);
    }
    // [string.find]: the first (or, for rfind, the last) place at or after (before) pos.
    unsigned long find(char c, unsigned long pos = 0) const {
        for (unsigned long i = pos; i < n_; ++i)
            if (p_[i] == c) return i;
        return npos;
    }
    unsigned long find(const char *s, unsigned long pos = 0) const {
        unsigned long m = strlen(s);
        for (unsigned long i = pos; i + m <= n_; ++i)
            if (same(i, s, m)) return i;
        return npos;
    }
    unsigned long find(const string &s, unsigned long pos = 0) const { return find(s.c_str(), pos); }
    unsigned long rfind(char c, unsigned long pos = npos) const {
        if (n_ == 0) return npos;
        unsigned long i = pos < n_ ? pos : n_ - 1;
        for (;; --i) {
            if (p_[i] == c) return i;
            if (i == 0) return npos;
        }
    }
    unsigned long rfind(const char *s, unsigned long pos = npos) const {
        unsigned long m = strlen(s);
        if (m > n_) return npos;
        unsigned long i = pos < n_ - m ? pos : n_ - m;
        for (;; --i) {
            if (same(i, s, m)) return i;
            if (i == 0) return npos;
        }
    }
    unsigned long rfind(const string &s, unsigned long pos = npos) const { return rfind(s.c_str(), pos); }
    unsigned long find_first_of(const string &set, unsigned long pos = 0) const { return scan(set.c_str(), pos, true, true); }
    unsigned long find_first_of(char c, unsigned long pos = 0) const { return find(c, pos); }
    unsigned long find_last_of(const string &set, unsigned long pos = npos) const { return scan(set.c_str(), pos, false, true); }
    unsigned long find_last_of(char c, unsigned long pos = npos) const { return rfind(c, pos); }
    unsigned long find_first_not_of(const string &set, unsigned long pos = 0) const { return scan(set.c_str(), pos, true, false); }
    unsigned long find_last_not_of(const string &set, unsigned long pos = npos) const { return scan(set.c_str(), pos, false, false); }
    // [string.compare]: the part [pos, pos + len) against s; by bytes, then the shorter first.
    int compareN(unsigned long pos, unsigned long len, const char *s, unsigned long m) const {
        if (pos > n_) pos = n_;
        unsigned long r = n_ - pos < len ? n_ - pos : len;
        unsigned long k = r < m ? r : m;
        for (unsigned long i = 0; i < k; ++i)
            if (p_[pos + i] != s[i]) return (unsigned char)p_[pos + i] < (unsigned char)s[i] ? -1 : 1;
        return r < m ? -1 : (r > m ? 1 : 0);
    }
    int compare(unsigned long pos, unsigned long len, const string &o) const { return compareN(pos, len, o.p_, o.n_); }
    int compare(unsigned long pos, unsigned long len, const char *s) const { return compareN(pos, len, s, strlen(s)); }
    int compare(unsigned long pos, unsigned long len, const string &o, unsigned long pos2, unsigned long len2 = npos) const {
        if (pos2 > o.n_) pos2 = o.n_;
        unsigned long m = o.n_ - pos2 < len2 ? o.n_ - pos2 : len2;
        return compareN(pos, len, o.p_ + pos2, m);
    }
    int compare(unsigned long pos, unsigned long len, const char *s, unsigned long m) const { return compareN(pos, len, s, m); }
    unsigned long find_first_of(const char *set, unsigned long pos = 0) const { return scan(set, pos, true, true); }
    unsigned long find_first_not_of(const char *set, unsigned long pos = 0) const { return scan(set, pos, true, false); }
    unsigned long find_first_not_of(char c, unsigned long pos = 0) const {
        char set[2] = {c, 0};
        return scan(set, pos, true, false);
    }
    unsigned long find_last_of(const char *set, unsigned long pos = npos) const { return scan(set, pos, false, true); }
    unsigned long find_last_not_of(const char *set, unsigned long pos = npos) const { return scan(set, pos, false, false); }
    unsigned long find_last_not_of(char c, unsigned long pos = npos) const {
        char set[2] = {c, 0};
        return scan(set, pos, false, false);
    }
    int compare(const char *s) const { return strcmp(p_, s); }
    bool operator!=(const char *s) const { return strcmp(p_, s) != 0; }
    bool operator==(const char *s) const { return strcmp(p_, s) == 0; }
    bool operator==(const string &o) const { return strcmp(p_, o.p_) == 0; }
    bool operator!=(const string &o) const { return strcmp(p_, o.p_) != 0; }
    bool operator<(const string &o) const { return strcmp(p_, o.p_) < 0; }
    bool operator>(const string &o) const { return strcmp(p_, o.p_) > 0; }
    bool operator<=(const string &o) const { return strcmp(p_, o.p_) <= 0; }
    bool operator>=(const string &o) const { return strcmp(p_, o.p_) >= 0; }
    const char *data() const { return p_; }
    int compare(const string &o) const { return strcmp(p_, o.p_); }

    void swap(string &o) {  // [string.swap]: the buffers change hands
        char *p = p_;
        p_ = o.p_;
        o.p_ = p;
        unsigned long n = n_;
        n_ = o.n_;
        o.n_ = n;
        unsigned long c = cap_;
        cap_ = o.cap_;
        o.cap_ = c;
    }
private:
    void assignChars(const char *s, unsigned long n) {
        release(grow(n));
        for (unsigned long i = 0; i < n; ++i) p_[i] = s[i];
        n_ = n;
        p_[n_] = 0;
    }
    bool same(unsigned long at, const char *s, unsigned long m) const {
        for (unsigned long k = 0; k < m; ++k)
            if (p_[at + k] != s[k]) return false;
        return true;
    }
    // find_first_of / find_last_of and their _not_ forms: walk forward from pos or back from pos,
    // stop at the first character whose membership in set is `in`.
    unsigned long scan(const char *set, unsigned long pos, bool forward, bool in) const {
        if (n_ == 0) return npos;
        if (forward) {
            for (unsigned long i = pos; i < n_; ++i)
                if ((strchr(set, p_[i]) != nullptr && p_[i] != 0) == in) return i;
            return npos;
        }
        unsigned long i = pos < n_ ? pos : n_ - 1;
        for (;; --i) {
            if ((strchr(set, p_[i]) != nullptr && p_[i] != 0) == in) return i;
            if (i == 0) return npos;
        }
    }
    // Make room for n characters. The old buffer is freed only by the caller's release(), after the
    // new text has been copied in (s += s.c_str() reads from the old buffer while appending).
    char *grow(unsigned long n) {
        if (p_ && n < cap_) return nullptr;
        unsigned long c = cap_ < 15 ? 15 : cap_;
        while (c <= n) c = c * 2;
        char *q = new char[c + 1];
        for (unsigned long i = 0; i < n_; ++i) q[i] = p_[i];
        q[n_] = 0;
        char *old = p_;
        p_ = q;
        cap_ = c;
        return old;
    }
    static void release(char *old) { delete[] old; }
    char *p_;
    unsigned long n_;
    unsigned long cap_;
};
// string and string_view ([string.view.cons], [string.view.comparison]).
inline string_view::string_view(const string &s) : __p(s.data()), __n(s.size()) {}
inline bool operator==(const string &a, string_view b) { return string_view(a) == b; }
inline bool operator!=(const string &a, string_view b) { return string_view(a) != b; }
inline bool operator==(string_view a, const string &b) { return a == string_view(b); }
inline bool operator!=(string_view a, const string &b) { return a != string_view(b); }
inline bool operator<(const string &a, string_view b) { return string_view(a) < b; }
inline bool operator<(string_view a, const string &b) { return a < string_view(b); }
inline string operator+(const string &a, string_view b) {
    string r = a;
    r += b;
    return r;
}
// The non-member operators with a C string on the left ([string.op.plus], [string.cmp]).
inline string operator+(const char *a, const string &b) {
    string r(a);
    r += b;
    return r;
}
inline string operator+(char a, const string &b) {
    string r(1, a);
    r += b;
    return r;
}
inline bool operator==(const char *a, const string &b) { return b == a; }
inline bool operator!=(const char *a, const string &b) { return b != a; }
// hash<string> ([basic.string.hash]): FNV-1a over the characters (Fowler, Noll and Vo; offset basis
// 14695981039346656037, prime 1099511628211), our own choice of string hash.
// hash<string_view>: the same FNV-1a as hash<string>, so equal text hashes alike.
template <>
struct hash<string_view> {
    unsigned long operator()(string_view s) const {
        unsigned long h = 14695981039346656037UL;
        for (unsigned long i = 0; i < s.size(); ++i) {
            h ^= (unsigned char)s[i];
            h *= 1099511628211UL;
        }
        return h;
    }
};
template <>
struct hash<string> {
    unsigned long operator()(const string &s) const {
        unsigned long h = 14695981039346656037UL;
        for (unsigned long i = 0; i < s.size(); ++i) {
            h ^= (unsigned char)s[i];
            h *= 1099511628211UL;
        }
        return h;
    }
};
// Numbers to strings and back ([string.conversions]): to_string is printf with %d, %u, %ld, %lu and
// %f; the sto* functions are strtol, strtoul and strtod (the out_of_range and invalid_argument
// exceptions are not thrown: a bad string gives 0).
inline string to_string(int v) {
    char b[24];
    snprintf(b, sizeof(b), "%d", v);
    return string(b);
}
inline string to_string(unsigned int v) {
    char b[24];
    snprintf(b, sizeof(b), "%u", v);
    return string(b);
}
inline string to_string(long v) {
    char b[24];
    snprintf(b, sizeof(b), "%ld", v);
    return string(b);
}
inline string to_string(unsigned long v) {
    char b[24];
    snprintf(b, sizeof(b), "%lu", v);
    return string(b);
}
inline string to_string(double v) {
    char b[400];
    snprintf(b, sizeof(b), "%f", v);
    return string(b);
}
inline string to_string(float v) { return to_string((double)v); }
inline long stol(const string &s, unsigned long *idx = nullptr, int base = 10) {
    char *end = nullptr;
    long v = strtol(s.c_str(), &end, base);
    if (idx) *idx = (unsigned long)(end - s.c_str());
    return v;
}
inline int stoi(const string &s, unsigned long *idx = nullptr, int base = 10) { return (int)stol(s, idx, base); }
inline long stoll(const string &s, unsigned long *idx = nullptr, int base = 10) { return stol(s, idx, base); }
inline unsigned long stoul(const string &s, unsigned long *idx = nullptr, int base = 10) {
    char *end = nullptr;
    unsigned long v = strtoul(s.c_str(), &end, base);
    if (idx) *idx = (unsigned long)(end - s.c_str());
    return v;
}
inline unsigned long stoull(const string &s, unsigned long *idx = nullptr, int base = 10) { return stoul(s, idx, base); }
inline double stod(const string &s, unsigned long *idx = nullptr) {
    char *end = nullptr;
    double v = strtod(s.c_str(), &end);
    if (idx) *idx = (unsigned long)(end - s.c_str());
    return v;
}
inline float stof(const string &s, unsigned long *idx = nullptr) { return (float)stod(s, idx); }
