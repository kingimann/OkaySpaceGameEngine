// Generated from cmake/okay_version.rc.in. The exe's name, description and
// version as Windows shows them (Task Manager, file Properties, Explorer), plus
// its application manifest.
#include <winver.h>

1 VERSIONINFO
 FILEVERSION @OKAY_RC_MAJOR@,@OKAY_RC_MINOR@,@OKAY_RC_PATCH@,0
 PRODUCTVERSION @OKAY_RC_MAJOR@,@OKAY_RC_MINOR@,@OKAY_RC_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OkaySpace\0"
            VALUE "FileDescription", "@OKAY_RC_DESCRIPTION@\0"
            VALUE "FileVersion", "@OKAY_RC_VERSION@\0"
            VALUE "InternalName", "@OKAY_RC_INTERNAL@\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 OkaySpaceGameEngine contributors. MIT License.\0"
            VALUE "OriginalFilename", "@OKAY_RC_FILENAME@\0"
            VALUE "ProductName", "OkaySpace Game Engine\0"
            VALUE "ProductVersion", "@OKAY_RC_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END

1 24 "@OKAY_RC_MANIFEST@"
