# Run with: cmake -DSOURCE_ROOT=<repo root> -P check_curl_seam_wiring.cmake
#
# The shipped programs must not start the external `curl` program on their own. Every HTTP call goes through the
# seam in engine/include/okay/Platform/NativeFetch.hpp (WinHTTP on Windows, our own client on Linux), and curl is
# only its last fallback, started in ONE place: okay::http::curlfb::RunCurlProcess in
# engine/include/okay/Platform/CurlFallback.hpp. This check fails and names the file when:
#   - a curl process is started anywhere else in launcher/, shared/, editor/, player/ or engine/ (a "curl" argv
#     element, a "curl -..." command line, or curl.exe), or
#   - RunCurlProcess is called from anywhere but NativeFetch.hpp (so no call site can skip the native client).
# Comments (// at the start of a line or after a space) are not counted.
cmake_minimum_required(VERSION 3.16)
if(NOT IS_DIRECTORY "${SOURCE_ROOT}")
    message(FATAL_ERROR "check_curl_seam_wiring: SOURCE_ROOT (${SOURCE_ROOT}) is not a directory")
endif()
set(_seam "${SOURCE_ROOT}/engine/include/okay/Platform/CurlFallback.hpp")
set(_front "${SOURCE_ROOT}/engine/include/okay/Platform/NativeFetch.hpp")
set(_bad "")
set(_bad_calls "")
set(_seam_ok FALSE)
foreach(_d launcher shared editor player engine)
    if(NOT IS_DIRECTORY "${SOURCE_ROOT}/${_d}")
        continue()
    endif()
    file(GLOB_RECURSE _files "${SOURCE_ROOT}/${_d}/*.cpp" "${SOURCE_ROOT}/${_d}/*.hpp" "${SOURCE_ROOT}/${_d}/*.h"
                             "${SOURCE_ROOT}/${_d}/*.inl" "${SOURCE_ROOT}/${_d}/*.mm")
    foreach(_f IN LISTS _files)
        if(_f MATCHES "/(third_party|_deps|build[^/]*)/")
            continue()
        endif()
        file(READ "${_f}" _text)
        # drop // comments (not the // inside "https://")
        string(REGEX REPLACE "(^|\n|[ \t;{}])//[^\n]*" "\\1" _code "${_text}")
        set(_spawn FALSE)
        if(_code MATCHES "\"curl\"[ \t\n]*[,}]" OR _code MATCHES "\"curl -" OR _code MATCHES "[Cc][Uu][Rr][Ll]\\.[Ee][Xx][Ee]")
            set(_spawn TRUE)
        endif()
        if(_f STREQUAL "${_seam}")
            if(_spawn)
                set(_seam_ok TRUE)
            endif()
        elseif(_spawn)
            list(APPEND _bad "${_f}")
        endif()
        if(_code MATCHES "RunCurlProcess[ \t]*\\(" AND NOT _f STREQUAL "${_seam}" AND NOT _f STREQUAL "${_front}")
            list(APPEND _bad_calls "${_f}")
        endif()
    endforeach()
endforeach()
if(NOT EXISTS "${_seam}")
    message(FATAL_ERROR "check_curl_seam_wiring: ${_seam} is missing (the one place curl may be started)")
endif()
if(NOT _seam_ok)
    message(FATAL_ERROR "check_curl_seam_wiring: CurlFallback.hpp no longer starts curl; update this check if curl was removed on purpose")
endif()
if(_bad)
    string(REPLACE ";" "\n  " _list "${_bad}")
    message(FATAL_ERROR "check_curl_seam_wiring: curl is started outside the seam (CurlFallback.hpp):\n  ${_list}\nUse okay::http::FetchToFile / HeadDump / FetchPrefix / Send (NativeFetch.hpp) instead.")
endif()
if(_bad_calls)
    string(REPLACE ";" "\n  " _list "${_bad_calls}")
    message(FATAL_ERROR "check_curl_seam_wiring: RunCurlProcess called outside NativeFetch.hpp:\n  ${_list}")
endif()
message(STATUS "check_curl_seam_wiring: ok")
