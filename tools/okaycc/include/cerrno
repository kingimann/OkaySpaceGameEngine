// <cerrno> for okay-cc (ISO/IEC 14882 [errno], ISO C 7.5, POSIX <errno.h>). Our own header. errno is
// one int for the whole program (okay-cc programs have one thread), reached through
// __okay_errno() in lib/extra.c. The numbers are the Linux system-call error numbers. Our own C
// library sets errno only where it says so (lib/extra.c); most functions leave it as it is.
#pragma once
extern "C" int *__okay_errno(void);
#define errno (*__okay_errno())
