template <typename T>
struct atomic<T*> {
    // Pointer arithmetic in units of T ([atomics.types.pointer]); no bit operations.
    T* v_;
    atomic() : v_(0) {}
    atomic(T* desired) : v_(desired) {}
    T* load(memory_order = memory_order_seq_cst) const { return v_; }
    void store(T* desired, memory_order = memory_order_seq_cst) { v_ = desired; }
    T* exchange(T* desired, memory_order = memory_order_seq_cst) { T* old = v_; v_ = desired; return old; }
    bool compare_exchange_strong(T*& expected, T* desired, memory_order = memory_order_seq_cst) {
        if (v_ == expected) {
            v_ = desired;
            return true;
        }
        expected = v_;
        return false;
    }
    bool compare_exchange_weak(T*& expected, T* desired, memory_order = memory_order_seq_cst) {
        return compare_exchange_strong(expected, desired);
    }
    T* fetch_add(long long arg, memory_order = memory_order_seq_cst) { T* old = v_; v_ = v_ + arg; return old; }
    T* fetch_sub(long long arg, memory_order = memory_order_seq_cst) { T* old = v_; v_ = v_ - arg; return old; }
    bool is_lock_free() const { return true; }
    operator T*() const { return v_; }
    T* operator=(T* desired) { v_ = desired; return desired; }
    T* operator++() { v_ = v_ + 1; return v_; }
    T* operator++(int) { T* old = v_; v_ = v_ + 1; return old; }
    T* operator--() { v_ = v_ - 1; return v_; }
    T* operator--(int) { T* old = v_; v_ = v_ - 1; return old; }
    T* operator+=(long long arg) { v_ = v_ + arg; return v_; }
    T* operator-=(long long arg) { v_ = v_ - arg; return v_; }
};

typedef atomic<bool> atomic_bool;
typedef atomic<int> atomic_int;
typedef atomic<unsigned> atomic_uint;
typedef atomic<long long> atomic_llong;
typedef atomic<unsigned long long> atomic_ullong;

// atomic_flag ([atomics.flag]), the same single-thread subset: test_and_set sets the flag and returns what it was.
struct atomic_flag {
    bool v_;
    bool test_and_set(memory_order order = memory_order_seq_cst) {
        (void)order;
        const bool was = v_;
        v_ = true;
        return was;
    }
    void clear(memory_order order = memory_order_seq_cst) {
        (void)order;
        v_ = false;
    }
    bool test(memory_order order = memory_order_seq_cst) const {
        (void)order;
        return v_;
    }
};
#define ATOMIC_FLAG_INIT {false}

inline void atomic_thread_fence(memory_order) {}
inline void atomic_signal_fence(memory_order) {}
