# One OkayScript CLI case: run the okayscript program and compare stdout, stderr and the exit code.
#   cmake -DEXE=<okayscript> -DDIR=<tests/okayscript_cli> -DCASE=<name> -P run_cli_case.cmake
# <name>.okay   the program (optional: without it the arguments alone are passed, e.g. -e "code")
# <name>.args   extra arguments, one per line (optional; no ';' in them: CMake lists split on it)
# <name>.in     standard input (optional)
# <name>.out    expected standard output (default: nothing)
# <name>.err    expected standard error (default: nothing)
# <name>.code   expected exit code (default: 0)
set(args "")
if(EXISTS "${DIR}/${CASE}.args")
    file(STRINGS "${DIR}/${CASE}.args" args)
endif()
if(EXISTS "${DIR}/${CASE}.okay")
    set(cmd "${EXE}" "${CASE}.okay" ${args})
else()
    set(cmd "${EXE}" ${args})
endif()
set(input "")
if(EXISTS "${DIR}/${CASE}.in")
    set(input INPUT_FILE "${DIR}/${CASE}.in")
endif()
execute_process(COMMAND ${cmd} WORKING_DIRECTORY "${DIR}" ${input}
                RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
set(want_out "")
set(want_err "")
set(want_code 0)
if(EXISTS "${DIR}/${CASE}.out")
    file(READ "${DIR}/${CASE}.out" want_out)
endif()
if(EXISTS "${DIR}/${CASE}.err")
    file(READ "${DIR}/${CASE}.err" want_err)
endif()
if(EXISTS "${DIR}/${CASE}.code")
    file(READ "${DIR}/${CASE}.code" want_code)
    string(STRIP "${want_code}" want_code)
endif()
foreach(v out err want_out want_err)
    string(REPLACE "\r\n" "\n" ${v} "${${v}}")
endforeach()
set(failed OFF)
if(NOT "${code}" STREQUAL "${want_code}")
    message("exit code: got '${code}', expected '${want_code}'")
    set(failed ON)
endif()
if(NOT "${out}" STREQUAL "${want_out}")
    message("stdout differs.\n--- got ---\n${out}--- expected ---\n${want_out}---")
    set(failed ON)
endif()
if(NOT "${err}" STREQUAL "${want_err}")
    message("stderr differs.\n--- got ---\n${err}--- expected ---\n${want_err}---")
    set(failed ON)
endif()
if(failed)
    message(FATAL_ERROR "okayscript CLI case '${CASE}' failed")
endif()
message("okayscript CLI case '${CASE}': exit ${code}, stdout and stderr as expected")
