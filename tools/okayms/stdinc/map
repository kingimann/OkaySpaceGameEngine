// okay-ms own standard header: std::map and std::multimap, written from ISO/IEC 14882 [map] and [multimap]. Own minimal
// version, the same design as <set>: the entries are kept in a vector sorted by key (found by binary search), so
// iterators are plain pointers to pair<K, V> and an insert or erase in the middle moves the entries after it (linear
// time, where the standard says logarithmic). Differences from the standard: the element is pair<K, V>, not
// pair<const K, V> (the key can be written through an iterator, which the standard forbids); iterators and references
// are invalidated by an insert or erase; ordering is by the comparator C (std::less<K>, operator< on the key, unless another is given). at() of a
// missing key throws out_of_range ([map.access]) in a file that uses exceptions; in a file that does not, it returns a
// value-initialized V kept in a static of at() (Round 32: it was a member, so a map of a V with no default constructor,
// such as std::type_index, could not be made at all). No allocator.
#pragma once
#include <cstddef>
#include <initializer_list>
#include <utility>
#include <vector>
#include <iterator>
#include <stdexcept>
namespace std {
// The node handle of map::extract ([container.node]; Round 33, Localization.cpp's rename): own simplification, it holds a
// copy of the entry (okay-ms's map keeps entries in a vector, not in nodes); empty() when nothing was extracted.
template <typename K, typename V>
struct __okay_map_node {
    pair<K, V> entry__;
    bool has__;
    __okay_map_node() : entry__(), has__(false) {}
    bool empty() const { return !has__; }
    explicit operator bool() const { return has__; }
    K& key() { return entry__.first; }
    V& mapped() { return entry__.second; }
};
template <typename K, typename V, typename C = less<K> >
class map {
    vector<pair<K, V> > items_;
    C cmp_;

    // The index of the first entry whose key is not less than key.
    size_t lower(const K& key) const {
        size_t lo = 0;
        size_t hi = items_.size();
        while (lo < hi) {
            const size_t mid = lo + (hi - lo) / 2;
            if (cmp_(items_[mid].first, key)) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }
    bool found_at(size_t at, const K& key) const { return at < items_.size() && !cmp_(key, items_[at].first); }

public:
    typedef K key_type;
    typedef C key_compare;
    typedef V mapped_type;
    typedef pair<K, V> value_type;
    typedef size_t size_type;
    typedef pair<K, V>* iterator;
    typedef const pair<K, V>* const_iterator;

    map() {}
    map(initializer_list<pair<K, V> > list) {
        for (size_t i = 0; i < list.size(); ++i) insert(list.begin()[i]);
    }
    template <typename It>
    map(It first, It last) {
        for (; first != last; ++first) insert(*first);
    }
    size_t size() const { return items_.size(); }
    bool empty() const { return items_.empty(); }
    pair<K, V>* begin() { return items_.begin(); }
    const pair<K, V>* begin() const { return items_.begin(); }
    pair<K, V>* end() { return items_.end(); }
    const pair<K, V>* end() const { return items_.end(); }
    std::reverse_iterator<pair<K, V>*> rbegin() { return std::reverse_iterator<pair<K, V>*>(end()); }
    std::reverse_iterator<const pair<K, V>*> rbegin() const { return std::reverse_iterator<const pair<K, V>*>(end()); }
    std::reverse_iterator<pair<K, V>*> rend() { return std::reverse_iterator<pair<K, V>*>(begin()); }
    std::reverse_iterator<const pair<K, V>*> rend() const { return std::reverse_iterator<const pair<K, V>*>(begin()); }
    void clear() { items_.clear(); }
    // Exchanges the contents with another map ([map.overview], [container.reqmts]).
    void swap(map& other) { items_.swap(other.items_); }
    size_t count(const K& key) const { return found_at(lower(key), key) ? 1 : 0; }
    bool contains(const K& key) const { return found_at(lower(key), key); }
    pair<K, V>* find(const K& key) {
        const size_t at = lower(key);
        return found_at(at, key) ? items_.begin() + at : items_.end();
    }
    const pair<K, V>* find(const K& key) const {
        const size_t at = lower(key);
        return found_at(at, key) ? items_.begin() + at : items_.end();
    }
    // The entry of key, made with a value-initialized V when there is none ([map.access]).
    V& operator[](const K& key) {
        const size_t at = lower(key);
        if (!found_at(at, key)) items_.insert(items_.begin() + at, pair<K, V>(key, V()));
        return items_[at].second;
    }
    V& at(const K& key) {
        const size_t i = lower(key);
        if (!found_at(i, key)) return __okay_missing();
        return items_[i].second;
    }
    const V& at(const K& key) const {
        const size_t i = lower(key);
        if (!found_at(i, key)) return __okay_missing();
        return items_[i].second;
    }
    // at() of a missing key: out_of_range where exceptions are used, else a value-initialized V (made on first use).
    static V& __okay_missing() {
        __okay_throw_if_eh(out_of_range("map::at"));
        static V missing = V();
        return missing;
    }
    // The position of the entry and whether it was new; an existing entry is left as it is.
    pair<pair<K, V>*, bool> insert(const pair<K, V>& entry) {
        const size_t at = lower(entry.first);
        if (found_at(at, entry.first)) return pair<pair<K, V>*, bool>(items_.begin() + at, false);
        items_.insert(items_.begin() + at, entry);
        return pair<pair<K, V>*, bool>(items_.begin() + at, true);
    }
    pair<pair<K, V>*, bool> emplace(const K& key, const V& value) { return insert(pair<K, V>(key, value)); }
    pair<pair<K, V>*, bool> insert_or_assign(const K& key, const V& value) {
        const size_t at = lower(key);
        if (found_at(at, key)) {
            items_[at].second = value;
            return pair<pair<K, V>*, bool>(items_.begin() + at, false);
        }
        items_.insert(items_.begin() + at, pair<K, V>(key, value));
        return pair<pair<K, V>*, bool>(items_.begin() + at, true);
    }
    size_t erase(const K& key) {
        const size_t at = lower(key);
        if (!found_at(at, key)) return 0;
        items_.erase(items_.begin() + at);
        return 1;
    }
    pair<K, V>* erase(pair<K, V>* pos) {
        const size_t at = (size_t)(pos - items_.begin());
        items_.erase(items_.begin() + at);
        return items_.begin() + at;
    }
    typedef __okay_map_node<K, V> node_type;
    // extract(key) and insert(node) ([map.modifiers]): the entry taken out, and put back (under a key that may have been
    // changed). An insert of an empty node or of a key already present does nothing.
    __okay_map_node<K, V> extract(const K& key) {
        __okay_map_node<K, V> n;
        const size_t at = lower(key);
        if (!found_at(at, key)) return n;
        n.entry__ = items_[at];
        n.has__ = true;
        items_.erase(items_.begin() + at);
        return n;
    }
    void insert(__okay_map_node<K, V>&& n) {
        if (n.has__) insert(n.entry__);
        n.has__ = false;
    }
    pair<K, V>* lower_bound(const K& key) { return items_.begin() + lower(key); }
    const pair<K, V>* lower_bound(const K& key) const { return items_.begin() + lower(key); }
    pair<K, V>* upper_bound(const K& key) {
        size_t at = lower(key);
        if (found_at(at, key)) ++at;
        return items_.begin() + at;
    }
    // [container.reqmts] == and != (Round 31): before, there were none and okay-ms compared the objects' bytes
    // (SaveFramework.hpp's `m_values == o.m_values` on a std::map).
    bool operator==(const map& o) const { return items_ == o.items_; }
    bool operator!=(const map& o) const { return !(*this == o); }
};
// std::multimap ([multimap]; Round 33: VsTypes.cpp's multimap<int, int>, JsRuntime.cpp's unordered_multimap): the same
// sorted vector, where several entries may share a key; a new entry goes after the entries with an equal key, so
// equal keys keep the order they were inserted in ([associative.reqmts] 9).
template <typename K, typename V, typename C = less<K> >
class multimap {
    vector<pair<K, V> > items_;
    C cmp_;

    size_t lower(const K& key) const {
        size_t lo = 0;
        size_t hi = items_.size();
        while (lo < hi) {
            const size_t mid = lo + (hi - lo) / 2;
            if (cmp_(items_[mid].first, key)) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }
    size_t upper(const K& key) const {
        size_t lo = 0;
        size_t hi = items_.size();
        while (lo < hi) {
            const size_t mid = lo + (hi - lo) / 2;
            if (!cmp_(key, items_[mid].first)) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }

public:
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<K, V> value_type;
    typedef size_t size_type;
    typedef pair<K, V>* iterator;
    typedef const pair<K, V>* const_iterator;

    multimap() {}
    size_t size() const { return items_.size(); }
    bool empty() const { return items_.empty(); }
    pair<K, V>* begin() { return items_.begin(); }
    const pair<K, V>* begin() const { return items_.begin(); }
    pair<K, V>* end() { return items_.end(); }
    const pair<K, V>* end() const { return items_.end(); }
    void clear() { items_.clear(); }
    pair<K, V>* insert(const pair<K, V>& entry) {
        const size_t at = upper(entry.first);
        items_.insert(items_.begin() + at, entry);
        return items_.begin() + at;
    }
    pair<K, V>* emplace(const K& key, const V& value) { return insert(pair<K, V>(key, value)); }
    size_t count(const K& key) const { return upper(key) - lower(key); }
    pair<K, V>* find(const K& key) {
        const size_t at = lower(key);
        return at < upper(key) ? items_.begin() + at : items_.end();
    }
    const pair<K, V>* find(const K& key) const {
        const size_t at = lower(key);
        return at < upper(key) ? items_.begin() + at : items_.end();
    }
    pair<K, V>* lower_bound(const K& key) { return items_.begin() + lower(key); }
    pair<K, V>* upper_bound(const K& key) { return items_.begin() + upper(key); }
    pair<pair<K, V>*, pair<K, V>*> equal_range(const K& key) {
        return pair<pair<K, V>*, pair<K, V>*>(items_.begin() + lower(key), items_.begin() + upper(key));
    }
    pair<const pair<K, V>*, const pair<K, V>*> equal_range(const K& key) const {
        return pair<const pair<K, V>*, const pair<K, V>*>(items_.begin() + lower(key), items_.begin() + upper(key));
    }
    pair<K, V>* erase(pair<K, V>* pos) {
        const size_t at = (size_t)(pos - items_.begin());
        items_.erase(items_.begin() + at);
        return items_.begin() + at;
    }
    pair<K, V>* erase(pair<K, V>* first, pair<K, V>* last) {
        const size_t from = (size_t)(first - items_.begin());
        const size_t n = (size_t)(last - first);
        for (size_t i = 0; i < n; ++i) items_.erase(items_.begin() + from);
        return items_.begin() + from;
    }
    size_t erase(const K& key) {
        const size_t from = lower(key);
        const size_t n = upper(key) - from;
        for (size_t i = 0; i < n; ++i) items_.erase(items_.begin() + from);
        return n;
    }
};
}
