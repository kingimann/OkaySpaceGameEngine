cmake_policy(SET CMP0057 NEW)   # if(IN_LIST)
# Source-list helpers for okay_engine_uwp (EXPERIMENTAL, UNVERIFIED on Windows). Written for CMake 3.20+. No copying of the engine's list:
# the UWP target reads the engine's own add_library(okay_engine ...) list at configure time and drops what uwp_exclude.txt names, so a
# new engine source file is picked up automatically (and okay-uwp-audit then checks it for APIs a UWP app may not use).
# Also usable in script mode:  cmake -DOKAY_ROOT=<repo> -P platform/xbox_uwp/engine/uwp_sources.cmake   (prints the counts; the Linux test does this)

# okay_uwp_collect(<library name> <engine CMakeLists path> <out var>): the "src/...cpp" / ".c" entries of add_library(<name> ...).
function(okay_uwp_collect libname cmakefile outvar)
    file(STRINGS "${cmakefile}" _lines)
    set(_in FALSE)
    set(_out "")
    foreach(_l IN LISTS _lines)
        if(NOT _in)
            if(_l MATCHES "^add_library\\(${libname}( |$)")
                set(_in TRUE)
            else()
                continue()
            endif()
        endif()
        string(REGEX REPLACE "#.*$" "" _code "${_l}")
        string(REGEX MATCHALL "[A-Za-z0-9_./+-]+\\.(cpp|c)" _hits "${_code}")
        list(APPEND _out ${_hits})
        if(_code MATCHES "\\)[ \t]*$")
            break()
        endif()
    endforeach()
    set(${outvar} "${_out}" PARENT_SCOPE)
endfunction()

# okay_uwp_excluded(<exclude file> <out var>): the paths named in uwp_exclude.txt.
function(okay_uwp_excluded file outvar)
    file(STRINGS "${file}" _lines)
    set(_out "")
    foreach(_l IN LISTS _lines)
        string(REGEX REPLACE "#.*$" "" _code "${_l}")
        string(STRIP "${_code}" _code)
        if(NOT _code STREQUAL "")
            list(APPEND _out "${_code}")
        endif()
    endforeach()
    set(${outvar} "${_out}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND OKAY_ROOT)
    okay_uwp_collect(okay_engine "${OKAY_ROOT}/engine/CMakeLists.txt" _eng)
    okay_uwp_collect(okay_crypto "${OKAY_ROOT}/engine/CMakeLists.txt" _cry)
    okay_uwp_excluded("${OKAY_ROOT}/platform/xbox_uwp/engine/uwp_exclude.txt" _ex)
    list(LENGTH _eng _n1)
    list(LENGTH _cry _n2)
    list(LENGTH _ex _n3)
    set(_kept "")
    foreach(_s IN LISTS _eng)
        if(NOT _s IN_LIST _ex)
            list(APPEND _kept "${_s}")
        endif()
    endforeach()
    list(LENGTH _kept _n4)
    message(STATUS "okay_engine sources: ${_n1}; okay_crypto sources: ${_n2}; excluded: ${_n3}; compiled by okay_engine_uwp: ${_n4}")
endif()
