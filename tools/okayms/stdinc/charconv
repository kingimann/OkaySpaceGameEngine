// okay-ms own standard header: <charconv> ([charconv.syn]), written from ISO/IEC 14882. from_chars reads an integer of any size or a
// float or double from a character range (no leading white space, an optional '-', for floats the digits, a point, digits and an
// exponent; the value is built by repeated multiplication, so it is not always the correctly rounded one). to_chars writes
// integers in base 2 to 36. to_chars for float and double is NOT provided (no shortest round-trip printing here).
#pragma once
#include <system_error>
namespace std {
struct from_chars_result {
    const char* ptr;
    errc ec;
};
struct to_chars_result {
    char* ptr;
    errc ec;
};
template <typename T> from_chars_result from_chars_int_(const char* first, const char* last, T& value, int base) {
    from_chars_result r;
    r.ptr = first;
    r.ec = errc::none;
    const char* p = first;
    bool neg = false;
    if (p < last && *p == '-') {
        neg = true;
        ++p;
    }
    unsigned long long acc = 0;
    int digits = 0;
    bool overflow = false;
    for (; p < last; ++p) {
        int d;
        if (*p >= '0' && *p <= '9') d = *p - '0';
        else if (*p >= 'a' && *p <= 'z') d = *p - 'a' + 10;
        else if (*p >= 'A' && *p <= 'Z') d = *p - 'A' + 10;
        else break;
        if (d >= base) break;
        if (acc > (0xFFFFFFFFFFFFFFFFull - (unsigned long long)d) / (unsigned long long)base) overflow = true;
        else acc = acc * (unsigned long long)base + (unsigned long long)d;
        ++digits;
    }
    if (digits == 0) {
        r.ec = errc::invalid_argument;
        return r;
    }
    r.ptr = p;
    if (overflow) {
        r.ec = errc::result_out_of_range;
        return r;
    }
    T v = (T)acc;
    if (neg) v = (T)(0 - (T)acc);
    // range check by round trip: the value read back must equal the digits' value
    if ((unsigned long long)(neg ? (T)(0 - v) : v) != acc && !neg) r.ec = errc::result_out_of_range;
    value = v;
    return r;
}
