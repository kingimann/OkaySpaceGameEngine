# The UI icon set: every icon is drawn by our own code from a few shapes in a 24 x 24 box (no outside artwork).
# Shapes: c circle, o ring, e ellipse, r rect, q rounded rect, l line, p polygon, s polyline, a arc, t star, g regular polygon;
# a leading - cuts the shape out of what is already drawn. `use <icon> rot=90 flip=h` reuses another icon turned or mirrored.
# engine/include/okay/UI/UIIcons.hpp reads this file; tests/test_ui_icons.cpp checks every icon draws something and is deterministic.

[icon arrow-right]
category = Arrows
tags = next,forward,go
l 4 12 19 12 2
s 13 6 19 12 13 18 2

[icon arrow-down]
category = Arrows
tags = direction
use arrow-right rot=90

