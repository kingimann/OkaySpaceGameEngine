MD5Version 10
commandline "synthetic fixture for the own MD5 reader"

numJoints 3
numMeshes 3

joints {
	"base"	-1 ( 0 0 0 ) ( 0 0 0 )		// origin
	"arm"	0 ( 0 10 0 ) ( 0 0 0.70710678 )		// base
	"tip"	1 ( 0 10 5 ) ( 0 0 0 )		// arm
}

mesh {
	// meshes: arm
	shader "arm.tga"

	numverts 3
	vert 0 ( 0 0 ) 0 1
	vert 1 ( 1 0 ) 1 2
	vert 2 ( 0 1 ) 3 3

	numtris 1
	tri 0 0 1 2

	numweights 6
	weight 0 1 1 ( 1 0 0 )
	weight 1 0 0.5 ( 2 0 0 )
	weight 2 1 0.5 ( 0 2 0 )
	weight 3 0 0.25 ( 0 0 0 )
	weight 4 1 0.25 ( 0 0 0 )
	weight 5 2 0.5 ( 0 0 0 )
}

mesh {
	shader "models/zombie/body"

	numverts 3
	vert 0 ( 0 0 ) 0 1
	vert 1 ( 1 0 ) 1 1
	vert 2 ( 0 1 ) 2 1

	numtris 1
	tri 0 0 2 1

	numweights 3
	weight 0 0 1 ( 0 0 0 )
	weight 1 0 1 ( 4 0 0 )
	weight 2 0 1 ( 0 4 0 )
}

mesh {
	shader ""

	numverts 0

	numtris 0

	numweights 0
}
