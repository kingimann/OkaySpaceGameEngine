// <map> for okay-cc (ISO/IEC 14882 [map]). Our own header: std::map over the AVL tree of <__tree>.
// Keys are unique and ordered by C (std::less<K> by default). multimap is not done.
#pragma once
#include <__tree>
namespace std {
template <typename K, typename V, typename C = less<K>>
class map {
public:
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<const K, V> value_type;
    typedef __tree_it<K, V> iterator;
    typedef __tree_it<K, V> const_iterator;
    typedef unsigned long size_type;
    __tree<K, V, C> __t;

    map() {}
    map(const map<K, V, C> &o) { __t.copyFrom(o.__t); }
    map(map<K, V, C> &&o) { __t.takeFrom(o.__t); }
    map(initializer_list<value_type> il) {
        for (const value_type *p = il.begin(); p != il.end(); ++p) __t.insertValue(*p);
    }
    template <typename It>
    map(It first, It last) {  // ([associative.reqmts], [unord.req]) a range
        for (; first != last; ++first) insert(*first);
    }
    map<K, V, C> &operator=(const map<K, V, C> &o) {
        if (this != &o) {
            __t.clear();
            __t.copyFrom(o.__t);
        }
        return *this;
    }
    map<K, V, C> &operator=(map<K, V, C> &&o) {
        if (this != &o) {
            __t.clear();
            __t.takeFrom(o.__t);
        }
        return *this;
    }

    unsigned long size() const { return __t.__n; }
    bool empty() const { return __t.__n == 0; }
    void clear() { __t.clear(); }
    iterator begin() const { return iterator(__t.first(), &__t.__root); }
    iterator end() const { return iterator(nullptr, &__t.__root); }
    iterator find(const K &k) const { return iterator(__t.findNode(k), &__t.__root); }
    unsigned long count(const K &k) const { return __t.findNode(k) ? 1 : 0; }
    bool contains(const K &k) const { return __t.findNode(k) != nullptr; }
    iterator lower_bound(const K &k) const { return iterator(__t.bound(k, false), &__t.__root); }
    iterator upper_bound(const K &k) const { return iterator(__t.bound(k, true), &__t.__root); }
    V &operator[](const K &k) { return __t.at(k)->kv.second; }
    V &at(const K &k) const { return __t.findNode(k)->kv.second; }

    pair<iterator, bool> insert(const value_type &kv) {
        pair<__tree_node<K, V> *, bool> r = __t.insertValue(kv);
        return pair<iterator, bool>(iterator(r.first, &__t.__root), r.second);
    }
    template <typename A, typename B>
    pair<iterator, bool> emplace(A &&a, B &&b) {
        return insert(value_type(std::forward<A>(a), std::forward<B>(b)));
    }
    template <typename B>
    pair<iterator, bool> try_emplace(const K &k, B &&b) {
        __tree_node<K, V> *had = __t.findNode(k);
        if (had) return pair<iterator, bool>(iterator(had, &__t.__root), false);
        return insert(value_type(k, std::forward<B>(b)));
    }
    template <typename B>
    pair<iterator, bool> insert_or_assign(const K &k, B &&b) {
        __tree_node<K, V> *had = __t.findNode(k);
        if (had) {
            had->kv.second = std::forward<B>(b);
            return pair<iterator, bool>(iterator(had, &__t.__root), false);
        }
        return insert(value_type(k, std::forward<B>(b)));
    }
    unsigned long erase(const K &k) {
        __tree_node<K, V> *x = __t.findNode(k);
        if (!x) return 0;
        __t.eraseNode(x);
        return 1;
    }
    iterator erase(iterator it) {
        iterator next = it;
        ++next;
        __t.eraseNode(it.n);
        return next;
    }
    void swap(map<K, V, C> &o) {
        __tree_node<K, V> *r = __t.__root;
        unsigned long n = __t.__n;
        __t.__root = o.__t.__root;
        __t.__n = o.__t.__n;
        o.__t.__root = r;
        o.__t.__n = n;
    }
};
}  // namespace std
