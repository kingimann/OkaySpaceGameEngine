// <iterator> for okay-cc (ISO/IEC 14882 [iterator.synopsis]). Our own header: the iterator tags,
// next, prev, advance, distance (one step at a time, for every kind of iterator), back_inserter and
// istreambuf_iterator (<__stream>), reverse_iterator (<__reverse_iterator>). Not done: iterator_traits,
// move_iterator, the
// non-member begin/end/size/data.
#pragma once
#include <__stream>
#include <__reverse_iterator>
namespace std {
struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : input_iterator_tag {};
struct bidirectional_iterator_tag : forward_iterator_tag {};
struct random_access_iterator_tag : bidirectional_iterator_tag {};
template <typename It>
void advance(It &it, long n) {
    while (n > 0) {
        ++it;
        --n;
    }
    while (n < 0) {
        --it;
        ++n;
    }
}
// (Two overloads each rather than a default argument: okay-cc matches function templates by
// argument count.)
template <typename It>
It next(It it, long n) {
    advance(it, n);
    return it;
}
template <typename It>
It next(It it) {
    ++it;
    return it;
}
template <typename It>
It prev(It it, long n) {
    advance(it, -n);
    return it;
}
template <typename It>
It prev(It it) {
    --it;
    return it;
}
template <typename It>
long distance(It first, It last) {
    long n = 0;
    for (; first != last; ++first) ++n;
    return n;
}
// back_inserter ([back.insert.iterator]): *it = v appends v.
template <typename C>
class back_insert_iterator {
public:
    explicit back_insert_iterator(C &c) : __c(&c) {}
    template <typename V>
    back_insert_iterator<C> &operator=(const V &v) {
        __c->push_back(v);
        return *this;
    }
    back_insert_iterator<C> &operator*() { return *this; }
    back_insert_iterator<C> &operator++() { return *this; }
    back_insert_iterator<C> operator++(int) { return *this; }

private:
    C *__c;
};
template <typename C>
back_insert_iterator<C> back_inserter(C &c) {
    return back_insert_iterator<C>(c);
}
}  // namespace std
