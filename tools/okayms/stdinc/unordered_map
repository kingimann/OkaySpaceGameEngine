// okay-ms own standard header: std::unordered_map, written from ISO/IEC 14882 [unord.map]. Own minimal version: the entries
// are in a vector (iteration is in insertion order, an erase moves the last entry into the hole), and a table of chains of
// entry numbers is indexed by hash % table size (the table doubles when there are as many entries as slots). The hash is the
// third template argument (default std::hash<Key>) and the keys are compared with operator==. An iterator is a plain pointer to
// a pair<Key, Value>; an insert or erase invalidates iterators and references (the standard keeps them valid). The key in a
// pair is not const. No allocator, no equality-predicate argument (the fourth argument is accepted and ignored), no
// bucket interface, no exceptions (at() on a missing key makes the entry).
#pragma once
#include <cstddef>
#include <functional>
#include <initializer_list>
#include <utility>
#include <vector>
namespace std {
template <typename K, typename V, typename H = hash<K>, typename E = int, typename A = int>
class unordered_map {
    vector<pair<K, V>> items_;
    vector<int> next_;     // per entry: the next entry number in its chain, or -1
    vector<int> heads_;    // per slot: the first entry number, or -1
    H hasher_;

    size_t slot_of(const K& k) const { return (size_t)hasher_(k) % heads_.size(); }
    void rebuild(size_t slots) {
        heads_.clear();
        for (size_t i = 0; i < slots; ++i) heads_.push_back(-1);
        for (size_t i = 0; i < items_.size(); ++i) {
            const size_t s = slot_of(items_[i].first);
            next_[i] = heads_[s];
            heads_[s] = (int)i;
        }
    }
    int index_of(const K& k) const {
        if (heads_.empty()) return -1;
        int i = heads_[slot_of(k)];
        while (i >= 0) {
            if (items_[(size_t)i].first == k) return i;
            i = next_[(size_t)i];
        }
        return -1;
    }

public:
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<K, V> value_type;
    typedef size_t size_type;
    typedef pair<K, V>* iterator;
    typedef const pair<K, V>* const_iterator;

    unordered_map() {}
    template <typename It> unordered_map(It first, It last) {
        for (; first != last; ++first) insert(*first);
    }
    size_t size() const { return items_.size(); }
    bool empty() const { return items_.empty(); }
    pair<K, V>* begin() { return items_.begin(); }
    const pair<K, V>* begin() const { return items_.begin(); }
    pair<K, V>* end() { return items_.end(); }
    const pair<K, V>* end() const { return items_.end(); }
    void clear() {
        items_.clear();
        next_.clear();
        heads_.clear();
    }
    void swap(unordered_map& other) {
        items_.swap(other.items_);
        next_.swap(other.next_);
        heads_.swap(other.heads_);
    }
    void reserve(size_t) {}
    size_t count(const K& k) const { return index_of(k) >= 0 ? 1 : 0; }
    bool contains(const K& k) const { return index_of(k) >= 0; }
    pair<K, V>* find(const K& k) {
        const int i = index_of(k);
        return i < 0 ? items_.end() : items_.begin() + i;
    }
    const pair<K, V>* find(const K& k) const {
        const int i = index_of(k);
        return i < 0 ? items_.end() : items_.begin() + i;
    }
    pair<pair<K, V>*, bool> insert(const pair<K, V>& value) {
        const int at = index_of(value.first);
        if (at >= 0) return pair<pair<K, V>*, bool>(items_.begin() + at, false);
        if (heads_.empty()) rebuild(8);
        else if (items_.size() >= heads_.size()) rebuild(heads_.size() * 2);
        items_.push_back(value);
        next_.push_back(-1);
        const size_t s = slot_of(value.first);
        next_[items_.size() - 1] = heads_[s];
        heads_[s] = (int)items_.size() - 1;
        return pair<pair<K, V>*, bool>(items_.begin() + (items_.size() - 1), true);
    }
    pair<pair<K, V>*, bool> emplace(const K& k, const V& v) { return insert(pair<K, V>(k, v)); }
    V& operator[](const K& k) {
        const int at = index_of(k);
        if (at >= 0) return items_[(size_t)at].second;
        pair<K, V> entry(k, V());
        pair<pair<K, V>*, bool> r = insert(entry);
        return r.first->second;
    }
    V& at(const K& k) { return (*this)[k]; }
    size_t erase(const K& k) {
        const int at = index_of(k);
        if (at < 0) return 0;
        const size_t last = items_.size() - 1;
        if ((size_t)at != last) items_[(size_t)at] = items_[last];
        items_.pop_back();
        next_.pop_back();
        rebuild(heads_.size());
        return 1;
    }
};
}
