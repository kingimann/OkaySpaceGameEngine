inline istream &ws(istream &is) {
    for (;;) {
        int c = is.__sb ? is.__sb->__peek() : -1;
        if (c < 0) {
            is.setstate(ios_base::eofbit);
            break;
        }
        if (!(c == ' ' || (c >= 9 && c <= 13))) break;
        is.__sb->__get();
    }
    return is;
}
