// okay-ms own standard header: <cerrno>, written from ISO/IEC 14882 [cerrno.syn] and ISO/IEC 9899 7.5. errno is a
// modifiable int of its own in each thread (a thread_local here). The numbers of the error macros are those Microsoft
// documents for its C runtime ("errno constants"). Own simplification: errno lives in an inline function, so each object
// file has its own copy, and okay-ms's runtime functions (strtod, strtol) do not set it.
#pragma once
inline int& okay_errno__() {
    static thread_local int value = 0;
    return value;
}
#define errno (okay_errno__())
