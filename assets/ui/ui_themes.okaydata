# UI themes. The first twelve are the built-in looks already in UITheme (preset = name); the rest are defined here by their colours.
# A look bundles colours, a font name (only the smooth default font is used: no look switches the UI to the 8x8 pixel font), corner radius,
# spacing, animation timings and the names of its sounds. Put one on a screen or widget: ui_set_look("Pause Menu", "Neon") in a script, or the Look picker in the Inspector and the UI Gallery.
# Sound names are stored with the theme and read back with ui_look_sound("Neon", "click"); no sound files are shipped and nothing plays by itself yet.
# colours: panel panelBottom accent text muted danger success (#RRGGBB). Everything else (button hover, border, disabled...) is worked out from these.

[theme Dark]
preset = Dark
tags = dark,default,blue

[theme Light]
preset = Light
tags = light,default,warm

[theme Sci-fi]
preset = Sci-fi
tags = sci-fi,cyan,hud

[theme Fantasy]
preset = Fantasy
tags = fantasy,parchment,rpg

[theme Modern Flat]
preset = Modern Flat
tags = flat,modern,clean

[theme Cartoon]
preset = Cartoon
tags = cartoon,kids,bold

[theme Retro Pixel]
preset = Retro Pixel
tags = retro,pixel,arcade

[theme Minimal]
preset = Minimal
tags = minimal,mono,quiet

[theme Neon]
preset = Neon
tags = neon,glow,cyber

[theme Glass]
preset = Glass
tags = glass,blur,soft

[theme Military]
preset = Military
tags = military,olive,tactical

[theme Horror]
preset = Horror
tags = horror,red,dark

