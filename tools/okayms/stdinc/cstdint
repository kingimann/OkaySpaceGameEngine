// okay-ms own standard header (written from ISO/IEC 14882 [cstdint.syn]). The 8, 16 and 32-bit types
// exist. The 64-bit types need 64-bit integers, which okay-ms does not have yet: they are left out
// unless OKAYMS_INT64 is defined, so a use of one fails with "expected a type" instead of silently
// being 32 bits wide.
#pragma once
namespace std {
typedef signed char int8_t;
typedef short int16_t;
typedef int int32_t;
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
#ifdef OKAYMS_INT64
typedef long long int64_t;
typedef unsigned long long uint64_t;
typedef unsigned long long size_t;
#endif
}
