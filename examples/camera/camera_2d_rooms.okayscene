gameobject 25 "Hero"
  guid "c0f1fc58ec5d6a3ce33078f17faed009"
  active 1
  parent -1
  transform -8 0 0 0 0 0 1 1 1 1
  sprite 35 0.2 0.6 1 1 1 1 "" 0 0 1 1 5 0 0 0 0
  script "okayscript" "// Walk with W A S D. The camera holds each room and slides to the next when you cross over.
function update(dt) {
  var s = 9 * dt
  if (key(\"w\")) { set_y(pos_y() + s) }
  if (key(\"s\")) { set_y(pos_y() - s) }
  if (key(\"a\")) { set_x(pos_x() - s) }
  if (key(\"d\")) { set_x(pos_x() + s) }
}
" "" 0
end
