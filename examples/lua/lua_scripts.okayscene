  script "lua" "-- Spinner: turns around Y. \"speed\" is a setting you can change in the Inspector.
local Spinner = {
    speed = 90,   -- degrees per second
}

function Spinner:Update(dt)
    self.transform:Rotate(0, self.speed * dt, 0)
end

return Spinner
" "" 0
end
gameobject 4 "Player"
  guid "ad906ec160036263e79f33020404afbf"
  active 1
  parent -1
  transform 0 0.5 2 0 0 0 1 1 1 1
  mesh "Sphere" 0.27450982 0.5882353 0.8235294 1 0 "" 0
  material 0 0 0 0 16 0 "" 1 1
  script "lua" "-- Player: W A S D (or a controller stick) move the ball; Space jumps it up and down.
local Player = {
    speed = 6,
    jumpHeight = 2,
}

function Player:Start()
    self.home = self.transform.position
    self.hop = 0
    Debug.Log(\"Lua player ready on \" .. self.gameObject.name)
end

function Player:Update(dt)
    local move = Vector3.new(Input.GetAxis(\"Horizontal\"), 0, Input.GetAxis(\"Vertical\"))
    self.transform:Translate(move * (self.speed * dt))
    if Input.GetKeyDown(\"space\") and self.hop <= 0 then self.hop = 1 end
    if self.hop > 0 then
        self.hop = math.max(0, self.hop - dt * 2)
        local p = self.transform.position
        p.y = self.home.y + math.sin(self.hop * math.pi) * self.jumpHeight
        self.transform.position = p
    end
end

return Player
" "" 0
end
gameobject 5 "Bobber"
  guid "219726f8b6aa50340b6f0c7ab0b46ea0"
  active 1
  parent -1
  transform 4 0.5 0 0 0 0 1 1 1 1
  mesh "Cube" 0.3137255 0.7058824 0.3529412 1 0 "" 0
  material 0 0 0 0 16 0 "" 1 1
  script "lua" "-- Bobber: a coroutine moves the cube up, waits, and moves it down again, forever.
local Bobber = { height = 1.5, seconds = 1 }

-- yields until t seconds have passed; returns the time it waited
local function wait(t)
    local waited = coroutine.yield()
    while waited < t do waited = waited + coroutine.yield() end
    return waited
end

function Bobber:Start()
    local start = self.transform.position
    self.job = coroutine.wrap(function()
        while true do
            local t = 0
            while t < self.seconds do
                t = t + wait(0)
                local k = math.min(t / self.seconds, 1)
                self.transform.position = start + Vector3.up * (k * self.height)
            end
            wait(0.5)
            self.transform.position = start
            wait(0.5)
        end
    end)
end

function Bobber:Update(dt)
    self.job(dt)
end

return Bobber
" "" 0
end
