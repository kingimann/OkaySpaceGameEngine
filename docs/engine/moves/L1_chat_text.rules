add: ^\s*float MeasureChatBodyWidth\(const std::string\& bodyIn, float maxW\);$
add: ^\s*void IconTile\(const std::string\& name, float size\);(\s*//.*)?$
add: ^\s*void DrawTemplateStage\(ImDrawList\* d, const std::string\& title, ImVec2 a, ImVec2 b\);$
add: ^\s*unsigned char\* LoadRgbaFile\(const std::string\& path, int\* w, int\* h\);(\s*//.*)?$
add: ^\s*namespace fs = std::filesystem;(\s*//.*)?$
add: ^\s*extern ImVec4 kAccent;(\s*//.*)?$
add: ^\s*ImVec4 NameColor\(const std::string\& s\);(\s*//.*)?$
add: ^\s*void Toast\(const std::string\& m, int kind\);(\s*//.*)?$
