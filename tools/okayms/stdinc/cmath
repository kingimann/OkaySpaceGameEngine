// okay-ms own standard header: the <cmath> functions, written from their mathematical definitions (ISO/IEC 14882
// [c.math], ISO/IEC 9899 7.12); nothing here is taken from any C library. One overload each (okay-ms picks a function by
// name and argument count, not by type), the float one; the work is done in double and rounded to float at the end.
// The functions are defined here (inline), so a program needs no math library. Accuracy: a few units in the last place
// of float for the ranges the engine uses (it is not a correctly rounded library); the special cases of the standard
// (NaN, infinities, signed zero) are only handled where noted.
#pragma once
namespace std {
namespace okay_math {
union Bits64 { double d; unsigned long long u; };
inline double abs_d(double x) { return x < 0.0 ? -x : x; }
inline bool isnan_d(double x) { return x != x; }
inline double inf_d() { Bits64 b; b.u = 0x7FF0000000000000ULL; return b.d; }
inline double nan_d() { Bits64 b; b.u = 0x7FF8000000000000ULL; return b.d; }
// x = m * 2^e with m in [1, 2) (x finite and > 0): the exponent comes from the IEEE-754 binary64 layout.
inline double split2(double x, int* e) {
    Bits64 b;
    b.d = x;
    int ex = (int)((b.u >> 52) & 0x7FF);
    if (ex == 0) {  // subnormal: scale up first
        b.d = x * 18014398509481984.0;  // 2^54
        ex = (int)((b.u >> 52) & 0x7FF) - 54;
    }
    *e = ex - 1023;
    b.u = (b.u & 0x800FFFFFFFFFFFFFULL) | 0x3FF0000000000000ULL;
    return b.d;
}
inline double scale2(double x, int e) {  // x * 2^e by repeated exact steps
    while (e > 1000) { x *= 8.98846567431158e307; e -= 1023; }
    while (e < -1000) { x *= 1.1125369292536007e-308; e += 1022; }
    Bits64 b;
    b.u = (unsigned long long)(e + 1023) << 52;
    return x * b.d;
}
inline double sqrt_d(double x) {
    if (isnan_d(x) || x < 0.0) return nan_d();
    if (x == 0.0 || x == inf_d()) return x;
    int e;
    double m = split2(x, &e);       // x = m * 2^e
    if (e & 1) { m *= 2.0; e -= 1; }  // make the exponent even
    double g = 0.5 * (1.0 + m);      // Newton steps for sqrt(m), m in [1, 4)
    for (int i = 0; i < 6; ++i) g = 0.5 * (g + m / g);
    return scale2(g, e / 2);
}
// sin and cos of x in [-pi/4, pi/4] by their Taylor series.
inline double sin_small(double x) {
    const double x2 = x * x;
    double term = x, sum = x;
    for (int k = 1; k <= 9; ++k) {
        term = -term * x2 / (double)((2 * k) * (2 * k + 1));
        sum += term;
    }
    return sum;
}
inline double cos_small(double x) {
    const double x2 = x * x;
    double term = 1.0, sum = 1.0;
    for (int k = 1; k <= 9; ++k) {
        term = -term * x2 / (double)((2 * k - 1) * (2 * k));
        sum += term;
    }
    return sum;
}
inline double sin_cos_d(double x, bool want_sin) {
    const double pi_2 = 1.5707963267948966;
    if (isnan_d(x) || abs_d(x) > 1e15) return nan_d();
    // quadrant: x = q * pi/2 + r, r in [-pi/4, pi/4]
    double qd = x / pi_2;
    long long q = (long long)(qd < 0.0 ? qd - 0.5 : qd + 0.5);
    // pi/2 in two parts for a smaller reduction error
    const double hi = 1.5707963267948966, lo = 6.123233995736766e-17;
    double r = (x - (double)q * hi) - (double)q * lo;
    int quad = (int)(((q % 4) + 4) % 4);
    if (!want_sin) quad = (quad + 1) & 3;  // cos(x) = sin(x + pi/2)
    switch (quad) {
    case 0: return sin_small(r);
    case 1: return cos_small(r);
    case 2: return -sin_small(r);
    default: return -cos_small(r);
    }
}
// atan of x by halving the angle until the series converges quickly.
inline double atan_d(double x) {
    if (isnan_d(x)) return x;
    bool neg = x < 0.0;
    if (neg) x = -x;
    bool inv = x > 1.0;
    if (inv) x = 1.0 / x;
    int halves = 0;
    while (x > 0.2) {
        x = x / (1.0 + sqrt_d(1.0 + x * x));  // tan(a/2) = tan(a) / (1 + sqrt(1 + tan(a)^2))
        ++halves;
    }
    const double x2 = x * x;
    double term = x, sum = x;
    for (int k = 1; k <= 12; ++k) {
        term = -term * x2;
        sum += term / (double)(2 * k + 1);
    }
    sum = scale2(sum, halves);
    if (inv) sum = 1.5707963267948966 - sum;
    return neg ? -sum : sum;
}
inline double exp_d(double x) {
    if (isnan_d(x)) return x;
    if (x > 709.78) return inf_d();
    if (x < -745.2) return 0.0;
    const double ln2 = 0.6931471805599453;
    double kd = x / ln2;
    long long k = (long long)(kd < 0.0 ? kd - 0.5 : kd + 0.5);
    double r = x - (double)k * ln2;  // |r| <= ln2 / 2
    double term = 1.0, sum = 1.0;
    for (int i = 1; i <= 18; ++i) {
        term = term * r / (double)i;
        sum += term;
    }
    return scale2(sum, (int)k);
}
inline double log_d(double x) {
    if (isnan_d(x) || x < 0.0) return nan_d();
    if (x == 0.0) return -inf_d();
    if (x == inf_d()) return x;
    int e;
    double m = split2(x, &e);  // x = m * 2^e, m in [1, 2)
    if (m > 1.4142135623730951) { m *= 0.5; e += 1; }
    // log(m) = 2 atanh(s), s = (m - 1) / (m + 1), |s| < 0.18
    const double s = (m - 1.0) / (m + 1.0);
    const double s2 = s * s;
    double term = s, sum = 0.0;
    for (int k = 0; k < 14; ++k) {
        sum += term / (double)(2 * k + 1);
        term *= s2;
    }
    return 2.0 * sum + (double)e * 0.6931471805599453;
}
inline double floor_d(double x) {
    if (isnan_d(x) || abs_d(x) >= 4503599627370496.0) return x;  // 2^52: already whole
    double t = (double)(long long)x;
    return t > x ? t - 1.0 : t;
}
inline double trunc_d(double x) {
    if (isnan_d(x) || abs_d(x) >= 4503599627370496.0) return x;
    return (double)(long long)x;
}
inline double pow_d(double x, double y) {
    if (y == 0.0) return 1.0;
    if (isnan_d(x) || isnan_d(y)) return nan_d();
    const bool y_whole = y == trunc_d(y) && abs_d(y) < 4503599627370496.0;
    if (y_whole && abs_d(y) <= 64.0) {  // small whole exponents: exact repeated multiplication
        long long n = (long long)y;
        bool neg = n < 0;
        if (neg) n = -n;
        double r = 1.0, base = x;
        while (n > 0) {
            if (n & 1) r *= base;
            base *= base;
            n >>= 1;
        }
        return neg ? 1.0 / r : r;
    }
    if (x == 0.0) return y > 0.0 ? 0.0 : inf_d();
    if (x < 0.0) {
        if (!y_whole) return nan_d();
        const bool odd = (((long long)y) & 1) != 0;
        const double m = exp_d(y * log_d(-x));
        return odd ? -m : m;
    }
    return exp_d(y * log_d(x));
}
}  // namespace okay_math

inline float sqrt(float x) { return (float)okay_math::sqrt_d((double)x); }
inline float sin(float x) { return (float)okay_math::sin_cos_d((double)x, true); }
inline float cos(float x) { return (float)okay_math::sin_cos_d((double)x, false); }
inline float tan(float x) { return (float)(okay_math::sin_cos_d((double)x, true) / okay_math::sin_cos_d((double)x, false)); }
inline float atan(float x) { return (float)okay_math::atan_d((double)x); }
inline float atan2(float y, float x) {
    const double pi = 3.141592653589793;
    const double yd = (double)y, xd = (double)x;
    if (okay_math::isnan_d(yd) || okay_math::isnan_d(xd)) return (float)okay_math::nan_d();
    if (xd > 0.0) return (float)okay_math::atan_d(yd / xd);
    if (xd < 0.0) return (float)(yd >= 0.0 ? okay_math::atan_d(yd / xd) + pi : okay_math::atan_d(yd / xd) - pi);
    if (yd > 0.0) return (float)(pi / 2.0);
    if (yd < 0.0) return (float)(-pi / 2.0);
    return 0.0f;
}
inline float asin(float x) {
    const double xd = (double)x;
    if (xd > 1.0 || xd < -1.0) return (float)okay_math::nan_d();
    if (xd == 1.0) return (float)1.5707963267948966;
    if (xd == -1.0) return (float)-1.5707963267948966;
    return (float)okay_math::atan_d(xd / okay_math::sqrt_d(1.0 - xd * xd));
}
inline float acos(float x) { return (float)(1.5707963267948966 - (double)asin(x)); }
inline float fabs(float x) { return x < 0.0f ? -x : (x == 0.0f ? 0.0f : x); }
inline float floor(float x) { return (float)okay_math::floor_d((double)x); }
inline float ceil(float x) { return (float)(-okay_math::floor_d(-(double)x)); }
inline float trunc(float x) { return (float)okay_math::trunc_d((double)x); }
// round: halves go away from zero ([c.math] round).
inline float round(float x) {
    const double xd = (double)x;
    return (float)(xd < 0.0 ? -okay_math::floor_d(-xd + 0.5) : okay_math::floor_d(xd + 0.5));
}
inline float pow(float x, float y) { return (float)okay_math::pow_d((double)x, (double)y); }
inline float fmod(float x, float y) {
    const double xd = (double)x, yd = (double)y;
    if (yd == 0.0 || okay_math::isnan_d(xd) || okay_math::isnan_d(yd)) return (float)okay_math::nan_d();
    return (float)(xd - okay_math::trunc_d(xd / yd) * yd);
}
inline float exp(float x) { return (float)okay_math::exp_d((double)x); }
inline float log(float x) { return (float)okay_math::log_d((double)x); }
inline float log2(float x) { return (float)(okay_math::log_d((double)x) / 0.6931471805599453); }
inline float log10(float x) { return (float)(okay_math::log_d((double)x) / 2.302585092994046); }
inline float hypot(float x, float y) { return (float)okay_math::sqrt_d((double)x * (double)x + (double)y * (double)y); }
// [c.math.fpclass], written from the IEEE-754 binary32 definition. A NaN compares false with everything, so the range
// test is false for it.
inline bool isnan(float x) { return x != x; }
inline bool isfinite(float x) { return x <= 3.40282347e+38f && x >= -3.40282347e+38f; }
inline bool isinf(float x) { return x > 3.40282347e+38f || x < -3.40282347e+38f; }

// The double overloads (the float ones above round the result of these).
inline double sqrt(double x) { return okay_math::sqrt_d(x); }
inline double sin(double x) { return okay_math::sin_cos_d(x, true); }
inline double cos(double x) { return okay_math::sin_cos_d(x, false); }
inline double tan(double x) { return okay_math::sin_cos_d(x, true) / okay_math::sin_cos_d(x, false); }
inline double atan(double x) { return okay_math::atan_d(x); }
inline double atan2(double yd, double xd) {
    const double pi = 3.141592653589793;
    if (okay_math::isnan_d(yd) || okay_math::isnan_d(xd)) return okay_math::nan_d();
    if (xd > 0.0) return okay_math::atan_d(yd / xd);
    if (xd < 0.0) return yd >= 0.0 ? okay_math::atan_d(yd / xd) + pi : okay_math::atan_d(yd / xd) - pi;
    if (yd > 0.0) return pi / 2.0;
    if (yd < 0.0) return -pi / 2.0;
    return 0.0;
}
inline double asin(double xd) {
    if (xd > 1.0 || xd < -1.0) return okay_math::nan_d();
    if (xd == 1.0) return 1.5707963267948966;
    if (xd == -1.0) return -1.5707963267948966;
    return okay_math::atan_d(xd / okay_math::sqrt_d(1.0 - xd * xd));
}
inline double acos(double x) { return 1.5707963267948966 - asin(x); }
inline double fabs(double x) { return x < 0.0 ? -x : (x == 0.0 ? 0.0 : x); }
inline double floor(double x) { return okay_math::floor_d(x); }
inline double ceil(double x) { return -okay_math::floor_d(-x); }
inline double trunc(double x) { return okay_math::trunc_d(x); }
inline double round(double xd) { return xd < 0.0 ? -okay_math::floor_d(-xd + 0.5) : okay_math::floor_d(xd + 0.5); }
inline double pow(double x, double y) { return okay_math::pow_d(x, y); }
inline double fmod(double xd, double yd) {
    if (yd == 0.0 || okay_math::isnan_d(xd) || okay_math::isnan_d(yd)) return okay_math::nan_d();
    return xd - okay_math::trunc_d(xd / yd) * yd;
}
inline double exp(double x) { return okay_math::exp_d(x); }
inline double log(double x) { return okay_math::log_d(x); }
inline double log2(double x) { return okay_math::log_d(x) / 0.6931471805599453; }
inline double log10(double x) { return okay_math::log_d(x) / 2.302585092994046; }
inline double hypot(double x, double y) { return okay_math::sqrt_d(x * x + y * y); }
inline bool isnan(double x) { return x != x; }
inline bool isfinite(double x) { return x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308; }
inline bool isinf(double x) { return x > 1.7976931348623157e308 || x < -1.7976931348623157e308; }

// fmin and fmax (9899 7.12.12): a NaN argument gives the other one.
inline float fmin(float a, float b) { return a != a ? b : (b != b ? a : (b < a ? b : a)); }
inline float fmax(float a, float b) { return a != a ? b : (b != b ? a : (a < b ? b : a)); }
inline double fmin(double a, double b) { return a != a ? b : (b != b ? a : (b < a ? b : a)); }
inline double fmax(double a, double b) { return a != a ? b : (b != b ? a : (a < b ? b : a)); }

// nextafter (9899 7.12.11.3), from the IEEE-754 layout: one step in the bit pattern of the magnitude toward y.
union FloatBits32 { float f; unsigned int u; };
inline float nextafter(float x, float y) {
    if (x != x || y != y) return x != x ? x : y;
    if (x == y) return y;
    FloatBits32 b;
    if (x == 0.0f) {
        b.u = 1u;
        return y > 0.0f ? b.f : -b.f;
    }
    b.f = x;
    if ((x < y) == (x > 0.0f)) ++b.u; else --b.u;
    return b.f;
}
inline double nextafter(double x, double y) {
    if (x != x || y != y) return x != x ? x : y;
    if (x == y) return y;
    okay_math::Bits64 b;
    if (x == 0.0) {
        b.u = 1ull;
        return y > 0.0 ? b.d : -b.d;
    }
    b.d = x;
    if ((x < y) == (x > 0.0)) ++b.u; else --b.u;
    return b.d;
}

// log1p: log(1 + x) without losing the small bits of x (u = 1 + x rounds; log(u) * x / (u - 1) cancels the rounding).
inline double log1p(double x) {
    const double u = 1.0 + x;
    if (u == 1.0) return x;
    return okay_math::log_d(u) * x / (u - 1.0);
}
inline float log1p(float x) { return (float)log1p((double)x); }

// lgamma: for x >= 12 the Stirling series (x - 1/2) ln x - x + ln(2 pi)/2 + 1/(12x) - 1/(360 x^3) + 1/(1260 x^5) - 1/(1680 x^7)
// (coefficients B(2k) / (2k (2k - 1)), B the Bernoulli numbers); a smaller x is moved up with gamma(x + 1) = x gamma(x); a
// negative x uses the reflection gamma(x) gamma(1 - x) = pi / sin(pi x).
inline double lgamma_pos(double x) {
    double shift = 0.0;
    double prod = 1.0;
    while (x < 12.0) {
        prod *= x;
        if (prod > 1e250) {
            shift += okay_math::log_d(prod);
            prod = 1.0;
        }
        x += 1.0;
    }
    shift += okay_math::log_d(prod);
    const double inv = 1.0 / x;
    const double inv2 = inv * inv;
    const double series = inv * (1.0 / 12.0 - inv2 * (1.0 / 360.0 - inv2 * (1.0 / 1260.0 - inv2 * (1.0 / 1680.0))));
    return (x - 0.5) * okay_math::log_d(x) - x + 0.9189385332046727 + series - shift;
}
inline double lgamma(double x) {
    const double pi = 3.141592653589793;
    if (x != x) return x;
    if (x <= 0.0) {
        if (x == okay_math::floor_d(x)) return okay_math::inf_d();
        const double s = okay_math::sin_cos_d(pi * x, true);
        return okay_math::log_d(pi / (s < 0.0 ? -s : s)) - lgamma_pos(1.0 - x);
    }
    return lgamma_pos(x);
}
inline float lgamma(float x) { return (float)lgamma((double)x); }

// lround and llround (9899 7.12.9.7): the nearest integer, halves away from zero (the value is converted as the C types do).
inline long lround(double x) { return (long)round(x); }
inline long lround(float x) { return (long)round((double)x); }
inline long long llround(double x) { return (long long)round(x); }
inline long long llround(float x) { return (long long)round((double)x); }

// abs for floating types, and cbrt (the real cube root: exp(log|x| / 3) then one Newton step x - (x^3 - a) / (3 x^2)).
inline double abs(double x) { return x < 0.0 ? -x : (x == 0.0 ? 0.0 : x); }
inline float abs(float x) { return x < 0.0f ? -x : (x == 0.0f ? 0.0f : x); }
inline double cbrt(double a) {
    if (a == 0.0 || a != a) return a;
    const bool neg = a < 0.0;
    const double m = neg ? -a : a;
    double x = okay_math::exp_d(okay_math::log_d(m) / 3.0);
    x = x - (x * x * x - m) / (3.0 * x * x);
    return neg ? -x : x;
}
inline float cbrt(float a) { return (float)cbrt((double)a); }
}
