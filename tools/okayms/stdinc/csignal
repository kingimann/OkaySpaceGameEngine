// okay-ms own standard header: <csignal>, written from ISO/IEC 14882 [csignal.syn] and ISO/IEC 9899 7.14, with the
// signal numbers Microsoft documents for its C runtime (SIGINT 2, SIGILL 4, SIGFPE 8, SIGSEGV 11, SIGTERM 15,
// SIGBREAK 21, SIGABRT 22). signal and raise are declared only, with the C names a Windows C runtime DLL exports
// (msvcrt.dll has both); okay-ms's own runtime does not define them, so a program that calls one links only against a
// library that does. SIG_DFL, SIG_IGN and SIG_ERR are the handler values 0, 1 and -1 of that runtime.
#pragma once
namespace std {
typedef int sig_atomic_t;
extern "C" {
typedef void (*__sighandler_t)(int);
__sighandler_t signal(int sig, __sighandler_t handler);
int raise(int sig);
}
}
#define SIGINT 2
#define SIGILL 4
#define SIGFPE 8
#define SIGSEGV 11
#define SIGTERM 15
#define SIGBREAK 21
#define SIGABRT 22
#define SIG_DFL ((std::__sighandler_t)0)
#define SIG_IGN ((std::__sighandler_t)1)
#define SIG_ERR ((std::__sighandler_t)-1)
// POSIX.1-2017 <signal.h> beyond ISO C (Round 30): kill, signal sets and the signals POSIX adds, for the engine's POSIX
// paths (the plain survey). Declared at global scope, and only when _WIN32 is not defined: the Microsoft runtime has
// none of them. SIGKILL is 9 as POSIX's kill utility documents; the other numbers and the sigset_t layout are our own
// choice (nothing that calls these links on Windows).
#if !defined(_WIN32)
#include <sys/types.h>
#define SIGHUP 1
#define SIGQUIT 3
#define SIGKILL 9
#define SIGUSR1 10
#define SIGUSR2 12
#define SIGPIPE 13
#define SIGALRM 14
#define SIGCHLD 17
#define SIG_BLOCK 0
#define SIG_UNBLOCK 1
#define SIG_SETMASK 2
typedef struct {
    unsigned long long __okay_bits[2];
} sigset_t;
extern "C" {
int kill(pid_t pid, int sig);
int sigemptyset(sigset_t* set);
int sigfillset(sigset_t* set);
int sigaddset(sigset_t* set, int sig);
int sigdelset(sigset_t* set, int sig);
int sigprocmask(int how, const sigset_t* set, sigset_t* old);
}
#endif
