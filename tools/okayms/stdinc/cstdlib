// okay-ms own standard header (ISO/IEC 14882 [cstdlib.syn]). malloc, calloc and free are declared at global scope only:
// okay-ms lowers `new` and `delete` to calls of the global functions of those names, and <vector> and <string> use
// them for their storage; they are the C runtime's (tools/okayms/runtime/mem.c, on HeapAlloc). The functions
// declared in std are extern "C" so they link with the runtime's plain names.
#pragma once
void *malloc(unsigned long long n);
void *calloc(unsigned long long count, unsigned long long size);
void free(void *p);
namespace std {
inline int abs(int v) { return v < 0 ? -v : v; }
extern "C" {
int atoi(const char *s);
long strtol(const char *s, char **end, int base);
unsigned long strtoul(const char *s, char **end, int base);
float strtof(const char *s, char **end);
double strtod(const char *s, char **end);
double atof(const char *s);
}
// getenv ([cstdlib.syn], 9899 7.22.4.6): provided by the runtime (runtime/env.c, on kernel32 GetEnvironmentVariableA), so a
// program that never calls it needs no import. The value is in a buffer the runtime owns (the next call overwrites it);
// a null pointer when the name is not set.
extern "C" char *getenv(const char *name);
}
