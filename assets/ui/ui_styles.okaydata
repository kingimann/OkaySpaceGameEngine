# UI styles. Axes (shape, fill, border, effect, size, density, hover, press, disabled, focus) are the choices; a [style] is a named
# combination of them. engine/include/okay/Scene/UIStyleLib.hpp applies a style to a widget; tests/test_ui_styles.cpp checks the data.
# Honest note: stripes, noise and image fills are not drawn by the UI renderer yet, so they are not offered.
 
[shape square]
shape = Rectangle
radius = 0

[shape soft-square]
shape = Rounded
radius = 4

[shape rounded]
shape = Rounded
radius = 8

[shape round-large]
shape = Rounded
radius = 16

[shape pill]
shape = Pill
radius = 0

[shape squircle]
shape = Squircle
radius = 0

[shape chamfered]
shape = Octagon
radius = 8

[shape bevelled]
shape = Octagon
radius = 4

[shape notched]
shape = Octagon
radius = 12

[shape slanted]
shape = Parallelogram
radius = 10

[shape tab]
shape = TabTop
radius = 10

[shape hexagon]
shape = Hexagon
radius = 0

[shape trapezoid]
shape = Trapezoid
radius = 10

[shape circle]
shape = Circle
radius = 0

[fill solid]
mode = solid
gradient = 0
alpha = 1

[fill gradient]
mode = gradient
gradient = 0.35
alpha = 1

[fill gradient-soft]
mode = gradient
gradient = 0.15
alpha = 1

[fill gradient-sideways]
mode = gradienth
gradient = 0.35
alpha = 1

[fill glass]
mode = glass
gradient = 0
alpha = 0.38

[fill ghost]
mode = ghost
gradient = 0
alpha = 0

[fill tint]
mode = tint
gradient = 0
alpha = 0.2

[fill inset]
mode = inset
gradient = 0
alpha = 1

[fill gloss]
mode = gloss
gradient = 0.3
alpha = 1

[fill dark]
mode = dark
gradient = 0
alpha = 1

[fill light]
mode = light
gradient = 0
alpha = 1

[fill duotone]
mode = gradient
gradient = 0.6
alpha = 1

[border none]
width = 0
alpha = 0
outer = 0

[border hairline]
width = 1
alpha = 0.28
outer = 0

[border thin]
width = 1.5
alpha = 1
outer = 0

[border medium]
width = 2.5
alpha = 1
outer = 0

[border thick]
width = 4
alpha = 1
outer = 0

[border double]
width = 2
alpha = 1
outer = 2

[border glow]
width = 1.5
alpha = 1
outer = 6

[border accent-line]
width = 2
alpha = 1
outer = 0

[border dark-line]
width = 2
alpha = 1
outer = 0

[effect none]
shadow = 0
soft = 0
dx = 0
dy = 0
glow = 0
highlight = 0
hover_scale = 1

[effect soft-shadow]
shadow = 1
soft = 14
dx = 0
dy = 6
glow = 0
highlight = 0
hover_scale = 1

[effect hard-shadow]
shadow = 1
soft = 0
dx = 4
dy = 4
glow = 0
highlight = 0
hover_scale = 1

[effect long-shadow]
shadow = 1
soft = 2
dx = 8
dy = 8
glow = 0
highlight = 0
hover_scale = 1

[effect glow]
shadow = 1
soft = 16
dx = 0
dy = 0
glow = 1
highlight = 0
hover_scale = 1

[effect neon]
shadow = 1
soft = 22
dx = 0
dy = 0
glow = 1
highlight = 0
hover_scale = 1

[effect emboss]
shadow = 1
soft = 6
dx = 0
dy = 2
glow = 0
highlight = 1
hover_scale = 1

[effect lift]
shadow = 1
soft = 22
dx = 0
dy = 10
glow = 0
highlight = 1
hover_scale = 1.03

[effect flat]
shadow = 0
soft = 0
dx = 0
dy = 0
glow = 0
highlight = 0
hover_scale = 1

[size xs]
height = 22
font = 1.5
radius_scale = 0.7

[size s]
height = 28
font = 1.75
radius_scale = 0.85

[size m]
height = 36
font = 2
radius_scale = 1

[size l]
height = 46
font = 2.5
radius_scale = 1.15

[size xl]
height = 58
font = 3
radius_scale = 1.3

[density compact]
padding = 4
spacing = 2

[density cosy]
padding = 8
spacing = 4

[density comfortable]
padding = 12
spacing = 8

[density spacious]
padding = 20
spacing = 14

[hover lighten]
lighten = 0.18
scale = 1

[hover darken]
lighten = -0.14
scale = 1

[hover glow]
lighten = 0.08
scale = 1

[hover grow]
lighten = 0.06
scale = 1.06

[hover tint]
lighten = 0.1
scale = 1

[press darken]
darken = 0.22
offset = 1
scale = 1

[press inset]
darken = 0.3
offset = 2
scale = 1

[press shrink]
darken = 0.12
offset = 1
scale = 0.96

[press none]
darken = 0
offset = 0
scale = 1

[disabled fade]
alpha = 0.4
grey = 0

[disabled grey]
alpha = 0.9
grey = 1

[disabled outline]
alpha = 0.55
grey = 0

[disabled dim]
alpha = 0.65
grey = 0

[focus ring]
width = 2
glow = 0

[focus glow]
width = 1
glow = 1

[focus thick-ring]
width = 4
glow = 0

[focus soft-ring]
width = 2
glow = 1

[style Flat]
family = Flat
shape = soft-square
fill = solid
border = none
effect = none
role = accent
hover = lighten
press = darken
disabled = fade
focus = ring
