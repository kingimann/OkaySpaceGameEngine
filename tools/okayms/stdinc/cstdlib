// okay-ms own standard header (ISO/IEC 14882 [cstdlib.syn]). malloc, calloc and free are declared at global scope only:
// okay-ms lowers `new` and `delete` to calls of the global functions of those names, and <vector> and <string> use
// them for their storage; they are the C runtime's (tools/okayms/runtime/mem.c, on HeapAlloc). The functions
// declared in std are extern "C" so they link with the runtime's plain names.
#pragma once
void *malloc(unsigned long long n);
void *calloc(unsigned long long count, unsigned long long size);
void free(void *p);
namespace std {
inline int abs(int v) { return v < 0 ? -v : v; }
extern "C" {
// std::malloc, std::calloc and std::free ([cstdlib.syn]; Round 33, JsRuntime.cpp's std::calloc): the same C runtime
// functions as the global ones above (extern "C": one plain name for both).
void *malloc(unsigned long long n);
void *calloc(unsigned long long count, unsigned long long size);
void free(void *p);
int atoi(const char *s);
long strtol(const char *s, char **end, int base);
unsigned long strtoul(const char *s, char **end, int base);
float strtof(const char *s, char **end);
double strtod(const char *s, char **end);
double atof(const char *s);
long atol(const char *s);
long long atoll(const char *s);
long long strtoll(const char *s, char **end, int base);
unsigned long long strtoull(const char *s, char **end, int base);
// Process and environment ([cstdlib.syn], ISO/IEC 9899 7.22.4): from the C runtime DLL (msvcrt.dll), like the
// string-to-number functions above. getenv returns null when the variable is not set.
char *getenv(const char *name);
void abort(void);
void exit(int status);
void _Exit(int status);
int atexit(void (*fn)(void));
int system(const char *command);
int rand(void);
void srand(unsigned seed);
}
inline long labs(long v) { return v < 0 ? -v : v; }
inline long long llabs(long long v) { return v < 0 ? -v : v; }
}
#define EXIT_SUCCESS 0
#define EXIT_FAILURE 1
#define RAND_MAX 0x7fff
// POSIX.1-2017 setenv and unsetenv (Round 30), at global scope for the engine's POSIX paths (the plain survey). Declared
// only when _WIN32 is not defined: the Microsoft runtime names them _putenv_s, so nothing that calls these links there.
#if !defined(_WIN32)
extern "C" {
int setenv(const char *name, const char *value, int overwrite);
int unsetenv(const char *name);
}
#endif
