// <functional> for okay-cc (ISO/IEC 14882 [comparisons]). Our own header: the comparison objects.
#pragma once
namespace std {
template <typename T>
struct less {
    bool operator()(const T &a, const T &b) const { return a < b; }
};
template <typename T>
struct greater {
    bool operator()(const T &a, const T &b) const { return b < a; }
};
}  // namespace std
