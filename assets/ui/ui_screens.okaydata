# ------------------------------------------------------------------ Inventory & Items
[screen inventory_grid]
name = Inventory Grid
section = items
desc = A bag of 24 slots with a stats panel, weight bar and Use and Drop buttons.
tags = bag, items, slots, backpack, weight
variants = Centered|Dimmed backdrop
replaces = UIGallery::AddInventoryScreen (kept as "Inventory (bag)")
group Inventory Grid
  dim Dim v=1 a=0.45
  panel Card card=1 anchor=center size=700,500 lift=1 cr=16
    text Title "Inventory" pos=24,16 size=300,36 px=28 bold=1
    badge Weight "32 / 80 kg" anchor=topright pos=-24,22
    rep n=24 cols=6 dx=68 dy=68
      panel Slot pos=24,70 size=62,62 fill=card cr=8 border=1
        icon Item "bag" pos=15,15 size=32,32 color=dim
    panel Info pos=444,70 size=232,298 fill=card cr=12
      caption Cap "SELECTED" pos=14,12 size=200,16
      text Name "Iron sword" pos=14,34 size=204,26 px=20 bold=1
      text Desc "A plain blade. Reliable, never fancy." pos=14,66 size=204,80 px=14 color=dim wrap=1
      text Stats "Damage 12" pos=14,160 size=204,22 px=15
    bar Load pos=24,386 size=396,10 value=0.4 fill=success
    button Use "Use" pos=444,386 size=110,40 act=""
    button Drop "Drop" pos=566,386 size=110,40 btn=secondary
    button Close "Close" pos=24,440 size=652,40 btn=ghost act="hide:inventory_grid"

