// okay-ms own standard header: std::vector, written from ISO/IEC 14882 [vector] (a contiguous sequence that grows
// by doubling). Own minimal version: no allocator argument, no exceptions (an allocation failure is not checked),
// iterators are pointers, initializer_list and move construction are supported, no emplace. Storage comes from the global malloc and free
// (see <cstdlib>); elements are made with placement new and destroyed with an explicit destructor call.
#pragma once
#include <cstddef>
#include <cstdlib>
#include <initializer_list>
#include <new>
#include <utility>
namespace std {
template <typename T>
class vector {
    T* data_;
    size_t size_;
    size_t cap_;

    void grow_to(size_t want) {
        if (want <= cap_) return;
        size_t cap = cap_ == 0 ? 4 : cap_;
        while (cap < want) cap = cap * 2;
        T* fresh = (T*)malloc(cap * sizeof(T));
        for (size_t i = 0; i < size_; ++i) {
            new (fresh + i) T(std::move(data_[i]));
            data_[i].~T();
        }
        if (data_) free(data_);
        data_ = fresh;
        cap_ = cap;
    }

public:
    typedef T value_type;
    typedef size_t size_type;
    typedef T* iterator;
    typedef const T* const_iterator;

    vector() : data_(0), size_(0), cap_(0) {}
    explicit vector(size_t n) : data_(0), size_(0), cap_(0) { resize(n); }
    vector(size_t n, const T& value) : data_(0), size_(0), cap_(0) { resize(n, value); }
    vector(const vector& other) : data_(0), size_(0), cap_(0) {
        grow_to(other.size_);
        for (size_t i = 0; i < other.size_; ++i) new (data_ + i) T(other.data_[i]);
        size_ = other.size_;
    }
    vector(vector&& other) : data_(other.data_), size_(other.size_), cap_(other.cap_) {
        other.data_ = 0;
        other.size_ = 0;
        other.cap_ = 0;
    }
    vector(initializer_list<T> list) : data_(0), size_(0), cap_(0) {
        grow_to(list.size());
        for (size_t i = 0; i < list.size(); ++i) new (data_ + i) T(list.begin()[i]);
        size_ = list.size();
    }
    ~vector() {
        clear();
        if (data_) free(data_);
    }
    vector& operator=(const vector& other) {
        if (this == &other) return *this;
        clear();
        grow_to(other.size_);
        for (size_t i = 0; i < other.size_; ++i) new (data_ + i) T(other.data_[i]);
        size_ = other.size_;
        return *this;
    }
    vector& operator=(vector&& other) {
        if (this == &other) return *this;
        clear();
        if (data_) free(data_);
        data_ = other.data_;
        size_ = other.size_;
        cap_ = other.cap_;
        other.data_ = 0;
        other.size_ = 0;
        other.cap_ = 0;
        return *this;
    }
    vector& operator=(initializer_list<T> list) {
        clear();
        grow_to(list.size());
        for (size_t i = 0; i < list.size(); ++i) new (data_ + i) T(list.begin()[i]);
        size_ = list.size();
        return *this;
    }

    bool operator==(const vector& o) const {
        if (size_ != o.size_) return false;
        for (size_t i = 0; i < size_; ++i)
            if (!(data_[i] == o.data_[i])) return false;
        return true;
    }
    bool operator!=(const vector& o) const { return !(*this == o); }
    size_t size() const { return size_; }
    size_t capacity() const { return cap_; }
    bool empty() const { return size_ == 0; }
    T& operator[](size_t i) { return data_[i]; }
    const T& operator[](size_t i) const { return data_[i]; }
    T& at(size_t i) { return data_[i]; }
    const T& at(size_t i) const { return data_[i]; }
    T& front() { return data_[0]; }
    const T& front() const { return data_[0]; }
    T& back() { return data_[size_ - 1]; }
    const T& back() const { return data_[size_ - 1]; }
    T* data() { return data_; }
    const T* data() const { return data_; }
    T* begin() { return data_; }
    const T* begin() const { return data_; }
    T* end() { return data_ + size_; }
    const T* end() const { return data_ + size_; }

    void reserve(size_t n) { grow_to(n); }
    void push_back(const T& value) {
        if (size_ == cap_) {
            // `value` may live inside this vector: copy it before the storage moves.
            T copy(value);
            grow_to(size_ + 1);
            new (data_ + size_) T(copy);
        } else {
            new (data_ + size_) T(value);
        }
        ++size_;
    }
    void push_back(T&& value) {
        if (size_ == cap_) {
            T moved(std::move(value));
            grow_to(size_ + 1);
            new (data_ + size_) T(std::move(moved));
        } else {
            new (data_ + size_) T(std::move(value));
        }
        ++size_;
    }
    void pop_back() {
        --size_;
        data_[size_].~T();
    }
    void clear() {
        for (size_t i = size_; i > 0; --i) data_[i - 1].~T();
        size_ = 0;
    }
    void resize(size_t n, const T& value) {
        if (n < size_) {
            while (size_ > n) pop_back();
            return;
        }
        T copy(value);
        grow_to(n);
        while (size_ < n) {
            new (data_ + size_) T(copy);
            ++size_;
        }
    }
    void resize(size_t n) {
        T zero = T();
        resize(n, zero);
    }
    void assign(size_t n, const T& value) {
        clear();
        resize(n, value);
    }
    T* insert(T* pos, const T& value) {
        const size_t at = (size_t)(pos - data_);
        T copy(value);
        grow_to(size_ + 1);
        if (at == size_) {
            new (data_ + size_) T(copy);
        } else {
            new (data_ + size_) T(data_[size_ - 1]);
            for (size_t i = size_ - 1; i > at; --i) data_[i] = data_[i - 1];
            data_[at] = copy;
        }
        ++size_;
        return data_ + at;
    }
    T* insert(T* pos, const T* first, const T* last) {
        // [first, last) must not point into this vector (the standard says the same).
        const size_t at = (size_t)(pos - data_);
        const size_t n = (size_t)(last - first);
        grow_to(size_ + n);
        pos = data_ + at;
        for (size_t k = 0; k < n; ++k) new (data_ + size_ + k) T(first[k]);
        for (size_t i = size_; i > at; --i) data_[i - 1 + n] = data_[i - 1];
        for (size_t k = 0; k < n; ++k) data_[at + k] = first[k];
        size_ += n;
        return data_ + at;
    }
    T* erase(T* pos) {
        const size_t at = (size_t)(pos - data_);
        for (size_t i = at; i + 1 < size_; ++i) data_[i] = std::move(data_[i + 1]);
        pop_back();
        return data_ + at;
    }
    T* erase(T* first, T* last) {
        const size_t a = (size_t)(first - data_);
        const size_t n = (size_t)(last - first);
        for (size_t i = a; i + n < size_; ++i) data_[i] = std::move(data_[i + n]);
        for (size_t k = 0; k < n; ++k) pop_back();
        return data_ + a;
    }
    void swap(vector& other) {
        T* d = data_; data_ = other.data_; other.data_ = d;
        size_t s = size_; size_ = other.size_; other.size_ = s;
        size_t c = cap_; cap_ = other.cap_; other.cap_ = c;
    }
};
}
