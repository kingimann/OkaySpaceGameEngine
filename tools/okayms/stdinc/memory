// okay-ms own standard header: std::unique_ptr and std::make_unique, written from ISO/IEC 14882 [unique.ptr]. Own
// minimal version: one owner, deleted with `delete` (no custom deleter, no array form), moved with std::move, not
// copyable. std::shared_ptr and std::weak_ptr ([util.smartptr.shared], [util.smartptr.weak]) are here too with the SINGLE-THREAD
// subset of the standard's guarantee: the counts are plain integers (okay-ms has no locked instructions yet), so one
// shared_ptr family must not be touched by two threads. The control block is a separate allocation (make_shared makes two);
// no custom deleter, no aliasing constructor, no enable_shared_from_this, no pointer casts.
#pragma once
#include <cstddef>
#include <cstdlib>
#include <new>
#include <utility>
namespace std {
template <typename T>
class unique_ptr {
    T* p_;

public:
    typedef T element_type;
    unique_ptr() : p_(0) {}
    unique_ptr(T* p) : p_(p) {}
    unique_ptr(unique_ptr&& other) : p_(other.p_) { other.p_ = 0; }
    ~unique_ptr() {
        if (p_) delete p_;
    }
    unique_ptr& operator=(unique_ptr&& other) {
        if (this != &other) {
            T* old = p_;
            p_ = other.p_;
            other.p_ = 0;
            if (old) delete old;
        }
        return *this;
    }
    T* get() const { return p_; }
    T& operator*() const { return *p_; }
    T* operator->() const { return p_; }
    T* release() {
        T* p = p_;
        p_ = 0;
        return p;
    }
    void reset() {
        T* old = p_;
        p_ = 0;
        if (old) delete old;
    }
    void reset(T* p) {
        T* old = p_;
        p_ = p;
        if (old) delete old;
    }
    bool operator!() const { return p_ == 0; }
    explicit operator bool() const { return p_ != 0; }
};
template <typename T> unique_ptr<T> make_unique() { return unique_ptr<T>(new T()); }
template <typename T, typename A> unique_ptr<T> make_unique(const A& a) { return unique_ptr<T>(new T(a)); }
template <typename T, typename A, typename B> unique_ptr<T> make_unique(const A& a, const B& b) { return unique_ptr<T>(new T(a, b)); }

struct sp_ctrl_base {
    int strong;
    int weak;
    sp_ctrl_base() : strong(1), weak(0) {}
    virtual void dispose() = 0;
    virtual ~sp_ctrl_base() {}
    static void release_strong(sp_ctrl_base* c) {
        if (c == 0) return;
        if (--c->strong == 0) {
            c->dispose();
            if (c->weak == 0) delete c;
        }
    }
    static void release_weak(sp_ctrl_base* c) {
        if (c == 0) return;
        if (--c->weak == 0 && c->strong == 0) delete c;
    }
};
template <typename T> struct sp_ctrl : sp_ctrl_base {
    T* p;
    sp_ctrl(T* x) : p(x) {}
    void dispose() override {
        T* old = p;
        p = 0;
        if (old) delete old;
    }
};
template <typename T> class weak_ptr;
template <typename T>
class shared_ptr {
public:
    T* p_;
    sp_ctrl_base* c_;
    typedef T element_type;
    shared_ptr() : p_(0), c_(0) {}
    shared_ptr(T* p) : p_(p), c_(0) {
        if (p) c_ = new sp_ctrl<T>(p);
    }
    shared_ptr(const shared_ptr& o) : p_(o.p_), c_(o.c_) {
        if (c_) ++c_->strong;
    }
    shared_ptr(shared_ptr&& o) : p_(o.p_), c_(o.c_) {
        o.p_ = 0;
        o.c_ = 0;
    }
    template <typename U> shared_ptr(const shared_ptr<U>& o) : p_(o.p_), c_(o.c_) {
        if (c_) ++c_->strong;
    }
    ~shared_ptr() { sp_ctrl_base::release_strong(c_); }
    shared_ptr& operator=(const shared_ptr& o) {
        if (this != &o) {
            if (o.c_) ++o.c_->strong;
            sp_ctrl_base* old = c_;
            p_ = o.p_;
            c_ = o.c_;
            sp_ctrl_base::release_strong(old);
        }
        return *this;
    }
    shared_ptr& operator=(shared_ptr&& o) {
        if (this != &o) {
            sp_ctrl_base* old = c_;
            p_ = o.p_;
            c_ = o.c_;
            o.p_ = 0;
            o.c_ = 0;
            sp_ctrl_base::release_strong(old);
        }
        return *this;
    }
    T* get() const { return p_; }
    T& operator*() const { return *p_; }
    T* operator->() const { return p_; }
    int use_count() const { return c_ ? c_->strong : 0; }
    bool unique() const { return use_count() == 1; }
    void reset() {
        sp_ctrl_base* old = c_;
        p_ = 0;
        c_ = 0;
        sp_ctrl_base::release_strong(old);
    }
    void swap(shared_ptr& o) {
        T* tp = p_;
        sp_ctrl_base* tc = c_;
        p_ = o.p_;
        c_ = o.c_;
        o.p_ = tp;
        o.c_ = tc;
    }
    bool operator!() const { return p_ == 0; }
    explicit operator bool() const { return p_ != 0; }
};
template <typename T>
class weak_ptr {
public:
    T* p_;
    sp_ctrl_base* c_;
    weak_ptr() : p_(0), c_(0) {}
    weak_ptr(const weak_ptr& o) : p_(o.p_), c_(o.c_) {
        if (c_) ++c_->weak;
    }
    weak_ptr(const shared_ptr<T>& s) : p_(s.p_), c_(s.c_) {
        if (c_) ++c_->weak;
    }
    ~weak_ptr() { sp_ctrl_base::release_weak(c_); }
    weak_ptr& operator=(const weak_ptr& o) {
        if (this != &o) {
            if (o.c_) ++o.c_->weak;
            sp_ctrl_base* old = c_;
            p_ = o.p_;
            c_ = o.c_;
            sp_ctrl_base::release_weak(old);
        }
        return *this;
    }
    int use_count() const { return c_ ? c_->strong : 0; }
    bool expired() const { return use_count() == 0; }
    shared_ptr<T> lock() const {
        shared_ptr<T> r;
        if (c_ && c_->strong > 0) {
            r.p_ = p_;
            r.c_ = c_;
            ++c_->strong;
        }
        return r;
    }
    void reset() {
        sp_ctrl_base* old = c_;
        p_ = 0;
        c_ = 0;
        sp_ctrl_base::release_weak(old);
    }
};
template <typename T> bool operator==(const shared_ptr<T>& a, const shared_ptr<T>& b) { return a.p_ == b.p_; }
template <typename T> bool operator!=(const shared_ptr<T>& a, const shared_ptr<T>& b) { return a.p_ != b.p_; }
template <typename T> shared_ptr<T> make_shared() { return shared_ptr<T>(new T()); }
template <typename T, typename A> shared_ptr<T> make_shared(const A& a) { return shared_ptr<T>(new T(a)); }
template <typename T, typename A, typename B> shared_ptr<T> make_shared(const A& a, const B& b) { return shared_ptr<T>(new T(a, b)); }
template <typename T, typename A, typename B, typename C> shared_ptr<T> make_shared(const A& a, const B& b, const C& c) { return shared_ptr<T>(new T(a, b, c)); }
}
