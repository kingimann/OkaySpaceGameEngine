// The file channel: a C FILE from lib/stdio.c (writes are not buffered there, reads are).
class filebuf : public streambuf {
public:
    FILE *__f;
    bool __own;
    filebuf() : __f(nullptr), __own(false) {}
    explicit filebuf(FILE *f) : __f(f), __own(false) {}
    ~filebuf() { close(); }
    bool is_open() const { return __f != nullptr; }
    filebuf *open(const char *path, unsigned int m) {
        if (__f) return nullptr;
        // [filebuf.members] table: the C mode for each openmode (binary changes nothing here).
        unsigned int k = m & ~(ios_base::binary | ios_base::ate);
        const char *mode = nullptr;
        if (k == ios_base::out || k == (ios_base::out | ios_base::trunc)) mode = "w";
        else if (k == ios_base::app || k == (ios_base::out | ios_base::app)) mode = "a";
        else if (k == ios_base::in) mode = "r";
        else if (k == (ios_base::in | ios_base::out)) mode = "r+";
        else if (k == (ios_base::in | ios_base::out | ios_base::trunc)) mode = "w+";
        else if (k == (ios_base::in | ios_base::app) || k == (ios_base::in | ios_base::out | ios_base::app)) mode = "a+";
        if (!mode) return nullptr;
        __f = fopen(path, mode);
        if (!__f) return nullptr;
        __own = true;
        if ((m & ios_base::ate) && fseek(__f, 0, SEEK_END) != 0) {
            close();
            return nullptr;
        }
        return this;
    }
    filebuf *close() {
        if (!__f) return nullptr;
        if (__own) fclose(__f);
        __f = nullptr;
        __own = false;
        return this;
    }
    long __write(const char *p, long n) { return __f ? (long)fwrite(p, 1, (unsigned long)n, __f) : 0; }
    int __get() { return __f ? fgetc(__f) : -1; }
    int __peek() {
        if (!__f) return -1;
        int c = fgetc(__f);
        if (c >= 0) ungetc(c, __f);
        return c;
    }
    bool __unget() { return __f && fseek(__f, -1, SEEK_CUR) == 0; }
    long __seek(long off, int dir, bool) {
        if (!__f || fseek(__f, off, dir) != 0) return -1;
        return ftell(__f);
    }
    long __tell(bool) { return __f ? ftell(__f) : -1; }
    int __sync() { return __f ? fflush(__f) : -1; }
};

