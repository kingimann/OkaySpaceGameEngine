# S3 (docs/engine/modularization_plan.md, section 3.1): AllowsMultiple and ApplyComponentOrder move unchanged from
# SceneSerializer.cpp to SceneSerializerHelpers.cpp, because ParseStep (next move) calls them. The loose `}` rules are the diff
# matching a closing brace of a moved function against its neighbours.
#   python3 scripts/check_pure_move.py --base <commit before> --head <this commit> \
#       --source engine/src/Scene/SceneSerializer.cpp --dest engine/src/Scene/SceneSerializerInternal.hpp \
#       --dest engine/src/Scene/SceneSerializerHelpers.cpp --rules docs/engine/moves/S3_sceneserializer_order.rules
add: ^\s*bool AllowsMultiple\(const Component\*\);$
add: ^\s*void ApplyComponentOrder\(.*\);$
add: ^\s*\}$
drop: ^\s*\}$
