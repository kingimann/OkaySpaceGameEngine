// okay-ms own standard header: <mutex>, written from ISO/IEC 14882 [thread.mutex] on the Win32 slim reader/writer lock
// (okay_win32_sync). mutex is one SRWLOCK taken exclusively; recursive_mutex adds the owning thread's id and a depth;
// lock_guard, unique_lock (defer_lock, try_to_lock, adopt_lock), once_flag and call_once. Differences from the
// standard: no timed mutexes, no scoped_lock or std::lock of several mutexes, no unique_lock::mutex(); call_once runs the function under a lock
// (a second caller waits until it has finished, as the standard requires) and takes no extra arguments.
#pragma once
#include <okay_win32_sync>
namespace std {
struct defer_lock_t {};
struct try_to_lock_t {};
struct adopt_lock_t {};
static const defer_lock_t defer_lock = {};
static const try_to_lock_t try_to_lock = {};
static const adopt_lock_t adopt_lock = {};

class mutex {
    void* srw_;

public:
    mutex() : srw_(0) {}
    void lock() { AcquireSRWLockExclusive(&srw_); }
    bool try_lock() { return TryAcquireSRWLockExclusive(&srw_) != 0; }
    void unlock() { ReleaseSRWLockExclusive(&srw_); }
    void** native_handle() { return &srw_; }
};

class recursive_mutex {
    void* srw_;
    unsigned owner_;  // the id of the thread that holds it, 0 when free (only that thread writes it while held)
    unsigned depth_;

public:
    recursive_mutex() : srw_(0), owner_(0), depth_(0) {}
    void lock() {
        const unsigned me = GetCurrentThreadId();
        if (owner_ == me) {
            ++depth_;
            return;
        }
        AcquireSRWLockExclusive(&srw_);
        owner_ = me;
        depth_ = 1;
    }
    bool try_lock() {
        const unsigned me = GetCurrentThreadId();
        if (owner_ == me) {
            ++depth_;
            return true;
        }
        if (TryAcquireSRWLockExclusive(&srw_) == 0) return false;
        owner_ = me;
        depth_ = 1;
        return true;
    }
    void unlock() {
        if (--depth_ == 0) {
            owner_ = 0;
            ReleaseSRWLockExclusive(&srw_);
        }
    }
};

template <typename M>
class lock_guard {
    M& m_;

public:
    typedef M mutex_type;
    explicit lock_guard(M& m) : m_(m) { m_.lock(); }
    lock_guard(M& m, adopt_lock_t tag) : m_(m) {}
    ~lock_guard() { m_.unlock(); }
};

template <typename M>
class unique_lock {
    M* m_;
    bool owns_;

public:
    typedef M mutex_type;
    unique_lock() : m_(0), owns_(false) {}
    explicit unique_lock(M& m) : m_(&m), owns_(false) {
        m.lock();
        owns_ = true;
    }
    unique_lock(M& m, defer_lock_t tag) : m_(&m), owns_(false) {}
    unique_lock(M& m, try_to_lock_t tag) : m_(&m), owns_(false) { owns_ = m.try_lock(); }
    unique_lock(M& m, adopt_lock_t tag) : m_(&m), owns_(true) {}
    unique_lock(unique_lock&& o) : m_(o.m_), owns_(o.owns_) {
        o.m_ = 0;
        o.owns_ = false;
    }
    unique_lock& operator=(unique_lock&& o) {
        if (owns_) m_->unlock();
        m_ = o.m_;
        owns_ = o.owns_;
        o.m_ = 0;
        o.owns_ = false;
        return *this;
    }
    ~unique_lock() {
        if (owns_) m_->unlock();
    }
    void lock() {
        m_->lock();
        owns_ = true;
    }
    bool try_lock() {
        owns_ = m_->try_lock();
        return owns_;
    }
    void unlock() {
        m_->unlock();
        owns_ = false;
    }
    M* release() {
        M* m = m_;
        m_ = 0;
        owns_ = false;
        return m;
    }
    bool owns_lock() const { return owns_; }
    explicit operator bool() const { return owns_; }
    // The standard's mutex() is not here: okay-ms reads a member function named like a class as that class. <condition_variable>
    // uses this one.
    M* mutex__() const { return m_; }
};

struct once_flag {
    void* srw_;
    bool done_;
    once_flag() : srw_(0), done_(false) {}
};
template <typename F>
void call_once(once_flag& flag, F fn) {
    AcquireSRWLockExclusive(&flag.srw_);
    if (!flag.done_) {
        fn();
        flag.done_ = true;
    }
    ReleaseSRWLockExclusive(&flag.srw_);
}
}
