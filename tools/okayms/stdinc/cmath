    bool inv = x > 1.0;
    if (inv) x = 1.0 / x;
    int halves = 0;
    while (x > 0.2) {
        x = x / (1.0 + sqrt_d(1.0 + x * x));  // tan(a/2) = tan(a) / (1 + sqrt(1 + tan(a)^2))
        ++halves;
