<?xml version="1.0" encoding="utf-8"?>
<!-- Plain C++17 with C++/WinRT, NOT C++/CX: the project must not compile with /ZW (CompileAsWinRT). EXPERIMENTAL, UNVERIFIED. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAsWinRT>false</CompileAsWinRT>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
