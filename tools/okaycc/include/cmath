// <cmath> for okay-cc (ISO/IEC 14882 [cmath.syn], ISO C 7.12). Our own header. Each function has a
// double and a float form. sqrt is the SQRTSD / SQRTSS instruction (exactly rounded, IEEE 754).
// sin, cos, exp, log, log10 and pow are lib/m.c: the correctly rounded result except in rare
// halfway cases; glibc's results are not always correctly rounded, so a last-bit difference from
// a g++ build is possible (see the compiler plan for the measured rates).
#pragma once
extern "C" {
double __okay_sin(double x);
double __okay_cos(double x);
double __okay_exp(double x);
double __okay_log(double x);
double __okay_log10(double x);
double __okay_pow(double x, double y);
float __okay_sinf(float x);
float __okay_cosf(float x);
float __okay_expf(float x);
float __okay_logf(float x);
float __okay_log10f(float x);
float __okay_powf(float x, float y);
}
namespace std {
inline double sqrt(double x) { return __builtin_sqrt(x); }
inline float sqrt(float x) { return __builtin_sqrtf(x); }
inline double sin(double x) { return __okay_sin(x); }
inline float sin(float x) { return __okay_sinf(x); }
inline double cos(double x) { return __okay_cos(x); }
inline float cos(float x) { return __okay_cosf(x); }
inline double exp(double x) { return __okay_exp(x); }
inline float exp(float x) { return __okay_expf(x); }
inline double log(double x) { return __okay_log(x); }
inline float log(float x) { return __okay_logf(x); }
inline double log10(double x) { return __okay_log10(x); }
inline float log10(float x) { return __okay_log10f(x); }
inline double pow(double x, double y) { return __okay_pow(x, y); }
inline float pow(float x, float y) { return __okay_powf(x, y); }
inline double fabs(double x) { return x < 0 ? -x : (x == 0 ? 0.0 : x); }
inline float fabs(float x) { return x < 0 ? -x : (x == 0 ? 0.0f : x); }
inline double abs(double x) { return x < 0 ? -x : (x == 0 ? 0.0 : x); }
inline float abs(float x) { return x < 0 ? -x : (x == 0 ? 0.0f : x); }
inline double floor(double x) {
    if (!(x - x == 0)) return x;  // infinity or NaN
    if (x >= 4503599627370496.0 || x <= -4503599627370496.0) return x;
    double t = (double)(long)x;
    t = t > x ? t - 1.0 : t;
    return t == 0 && x < 0 ? -0.0 : t;
}
inline float floor(float x) { return (float)floor((double)x); }
inline double ceil(double x) {
    if (!(x - x == 0)) return x;
    if (x >= 4503599627370496.0 || x <= -4503599627370496.0) return x;
    double t = (double)(long)x;
    t = t < x ? t + 1.0 : t;
    return t == 0 && x < 0 ? -0.0 : t;
}
inline float ceil(float x) { return (float)ceil((double)x); }
// A NaN argument is treated as missing data: the other one is returned (ISO C 7.12.12.2, F.10.9.2).
inline double fmin(double a, double b) {
    if (!(a == a)) return b;
    if (!(b == b)) return a;
    return b < a ? b : a;
}
inline double fmax(double a, double b) {
    if (!(a == a)) return b;
    if (!(b == b)) return a;
    return a < b ? b : a;
}
inline bool isfinite(double x) { return x - x == 0; }
inline bool isfinite(float x) { return x - x == 0; }
inline bool isinf(double x) { return x == x && !(x - x == 0); }
inline bool isnan(double x) { return !(x == x); }
inline bool isnan(float x) { return !(x == x); }
}  // namespace std
