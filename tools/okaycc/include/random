// <random> for okay-cc (ISO/IEC 14882 [rand]). Our own header. mersenne_twister_engine follows
// the algorithm of Matsumoto and Nishimura, "Mersenne Twister: a 623-dimensionally equidistributed
// uniform pseudo-random number generator" (1998), as the standard states it ([rand.eng.mers]:
// the recurrence, the tempering and the seeding by one value); mt19937 and mt19937_64 take the
// parameters of [rand.predef]. uniform_real_distribution uses generate_canonical
// ([rand.util.canonical]). random_device reads the Linux getrandom system call (318). Not done:
// the other engines and distributions, seed_seq, seeding from a sequence, stream operators.
#pragma once
#include <cstddef>
#include <cstdint>  // result_type: uint_fast32_t and uint_fast64_t are both unsigned long (LP64)
extern "C" long syscall(long n, long a, long b, long c);
namespace std {
template <typename U, size_t w, size_t n, size_t m, size_t r, U a, size_t u, U d, size_t s, U b, size_t t, U c,
          size_t l, U f>
class mersenne_twister_engine {
public:
    typedef U result_type;
    static const U default_seed = 5489u;
    U __x[n];
    size_t __i;
    explicit mersenne_twister_engine(U value = 5489u) { seed(value); }
    static constexpr U min() { return 0; }
    static constexpr U max() { return __mask(); }
    static constexpr U __mask() { return w == 64 ? (U)~(U)0 : (U)(((U)1 << w) - 1); }
    void seed(U value = 5489u) {
        // [rand.eng.mers] p8: x(-n) = value mod 2^w, x(i) = (f * (x(i-1) xor (x(i-1) >> (w-2))) + i) mod 2^w
        __x[0] = value & __mask();
        for (size_t i = 1; i < n; ++i) __x[i] = (f * (__x[i - 1] ^ (__x[i - 1] >> (w - 2))) + (U)i) & __mask();
        __i = n;
    }
    U operator()() {
        if (__i >= n) __twist();
        U z = __x[__i++];
        z ^= (z >> u) & d;
        z ^= (z << s) & b;
        z ^= (z << t) & c;
        z ^= z >> l;
        return z & __mask();
    }
    void discard(unsigned long long k) {
        for (; k > 0; --k) (*this)();
    }
    void __twist() {
        const U upper = (__mask() << r) & __mask();
        const U lower = ~upper & __mask();
        for (size_t i = 0; i < n; ++i) {
            U y = (__x[i] & upper) | (__x[(i + 1) % n] & lower);
            U v = y >> 1;
            if (y & 1) v ^= a;
            __x[i] = __x[(i + m) % n] ^ v;
        }
        __i = 0;
    }
};
typedef mersenne_twister_engine<unsigned long, 32, 624, 397, 31, 0x9908b0dfUL, 11, 0xffffffffUL, 7, 0x9d2c5680UL,
                                15, 0xefc60000UL, 18, 1812433253UL>
    mt19937;
typedef mersenne_twister_engine<unsigned long, 64, 312, 156, 31, 0xb5026f5aa96619e9ULL, 29, 0x5555555555555555ULL, 17,
                                0x71d67fffeda60000ULL, 37, 0xfff7eee000000000ULL, 43, 6364136223846793005ULL>
    mt19937_64;
typedef mt19937 default_random_engine;

class random_device {
public:
    typedef unsigned int result_type;
    random_device() {}
    unsigned int operator()() {
        unsigned int v = 0;
        long got = syscall(318, (long)&v, (long)sizeof(v), 0);  // getrandom(buf, len, 0)
        if (got != (long)sizeof(v)) v = 0x9e3779b9u;
        return v;
    }
    static constexpr unsigned int min() { return 0; }
    static constexpr unsigned int max() { return 0xffffffffu; }
    double entropy() const { return 32.0; }
};

// generate_canonical<double, 53>(g) ([rand.util.canonical]): k = ceil(53 / log2(R)) calls of g,
// S = sum (g() - min) * R^i, the result S / R^k (R = max - min + 1).
template <typename Real, typename G>
Real __canonical(G &g, int bits) {
    long double range = (long double)(G::max() - G::min()) + 1.0L;
    int log2r = 0;
    for (long double p = 1.0L; p < range; p *= 2.0L) ++log2r;
    int k = (bits + log2r - 1) / log2r;
    if (k < 1) k = 1;
    long double sum = 0.0L;
    long double mult = 1.0L;
    for (int i = 0; i < k; ++i) {
        sum += (long double)(g() - G::min()) * mult;
        mult *= range;
    }
    Real r = (Real)(sum / mult);
    if (r >= (Real)1) r = (Real)1 - (Real)1 / (Real)(1ULL << (bits < 63 ? bits : 63));
    return r;
}

template <typename Real = double>
class uniform_real_distribution {
public:
    typedef Real result_type;
    Real __a;
    Real __b;
    explicit uniform_real_distribution(Real a = 0, Real b = 1) : __a(a), __b(b) {}
    Real a() const { return __a; }
    Real b() const { return __b; }
    void reset() {}
    template <typename G>
    Real operator()(G &g) {
        Real u = __canonical<Real>(g, sizeof(Real) == 4 ? 24 : 53);
        return u * (__b - __a) + __a;
    }
};
}  // namespace std
