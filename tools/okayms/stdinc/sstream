// okay-ms own standard header: istringstream, ostringstream, stringstream and the stream operators the engine uses, written
// from ISO/IEC 14882 [string.streams] and [istream.formatted]. Own small version, NOT the iostream class hierarchy: an input
// stream is a string and a read position, an output stream is a string that grows. Supported: `>>` into string (a word),
// int, unsigned, long, long long, unsigned long long, float, double, char; std::getline(stream, string [, delim]); `<<` of
// strings, C strings, char, the integer types, float and double (a float is written as fixed digits with the trailing zeros
// removed, up to six decimals, not as printf's %g); str(); eof() and the stream's truth value (false after a failed read).
// No manipulators (setw, hex, ...), no precision or flags, no locales, no seekg/tellg, no exceptions.
#pragma once
#include <cstddef>
#include <cstdlib>
#include <string>
namespace std {
typedef long long streamoff;
typedef long long streamsize;
struct ios_base {
    // Constants, not an enum: an enumerator of a class is a global name here and would hide locals called `in` or `out`.
    static const int in = 1;
    static const int out = 2;
    static const int ate = 4;
    static const int app = 8;
    static const int trunc = 16;
    static const int binary = 32;
    typedef int openmode;
};
typedef ios_base ios;

class okay_istream {
public:
    string buf_;
    size_t pos_;
    bool fail_;
    okay_istream() : buf_(), pos_(0), fail_(false), gcount_(0) {}
    operator bool() const { return !fail_; }
    bool operator!() const { return fail_; }
    bool fail() const { return fail_; }
    bool good() const { return !fail_ && pos_ <= buf_.size(); }
    bool eof() const { return pos_ >= buf_.size(); }
    void skip_space() {
        while (pos_ < buf_.size() && (buf_[pos_] == ' ' || buf_[pos_] == '\t' || buf_[pos_] == '\n' || buf_[pos_] == '\r')) ++pos_;
    }
    // The next word, or fail when there is none.
    string word() {
        skip_space();
        size_t start = pos_;
        while (pos_ < buf_.size() && !(buf_[pos_] == ' ' || buf_[pos_] == '\t' || buf_[pos_] == '\n' || buf_[pos_] == '\r')) ++pos_;
        if (start == pos_) fail_ = true;
        return buf_.substr(start, pos_ - start);
    }
    // Binary-style access on the text held in buf_ ([istream.unformatted], [istream.members.seekg]): tellg, seekg, read, gcount,
    // get, peek, ignore, clear. The position is a byte offset into the text.
    long long gcount_;
    long long tellg() const { return fail_ ? -1 : (long long)pos_; }
    okay_istream& seekg(long long p) {
        if (p < 0 || p > (long long)buf_.size()) fail_ = true;
        else pos_ = (size_t)p;
        return *this;
    }
    okay_istream& seekg(long long off, int dir) {  // dir: 0 from the start, 1 from here, 2 from the end
        long long base = dir == 0 ? 0 : dir == 1 ? (long long)pos_ : (long long)buf_.size();
        return seekg(base + off);
    }
    okay_istream& read(char* dst, long long n) {
        long long avail = (long long)buf_.size() - (long long)pos_;
        long long take = n < avail ? n : avail;
        for (long long i = 0; i < take; ++i) dst[i] = buf_[pos_ + (size_t)i];
        pos_ += (size_t)take;
        gcount_ = take;
        if (take < n) fail_ = true;
        return *this;
    }
    long long gcount() const { return gcount_; }
    int get() {
        if (pos_ >= buf_.size()) {
            fail_ = true;
            return -1;
        }
        return (unsigned char)buf_[pos_++];
    }
    int peek() const { return pos_ >= buf_.size() ? -1 : (unsigned char)buf_[pos_]; }
    okay_istream& ignore(long long n = 1) {
        pos_ += (size_t)n;
        if (pos_ > buf_.size()) pos_ = buf_.size();
        return *this;
    }
    void clear() { fail_ = false; }
    okay_istream* rdbuf() { return this; }
    string rest() const {
        if (pos_ >= buf_.size()) return string();
        return buf_.substr(pos_);
    }
};

extern "C" void okay_write_handle(int which, const char* data, long long n);
class okay_ostream {
public:
    string out_;
    int sink_;       // 0: collect in out_; 1: write to standard output as it comes; 2: standard error
    int width_;      // setw: the next field is padded on the left to this many characters (then 0)
    int precision_;  // setprecision: decimals of a floating-point value (-1: up to six, trailing zeros removed)
    okay_ostream() : out_(), sink_(0), width_(0), precision_(-1) {}
    operator bool() const { return true; }
    // write(data, n) and put(c): raw bytes appended as they are ([ostream.unformatted]); tellp, flush and seekp-less access.
    okay_ostream& write(const char* data, long long n) {
        out_.append(data, (size_t)n);
        if (sink_ != 0) {
            okay_write_handle(sink_, out_.c_str(), (long long)out_.size());
            out_.clear();
        }
        return *this;
    }
    okay_ostream& put(char c) { return write(&c, 1); }
    long long tellp() const { return (long long)out_.size(); }
    okay_ostream& flush() { return *this; }
    bool fail() const { return false; }
    // Appends the text, padded to width_, and writes it at once when the stream is a standard one.
    void put(const string& text) {
        if (width_ > 0) {
            for (size_t i = text.size(); i < (size_t)width_; ++i) out_.push_back(' ');
            width_ = 0;
        }
        out_ += text;
        if (sink_ != 0) {
            okay_write_handle(sink_, out_.c_str(), (long long)out_.size());
            out_.clear();
        }
    }
};

inline okay_istream& operator>>(okay_istream& src, string& s) {
    s = src.word();
    return src;
}
inline okay_istream& operator>>(okay_istream& src, char& c) {
    src.skip_space();
    if (src.pos_ >= src.buf_.size()) src.fail_ = true;
    else c = src.buf_[src.pos_++];
    return src;
}
inline okay_istream& operator>>(okay_istream& src, double& v) {
    const string w = src.word();
    if (src.fail_) return src;
    char* end = 0;
    const double d = strtod(w.c_str(), &end);
    if (end == w.c_str()) src.fail_ = true;
    else v = d;
    return src;
}
inline okay_istream& operator>>(okay_istream& src, float& v) {
    double d = 0.0;
    src >> d;
    if (!src.fail_) v = (float)d;
    return src;
}
inline okay_istream& operator>>(okay_istream& src, long long& v) {
    const string w = src.word();
    if (src.fail_) return src;
    char* end = 0;
    const long r = strtol(w.c_str(), &end, 10);
    if (end == w.c_str()) src.fail_ = true;
    else v = r;
    return src;
}
inline okay_istream& operator>>(okay_istream& src, int& v) {
    long long x = 0;
    src >> x;
    if (!src.fail_) v = (int)x;
    return src;
}
inline okay_istream& operator>>(okay_istream& src, long& v) {
    long long x = 0;
    src >> x;
    if (!src.fail_) v = (long)x;
    return src;
}
inline okay_istream& operator>>(okay_istream& src, unsigned& v) {
    long long x = 0;
    src >> x;
    if (!src.fail_) v = (unsigned)x;
    return src;
}
inline okay_istream& operator>>(okay_istream& src, unsigned long long& v) {
    long long x = 0;
    src >> x;
    if (!src.fail_) v = (unsigned long long)x;
    return src;
}
// getline ([string.io]): up to the delimiter, which is read and dropped; false when nothing was left to read.
inline okay_istream& getline(okay_istream& src, string& line, char delim) {
    if (src.pos_ >= src.buf_.size()) {
        src.fail_ = true;
        line.clear();
        return src;
    }
    size_t start = src.pos_;
    while (src.pos_ < src.buf_.size() && src.buf_[src.pos_] != delim) ++src.pos_;
    line = src.buf_.substr(start, src.pos_ - start);
    if (src.pos_ < src.buf_.size()) ++src.pos_;
    if (delim == '\n' && !line.empty() && line[line.size() - 1] == '\r') line.resize(line.size() - 1);
    return src;
}
inline okay_istream& getline(okay_istream& src, string& line) { return getline(src, line, '\n'); }

inline okay_ostream& operator<<(okay_ostream& o, const string& s) {
    o.put(s);
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, const char* s) {
    o.put(string(s));
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, char c) {
    o.put(string(1, c));
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, long long v) {
    o.put(to_string(v));
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, int v) { return o << (long long)v; }
inline okay_ostream& operator<<(okay_ostream& o, long v) { return o << (long long)v; }
inline okay_ostream& operator<<(okay_ostream& o, unsigned v) { return o << (long long)v; }
inline okay_ostream& operator<<(okay_ostream& o, unsigned long long v) {
    o.put(to_string(v));
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, double v) {
    string text;
    if (v != v) {
        o.put(string("nan"));
        return o;
    }
    if (v < 0.0) {
        text.push_back('-');
        v = -v;
    }
    if (v > 1.0e18) {
        text += "inf";
        o.put(text);
        return o;
    }
    const int decimals = o.precision_ < 0 ? 6 : (o.precision_ > 9 ? 9 : o.precision_);
    double scale = 1.0;
    for (int i = 0; i < decimals; ++i) scale *= 10.0;
    long long whole = (long long)v;
    double frac = v - (double)whole;
    long long units = (long long)(frac * scale + 0.5);
    if ((double)units >= scale) {
        ++whole;
        units = 0;
    }
    text += to_string(whole);
    if (decimals > 0 && (units > 0 || o.precision_ >= 0)) {
        string digits = to_string(units);
        while (digits.size() < (size_t)decimals) digits = "0" + digits;
        size_t end = digits.size();
        if (o.precision_ < 0)
            while (end > 0 && digits[end - 1] == '0') --end;
        if (end > 0) {
            text.push_back('.');
            text += digits.substr(0, end);
        }
    }
    o.put(text);
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, float v) { return o << (double)v; }
// `out << in.rdbuf()`: the rest of the input is appended.
inline okay_ostream& operator<<(okay_ostream& o, okay_istream* src) {
    o.put(src->rest());
    src->pos_ = src->buf_.size();
    return o;
}

class istringstream : public okay_istream {
public:
    istringstream() {}
    istringstream(const string& s) { buf_ = s; }
    string str() const { return buf_; }
    void str(const string& s) {
        buf_ = s;
        pos_ = 0;
        fail_ = false;
    }
};
class ostringstream : public okay_ostream {
public:
    ostringstream() {}
    string str() const { return out_; }
    void str(const string& s) { out_ = s; }
};
class stringstream : public okay_ostream {
public:
    stringstream() {}
    string str() const { return out_; }
};

// Manipulators: endl, flush, setw, setprecision, fixed (a stream's precision then means decimals, as `fixed` makes it in
// the standard; without setprecision up to six decimals are written with trailing zeros removed).
// endl, flush and fixed are objects of small types (okay-ms cannot declare a pointer to a function returning a reference).
struct okay_endl_t { int unused; };
struct okay_flush_t { int unused; };
struct okay_fixed_t { int unused; };
static okay_endl_t endl;
static okay_flush_t flush;
static okay_fixed_t fixed;
inline okay_ostream& operator<<(okay_ostream& o, okay_endl_t e) {
    (void)e;
    o.put(string(1, '\n'));
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, okay_flush_t f) { (void)f; return o; }
inline okay_ostream& operator<<(okay_ostream& o, okay_fixed_t f) { (void)f; return o; }
struct okay_setw { int n; };
struct okay_setprecision { int n; };
inline okay_setw setw(int n) {
    okay_setw r;
    r.n = n;
    return r;
}
inline okay_setprecision setprecision(int n) {
    okay_setprecision r;
    r.n = n;
    return r;
}
inline okay_ostream& operator<<(okay_ostream& o, okay_setw w) {
    o.width_ = w.n;
    return o;
}
inline okay_ostream& operator<<(okay_ostream& o, okay_setprecision p) {
    o.precision_ = p.n;
    return o;
}
}
