// okay-ms own standard header: <new>. Placement new (`new (p) T(args)`) and operator new/delete for a class are
// built into the compiler (ISO/IEC 14882 [expr.new]); `new` calls the global `malloc` and `delete` calls `free`.
#pragma once
// dynamic_cast calls std::__okay_dynamic_cast of <typeinfo>; MSVC's headers reach <typeinfo> from <new> as well, and
// engine files use dynamic_cast without including it (JsLibString.cpp; Round 33).
#include <typeinfo>
// A new-expression calls these, so they are declared here too (the same declarations as <cstdlib>): `new` works in a
// file that includes only <new>.
void *malloc(unsigned long long n);
void free(void *p);
namespace std {
// The tag of the non-throwing new ([new.syn]): `new (std::nothrow) T` is read by the compiler itself.
struct nothrow_t {
    explicit nothrow_t() {}
};
// std::allocator ([default.allocator]; Round 32, FbxReader.hpp's `struct UninitAllocator : std::allocator<T>`): the
// default allocator, memory from malloc and free like `new`. The standard declares it in <memory>; it is here so that
// <vector> (which includes <new>) can name it as its default second argument, and <memory> includes <new>.
template <typename T>
class allocator {
public:
    typedef T value_type;
    typedef unsigned long long size_type;
    typedef long long difference_type;
    allocator() {}
    allocator(const allocator&) {}
    template <typename U>
    allocator(const allocator<U>&) {}
    T* allocate(unsigned long long n) { return (T*)malloc(n * sizeof(T)); }
    void deallocate(T* p, unsigned long long) { free(p); }
    bool operator==(const allocator&) const { return true; }
    bool operator!=(const allocator&) const { return false; }
};
}
