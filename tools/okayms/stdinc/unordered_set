// okay-ms own standard header: std::unordered_set, written from ISO/IEC 14882 [unord.set]. Own minimal version: it is
// the sorted-array set of <set> (needs operator< on the element, not std::hash), so iteration is in ascending order,
// which the standard allows ("unspecified order"), and an insert or erase in the middle is linear time.
#pragma once
#include <set>
namespace std {
template <typename T>
class unordered_set {
    set<T> items_;

public:
    typedef T key_type;
    typedef T value_type;
    typedef size_t size_type;
    typedef const T* iterator;
    typedef const T* const_iterator;
    unordered_set() {}
    template <typename It> unordered_set(It first, It last) {
        for (; first != last; ++first) insert(*first);
    }
    unordered_set(initializer_list<T> list) : items_(list) {}
    size_t size() const { return items_.size(); }
    bool empty() const { return items_.empty(); }
    const T* begin() const { return items_.begin(); }
    const T* end() const { return items_.end(); }
    void clear() { items_.clear(); }
    void swap(unordered_set& other) { items_.swap(other.items_); }
    void reserve(size_t) {}
    size_t count(const T& value) const { return items_.count(value); }
    const T* find(const T& value) const { return items_.find(value); }
    pair<const T*, bool> insert(const T& value) { return items_.insert(value); }
    size_t erase(const T& value) { return items_.erase(value); }
    const T* erase(const T* pos) { return items_.erase(pos); }
};
}
