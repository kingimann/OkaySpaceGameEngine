# Test shards: split the unit tests over several CI jobs (docs/process/automated_testing.md "CI speed").
#
#   cmake -DOKAY_TEST_SHARD=2/3 ...   configure shard 2 of 3: only this shard's tests are added (ctest runs only them), and
#                                     only the test programs they run are in the default build ("all").
#   OKAY_TEST_SHARD empty (default)   nothing here does anything: the build and the test list are exactly as without this file.
#
# How a test gets its shard: a stable hash (MD5) of a key, modulo the shard count. The key is the test program the test runs
# (the first word of COMMAND when it is a target, else the first $<TARGET_FILE:x> in its arguments), so every test that runs one
# program lands in the same shard and that program is compiled by one shard only. A test that runs no target of ours (a Python
# or shell script) is keyed by its own name. A test program that no test runs is built by the shard its own name hashes to.
# Nothing is ever dropped: every test is in exactly one shard; tests/scripts/check_test_shards.py checks that in CI.
#
# What is excluded from "all": only executables defined under tests/ or named test_* (test programs). The engine, the tools
# and every library are always built. A test program that a kept test needs is never excluded.
#
# How: add_test, set_tests_properties and set_property are wrapped (only when a shard is set). The wrappers forward every
# argument unchanged (bracket-quoted, so lists and generator expressions survive) and only leave out the tests of other shards.
# The tests' DEPENDS / FIXTURES properties are not used in this repository; if one is added, a test and the test it needs must
# run the same program (or both be keyed the same way), or check_test_shards.py reports the missing one.
# At the end of the top-level CMakeLists.txt, a deferred call sets EXCLUDE_FROM_ALL and writes okay_test_shard.json (every test
# with its shard, kept or not) next to the build, which the check reads.

set(OKAY_TEST_SHARD "" CACHE STRING "Configure only one shard of the tests, as K/N (for example 1/3). Empty: all tests (default).")

if(OKAY_TEST_SHARD STREQUAL "")
    return()
endif()

if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "OKAY_TEST_SHARD needs CMake 3.19 or newer (cmake_language EVAL and DEFER).")
endif()
if(NOT OKAY_TEST_SHARD MATCHES "^([0-9]+)/([0-9]+)$")
    message(FATAL_ERROR "OKAY_TEST_SHARD must look like K/N (for example 1/3), not '${OKAY_TEST_SHARD}'.")
endif()
set(OKAY_SHARD_K ${CMAKE_MATCH_1})
set(OKAY_SHARD_N ${CMAKE_MATCH_2})
if(OKAY_SHARD_N LESS 1 OR OKAY_SHARD_K LESS 1 OR OKAY_SHARD_K GREATER OKAY_SHARD_N)
    message(FATAL_ERROR "OKAY_TEST_SHARD: K must be from 1 to N, got '${OKAY_TEST_SHARD}'.")
endif()
get_property(_okay_shard_loaded GLOBAL PROPERTY OKAY_SHARD_LOADED)
if(_okay_shard_loaded)
    return()   # wrapping twice would make each wrapper call itself
endif()
set_property(GLOBAL PROPERTY OKAY_SHARD_LOADED TRUE)
message(STATUS "OkaySpace: test shard ${OKAY_SHARD_K} of ${OKAY_SHARD_N}")

# The shard (1..N) of a key.
function(_okay_shard_of key out)
    string(MD5 _h "${key}")
    string(SUBSTRING "${_h}" 0 8 _h)
    math(EXPR _s "(0x${_h} % ${OKAY_SHARD_N}) + 1")
    set(${out} ${_s} PARENT_SCOPE)
endfunction()

# Every argument of the calling wrapper from index <first> on, bracket-quoted for cmake_language(EVAL), in <out>. A macro, so
# ARGV<n> below are the calling function's own variables; the caller sets _okay_argc to its ARGC first (a macro's ${ARGC}
# would be the macro's own count).
macro(_okay_shard_quote first out)
    set(${out} "")
    if(_okay_argc GREATER ${first})
        math(EXPR _okay_q_last "${_okay_argc} - 1")
        foreach(_okay_q_i RANGE ${first} ${_okay_q_last})
            string(APPEND ${out} " [==[${ARGV${_okay_q_i}}]==]")
        endforeach()
    endif()
endmacro()

function(_okay_shard_is_skipped name out)
    get_property(_skip GLOBAL PROPERTY OKAY_SHARD_SKIPPED)
    if("${CMAKE_CURRENT_SOURCE_DIR}|${name}" IN_LIST _skip)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(add_test)
    set(_okay_argc ${ARGC})
    _okay_shard_quote(0 _args)
    if(NOT ARGV0 STREQUAL "NAME")
        # Old form add_test(<name> <command>...): not used here; keep it in every shard rather than guess.
        cmake_language(EVAL CODE "_add_test(${_args})")
        return()
    endif()
    set(_name "${ARGV1}")
    set(_cmd_at -1)
    math(EXPR _last "${ARGC} - 1")
    foreach(_i RANGE 2 ${_last})
        if(ARGV${_i} STREQUAL "COMMAND")
            math(EXPR _cmd_at "${_i} + 1")
            break()
        endif()
    endforeach()
    # The programs this test runs: the first word of COMMAND, and every $<TARGET_FILE...:x> in the arguments.
    set(_refs "")
    set(_key "")
    if(_cmd_at GREATER 0 AND _cmd_at LESS ARGC)
        set(_first "${ARGV${_cmd_at}}")
        if(TARGET "${_first}")
            set(_key "${_first}")
        endif()
        if(NOT _first MATCHES "[/$<>]")
            list(APPEND _refs "${_first}")
        endif()
        foreach(_i RANGE ${_cmd_at} ${_last})
            string(REGEX MATCHALL "\\$<TARGET_FILE[A-Z_]*:[^>]+>" _ge "${ARGV${_i}}")
            foreach(_g IN LISTS _ge)
                string(REGEX REPLACE "^\\$<TARGET_FILE[A-Z_]*:([^>]+)>$" "\\1" _t "${_g}")
                list(APPEND _refs "${_t}")
                if(_key STREQUAL "")
                    set(_key "${_t}")
                endif()
            endforeach()
        endforeach()
    endif()
    if(_key STREQUAL "")
        set(_key "test:${_name}")
    endif()
    _okay_shard_of("${_key}" _shard)
    _set_property(GLOBAL APPEND PROPERTY OKAY_SHARD_ALL "${_name}|${_shard}")
    if(_shard EQUAL OKAY_SHARD_K)
        _set_property(GLOBAL APPEND PROPERTY OKAY_SHARD_KEPT_REFS ${_refs})
        cmake_language(EVAL CODE "_add_test(${_args})")
    else()
        _set_property(GLOBAL APPEND PROPERTY OKAY_SHARD_SKIPPED "${CMAKE_CURRENT_SOURCE_DIR}|${_name}")
        _set_property(GLOBAL APPEND PROPERTY OKAY_SHARD_SKIPPED_REFS ${_refs})
    endif()
endfunction()

# set_tests_properties(<test>... PROPERTIES ...): leave out the tests of other shards.
function(set_tests_properties)
    set(_names "")
    set(_rest_at -1)
    math(EXPR _last "${ARGC} - 1")
    foreach(_i RANGE 0 ${_last})
        if(ARGV${_i} STREQUAL "PROPERTIES" OR ARGV${_i} STREQUAL "DIRECTORY")
            set(_rest_at ${_i})
            break()
        endif()
        _okay_shard_is_skipped("${ARGV${_i}}" _s)
        if(NOT _s)
            string(APPEND _names " [==[${ARGV${_i}}]==]")
        endif()
    endforeach()
    if(_names STREQUAL "" OR _rest_at LESS 0)
        return()
    endif()
    set(_okay_argc ${ARGC})
    _okay_shard_quote(${_rest_at} _rest)
    cmake_language(EVAL CODE "_set_tests_properties(${_names}${_rest})")
endfunction()

# set_property(TEST <test>... PROPERTY ...): the same; every other set_property is passed through untouched.
function(set_property)
    set(_okay_argc ${ARGC})
    if(NOT ARGV0 STREQUAL "TEST")
        _okay_shard_quote(0 _args)
        cmake_language(EVAL CODE "_set_property(${_args})")
        return()
    endif()
    set(_names "")
    set(_had FALSE)
    set(_rest_at -1)
    math(EXPR _last "${ARGC} - 1")
    foreach(_i RANGE 1 ${_last})
        if(ARGV${_i} MATCHES "^(PROPERTY|APPEND|APPEND_STRING|DIRECTORY)$")
            set(_rest_at ${_i})
            break()
        endif()
        set(_had TRUE)
        _okay_shard_is_skipped("${ARGV${_i}}" _s)
        if(NOT _s)
            string(APPEND _names " [==[${ARGV${_i}}]==]")
        endif()
    endforeach()
    if(_rest_at LESS 0 OR (_had AND _names STREQUAL ""))
        return()   # every named test is in another shard
    endif()
    _okay_shard_quote(${_rest_at} _rest)
    cmake_language(EVAL CODE "_set_property(TEST${_names}${_rest})")
endfunction()

function(_okay_shard_collect_targets dir out)
    get_property(_t DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(_s IN LISTS _subs)
        _okay_shard_collect_targets("${_s}" _st)
        list(APPEND _t ${_st})
    endforeach()
    set(${out} ${_t} PARENT_SCOPE)
endfunction()

# Deferred to the end of the top-level CMakeLists.txt: take the test programs of other shards out of "all", write the manifest.
function(_okay_shard_finish)
    get_property(_kept GLOBAL PROPERTY OKAY_SHARD_KEPT_REFS)
    get_property(_skipped GLOBAL PROPERTY OKAY_SHARD_SKIPPED_REFS)
    _okay_shard_collect_targets("${CMAKE_SOURCE_DIR}" _targets)
    set(_built 0)
    set(_excluded 0)
    set(_programs "")
    foreach(_t IN LISTS _targets)
        get_target_property(_type ${_t} TYPE)
        if(NOT _type STREQUAL "EXECUTABLE")
            continue()
        endif()
        get_target_property(_dir ${_t} SOURCE_DIR)
        string(FIND "${_dir}/" "${CMAKE_SOURCE_DIR}/tests/" _in_tests)
        if(NOT _t MATCHES "^test_" AND NOT _in_tests EQUAL 0)
            continue()   # not a test program: always built
        endif()
        if(_t IN_LIST _kept)
            set(_mine TRUE)
        elseif(_t IN_LIST _skipped)
            set(_mine FALSE)
        else()
            _okay_shard_of("${_t}" _s)   # run by no test: built by the shard its name hashes to
            if(_s EQUAL OKAY_SHARD_K)
                set(_mine TRUE)
            else()
                set(_mine FALSE)
            endif()
        endif()
        if(_mine)
            math(EXPR _built "${_built} + 1")
            list(APPEND _programs "\"${_t}\"")
        else()
            _set_property(TARGET ${_t} PROPERTY EXCLUDE_FROM_ALL TRUE)
            math(EXPR _excluded "${_excluded} + 1")
        endif()
    endforeach()
    get_property(_all GLOBAL PROPERTY OKAY_SHARD_ALL)
    set(_rows "")
    set(_mine_n 0)
    foreach(_r IN LISTS _all)
        string(REGEX REPLACE "^(.*)\\|([0-9]+)$" "\\1" _n "${_r}")
        string(REGEX REPLACE "^(.*)\\|([0-9]+)$" "\\2" _s "${_r}")
        list(APPEND _rows "{\"name\": \"${_n}\", \"shard\": ${_s}}")
        if(_s EQUAL OKAY_SHARD_K)
            math(EXPR _mine_n "${_mine_n} + 1")
        endif()
    endforeach()
    list(LENGTH _all _total)
    string(REPLACE ";" ",\n  " _rows "${_rows}")
    string(REPLACE ";" ", " _programs "${_programs}")
    file(WRITE "${CMAKE_BINARY_DIR}/okay_test_shard.json"
        "{\"shard\": ${OKAY_SHARD_K}, \"of\": ${OKAY_SHARD_N}, \"programs\": [${_programs}],\n \"tests\": [\n  ${_rows}\n]}\n")
    message(STATUS "OkaySpace: test shard ${OKAY_SHARD_K}/${OKAY_SHARD_N}: ${_mine_n} of ${_total} tests, "
                   "${_built} test programs built, ${_excluded} left to the other shards")
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _okay_shard_finish)
