  script "okayscript" "function start() {
  print(\"Each line below is one file name a script tries to write. 'true' means it was allowed, 'false' means it was refused.\");
  print(\"NUL (a Windows device)          ->\", save(\"k\", 1, \"NUL\"));
  print(\"con.txt (a Windows device)      ->\", save(\"k\", 1, \"con.txt\"));
  print(\"C:/x (a drive letter)           ->\", save(\"k\", 1, \"C:/x\"));
  print(\"slot.okaysave:hidden (a stream) ->\", save(\"k\", 1, \"slot.okaysave:hidden\"));
  print(\"../escape.okaysave (parent dir) ->\", save(\"k\", 1, \"../escape.okaysave\"));
  print(\"/etc/evil.okaysave (absolute)   ->\", save(\"k\", 1, \"/etc/evil.okaysave\"));
  print(\"slot_ok.okaysave (a normal name)->\", save(\"k\", 1, \"slot_ok.okaysave\"));
}
