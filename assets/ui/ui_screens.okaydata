    caption Cap "QUEST" pos=14,10 size=250,16
    text Goal "Find the old mill" pos=14,30 size=252,22 px=16
    text Step "Talk to the miller 0/1" pos=14,54 size=252,20 px=13 color=dim
  panel Hotbar anchor=bottomcenter pos=0,-20 size=456,68 fill=backdrop cr=12
    rep n=6 cols=6 dx=72
      panel Slot pos=10,8 size=60,52 fill=card cr=8 border=1
        text Key "{i}" pos=4,2 size=20,16 px=12 color=dim
  panel Mini anchor=bottomright pos=-20,-20 size=140,140 fill=backdrop cr=70 shape=circle
    icon Pin "compass" pos=54,54 size=32,32 color=accent

