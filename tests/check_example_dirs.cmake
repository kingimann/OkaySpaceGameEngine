# The example scenes the Windows release ships (EXAMPLE_DIRS in scripts/build-windows-dist.sh) must all exist in the source tree,
# each holding at least one file, and the render_effects sample (depth of field and ambient occlusion, docs/try_it.md 18) must be
# in the list with its scene. The release script only fails when it runs; this fails the tests the moment a folder is renamed or
# the sample is dropped from the list. Run: cmake -DROOT=<source dir> -P check_example_dirs.cmake
cmake_policy(SET CMP0057 NEW)
file(STRINGS "${ROOT}/scripts/build-windows-dist.sh" _line REGEX "^EXAMPLE_DIRS=\"")
if(NOT _line)
    message(SEND_ERROR "no EXAMPLE_DIRS=\"...\" line in scripts/build-windows-dist.sh: the pattern of this check no longer matches")
    return()
endif()
string(REGEX REPLACE "^EXAMPLE_DIRS=\"([^\"]*)\".*$" "\\1" _dirs "${_line}")
separate_arguments(_dirs)
set(_count 0)
foreach(_d IN LISTS _dirs)
    math(EXPR _count "${_count} + 1")
    if(NOT IS_DIRECTORY "${ROOT}/examples/${_d}")
        message(SEND_ERROR "EXAMPLE_DIRS names examples/${_d}, which is not a folder")
        continue()
    endif()
    file(GLOB _files "${ROOT}/examples/${_d}/*")
    list(LENGTH _files _n)
    if(_n EQUAL 0)
        message(SEND_ERROR "examples/${_d} is empty")
    endif()
    # SceneSerializer::SaveToFile keeps a rolling "<scene>.bak"; the release script copies every file of a folder.
    file(GLOB _junk "${ROOT}/examples/${_d}/*.bak" "${ROOT}/examples/${_d}/*.tmp")
    if(_junk)
        message(SEND_ERROR "examples/${_d} holds a stray backup or temporary file that would ship: ${_junk}")
    endif()
endforeach()
if(_count LESS 10)
    message(SEND_ERROR "only ${_count} example folders in EXAMPLE_DIRS: the pattern of this check no longer matches")
endif()
if(NOT "render_effects" IN_LIST _dirs)
    message(SEND_ERROR "render_effects is not in EXAMPLE_DIRS: the depth of field and ambient occlusion sample would not ship")
endif()
if(NOT EXISTS "${ROOT}/examples/render_effects/render_effects.okayscene")
    message(SEND_ERROR "examples/render_effects/render_effects.okayscene is missing")
endif()
message(STATUS "${_count} example folders are shipped and all exist")
