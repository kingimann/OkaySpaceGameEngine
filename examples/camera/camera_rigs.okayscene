gameobject 9 "Hero"
  guid "593aa90bab4dc7553a7a42a0e6cc0da8"
  active 1
  parent -1
  transform 0 1 0 0 0 0 1 1 1 1
  mesh "Capsule" 0.2 0.5 0.95 1 0 "" 0
  material 0 0 0 0 16 0 "" 1 1
  script "okayscript" "// Walk with W A S D (or the arrow keys).
function update(dt) {
  var s = 6 * dt
  if (key(\"w\")) { set_z(pos_z() + s) }
  if (key(\"s\")) { set_z(pos_z() - s) }
  if (key(\"a\")) { set_x(pos_x() - s) }
  if (key(\"d\")) { set_x(pos_x() + s) }
}
" "" 0
end
gameobject 10 "Buddy"
  guid "380bb45a713582b8021cc1b5ad0bccc2"
  active 1
  parent -1
  transform 8 0.7 4 0 0 0 1 1.4 1.4 1.4
  mesh "Sphere" 0.95 0.55 0.2 1 0 "" 0
  material 0 0 0 0 16 0 "" 1 1
  script "okayscript" "// Buddy walks in a big circle so the Group shot has something to frame.
function update(dt) {
  var t = time() * 0.35
  set_x(9 * cos(t))
  set_z(9 * sin(t))
}
" "" 0
end
