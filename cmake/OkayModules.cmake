# Engine modules: reads engine/modules/*/module.okaymodule, applies the OKAY_MODULES option and writes
# modules_enabled.cpp (every manifest embedded as text, with an on/off flag), which okay_engine compiles.
# Format and design: docs/modular_engine.md, docs/design/modular_gameplay_contracts.md.
#
#   -DOKAY_MODULES=all                     every module on (the default, nothing changes for anyone)
#   -DOKAY_MODULES=core                    only the core
#   -DOKAY_MODULES=health_damage,weapons   core + these; every requirement must be in the list too (configure fails and says which)
#
# Stage note: in this stage the option decides what the ModuleRegistry reports and what the editor and the
# checks treat as on. Code is stripped from the binary only once a module's scene records, scripts and
# nodes register themselves (docs/modular_engine.md, "What is not stripped yet").

set(OKAY_MODULES "all" CACHE STRING "Engine modules to build: all, core, or a comma separated list (requirements are added)")

# okay_modules_generate(<out_cpp>)  -> sets OKAY_MODULES_ENABLED / OKAY_MODULES_DISABLED in the caller
function(okay_modules_generate out_cpp)
    file(GLOB _manifests "${CMAKE_SOURCE_DIR}/engine/modules/*/module.okaymodule")
    list(SORT _manifests)
    set(_names "")
    foreach(_m IN LISTS _manifests)
        file(STRINGS "${_m}" _lines)
        set(_name "")
        set(_req "")
        set(_core "0")
        set(_compile "")
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "^name=(.*)$")
                set(_name "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^requires=(.*)$")
                set(_req "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^compile=(.*)$")
                set(_compile "${CMAKE_MATCH_1}")
            elseif(_l MATCHES "^core=(.*)$")
                set(_core "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        if(NOT _name MATCHES "^[a-z0-9_]+$")
            message(FATAL_ERROR "${_m}: missing or invalid name= line")
        endif()
        string(REPLACE "," ";" _req "${_req}")
        set(_REQ_${_name} "${_req}")
        set(_CORE_${_name} "${_core}")
        separate_arguments(_compile)
        set(_COMPILE_${_name} "${_compile}")
        set(_FILE_${_name} "${_m}")
        list(APPEND _names "${_name}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_m}")
    endforeach()

    # which modules are wanted
    string(TOLOWER "${OKAY_MODULES}" _sel)
    string(REPLACE " " "" _sel "${_sel}")
    set(_on "")
    foreach(_n IN LISTS _names)
        if(_CORE_${_n} STREQUAL "1")
            list(APPEND _on "${_n}")
        endif()
    endforeach()
    if(_sel STREQUAL "all" OR _sel STREQUAL "")
        set(_on "${_names}")
    elseif(NOT _sel STREQUAL "core")
        string(REPLACE "," ";" _wanted "${_sel}")
        foreach(_w IN LISTS _wanted)
            if(NOT _w IN_LIST _names)
                string(REPLACE ";" ", " _all "${_names}")
                message(FATAL_ERROR "OKAY_MODULES: unknown module '${_w}'. Known modules: ${_all}")
            endif()
            list(APPEND _on "${_w}")
        endforeach()
        # Every listed module must already have its requirements listed. (The editor and tools use
        # ModuleRegistry::Resolve to add them for you; a build option that silently grows is confusing.)
        foreach(_w IN LISTS _wanted)
            foreach(_r IN LISTS _REQ_${_w})
                if(NOT _r IN_LIST _on)
                    message(FATAL_ERROR "OKAY_MODULES: module '${_w}' requires '${_r}'; add it to the list (or disable '${_w}')")
                endif()
            endforeach()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES _on)
    # requirement closure check for every enabled module (catches a requirement of a requirement)
    foreach(_w IN LISTS _on)
        foreach(_r IN LISTS _REQ_${_w})
            if(NOT _r IN_LIST _on)
                message(FATAL_ERROR "OKAY_MODULES: module '${_w}' requires '${_r}'; add it to the list (or disable '${_w}')")
            endif()
        endforeach()
    endforeach()

    set(_disabled "")
    foreach(_n IN LISTS _names)
        if(NOT _n IN_LIST _on)
            list(APPEND _disabled "${_n}")
        endif()
    endforeach()

    # register.cpp of every module that is on (a module that is off has its register.cpp left out of the build)
    set(_reg_sources "")
    set(_reg_names "")
    foreach(_n IN LISTS _on)
        # source files that exist only for this module (manifest compile=): left out of the library when it is off
        foreach(_c IN LISTS _COMPILE_${_n})
            list(APPEND _reg_sources "${CMAKE_SOURCE_DIR}/engine/${_c}")
        endforeach()
        if(EXISTS "${CMAKE_SOURCE_DIR}/engine/modules/${_n}/register.cpp")
            list(APPEND _reg_sources "${CMAKE_SOURCE_DIR}/engine/modules/${_n}/register.cpp")
            list(APPEND _reg_names "${_n}")
        endif()
    endforeach()

    set(_body "// GENERATED by cmake/OkayModules.cmake from engine/modules/*/module.okaymodule. Do not edit.\n")
    string(APPEND _body "#include \"okay/Modules/ModuleRegistry.hpp\"\n\nnamespace okay {\nnamespace modules {\n")
    foreach(_n IN LISTS _reg_names)
        string(APPEND _body "void Register_${_n}(ModuleContext&);\n")
    endforeach()
    string(APPEND _body "} // namespace modules\nnamespace detail {\n\n")
    string(APPEND _body "const char* ConfiguredModuleSelection() { return \"${OKAY_MODULES}\"; }\n\n")
    string(APPEND _body "void RegisterGeneratedModules(ModuleRegistry& r) {\n")
    foreach(_n IN LISTS _names)
        file(READ "${_FILE_${_n}}" _text)
        if(_n IN_LIST _on)
            set(_flag "true")
        else()
            set(_flag "false")
        endif()
        string(APPEND _body "    r.AddText(R\"OKAYMOD(${_text})OKAYMOD\", ${_flag});\n")
    endforeach()
    foreach(_n IN LISTS _reg_names)
        string(APPEND _body "    r.SetRegisterHook(\"${_n}\", &modules::Register_${_n});\n")
    endforeach()
    string(APPEND _body "}\n\n} // namespace detail\n} // namespace okay\n")
    # write only when changed so a re-configure does not recompile
    set(_old "")
    if(EXISTS "${out_cpp}")
        file(READ "${out_cpp}" _old)
    endif()
    if(NOT _old STREQUAL _body)
        file(WRITE "${out_cpp}" "${_body}")
    endif()
    set(OKAY_MODULES_REGISTER_SOURCES "${_reg_sources}" PARENT_SCOPE)
    set(OKAY_MODULES_ENABLED "${_on}" PARENT_SCOPE)
    set(OKAY_MODULES_DISABLED "${_disabled}" PARENT_SCOPE)
endfunction()
