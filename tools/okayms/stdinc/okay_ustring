// okay-ms own standard library: std::u16string, std::u32string and std::wstring, written from ISO/IEC 14882
// [basic.string] for character types other than char. Own minimal version: one class template over a std::vector of
// the code units that always ends in a zero unit; the operations the engine's text code uses (build, append, index,
// compare, substr, find, rfind, iterate). No traits or allocator arguments, no streams, no wide literals (L"..." is not
// read by okay-ms yet). Included by <string>.
#pragma once
#include <cstddef>
#include <type_traits>
#include <vector>
namespace std {
template <typename C>
class basic_ustring__ {
    vector<C> units_;  // the code units and a zero after them

    static size_t length_of(const C* s) {
        size_t n = 0;
        while (s[n] != 0) ++n;
        return n;
    }

public:
    typedef C value_type;
    typedef size_t size_type;
    typedef C* iterator;
    typedef const C* const_iterator;
    static const size_t npos = (size_t)-1;

    basic_ustring__() { units_.push_back((C)0); }
    basic_ustring__(const C* s) { assign(s, length_of(s)); }
    basic_ustring__(const C* s, size_t n) { assign(s, n); }
    basic_ustring__(size_t n, C c) {
        units_.assign(n, c);
        units_.push_back((C)0);
    }
    basic_ustring__(const basic_ustring__& o) : units_(o.units_) {}
    template <typename It>
    basic_ustring__(It first, It last) {
        if constexpr (is_arithmetic<It>::value) {
            units_.assign((size_t)first, (C)last);
        } else {
            for (; first != last; ++first) units_.push_back((C)*first);
        }
        units_.push_back((C)0);
    }
    basic_ustring__& operator=(const basic_ustring__& o) {
        units_ = o.units_;
        return *this;
    }
    basic_ustring__& assign(const C* s, size_t n) {
        units_.clear();
        for (size_t i = 0; i < n; ++i) units_.push_back(s[i]);
        units_.push_back((C)0);
        return *this;
    }

    size_t size() const { return units_.size() - 1; }
    size_t length() const { return units_.size() - 1; }
    bool empty() const { return units_.size() == 1; }
    // capacity ([string.capacity] 9): code units that fit without new storage (the zero unit is not counted).
    size_t capacity() const { return units_.capacity() - 1; }
    const C* data() const { return units_.data(); }
    C* data() { return units_.data(); }
    const C* c_str() const { return units_.data(); }
    C* begin() { return units_.data(); }
    C* end() { return units_.data() + size(); }
    const C* begin() const { return units_.data(); }
    const C* end() const { return units_.data() + size(); }
    C& operator[](size_t i) { return units_[i]; }
    const C& operator[](size_t i) const { return units_[i]; }
    C& back() { return units_[size() - 1]; }
    void reserve(size_t n) { units_.reserve(n + 1); }
    void clear() {
        units_.clear();
        units_.push_back((C)0);
    }
    void push_back(C c) {
        units_.back() = c;
        units_.push_back((C)0);
    }
    void pop_back() {
        units_.pop_back();
        units_.back() = (C)0;
    }
    void resize(size_t n, C c) {
        units_.pop_back();
        units_.resize(n, c);
        units_.push_back((C)0);
    }
    void resize(size_t n) { resize(n, (C)0); }
    basic_ustring__& append(const C* s, size_t n) {
        units_.pop_back();
        for (size_t i = 0; i < n; ++i) units_.push_back(s[i]);
        units_.push_back((C)0);
        return *this;
    }
    basic_ustring__& append(const basic_ustring__& o) { return append(o.data(), o.size()); }
    // append(str, pos, n) ([string.append] 3; Round 33, JsLibObject.cpp): at most n units of str from pos.
    basic_ustring__& append(const basic_ustring__& o, size_t pos, size_t n) {
        if (pos > o.size()) pos = o.size();
        if (n > o.size() - pos) n = o.size() - pos;
        return append(o.data() + pos, n);
    }
    basic_ustring__& append(const C* s) { return append(s, length_of(s)); }
    // append(n, c) ([string.append] 9): n copies of c.
    basic_ustring__& append(size_t n, C c) {
        units_.pop_back();
        for (size_t i = 0; i < n; ++i) units_.push_back(c);
        units_.push_back((C)0);
        return *this;
    }
    basic_ustring__& operator+=(C c) {
        push_back(c);
        return *this;
    }
    basic_ustring__& operator+=(const basic_ustring__& o) { return append(o.data(), o.size()); }
    basic_ustring__& operator+=(const C* s) { return append(s, length_of(s)); }
    basic_ustring__ substr(size_t pos, size_t n) const {
        if (pos > size()) pos = size();
        if (n > size() - pos) n = size() - pos;
        return basic_ustring__(data() + pos, n);
    }
    basic_ustring__ substr(size_t pos) const { return substr(pos, npos); }
    size_t find(C c, size_t pos = 0) const {
        for (size_t i = pos; i < size(); ++i)
            if (units_[i] == c) return i;
        return npos;
    }
    size_t rfind(C c, size_t pos = npos) const {
        if (size() == 0) return npos;
        size_t i = (pos < size()) ? pos : size() - 1;
        for (;; --i) {
            if (units_[i] == c) return i;
            if (i == 0) return npos;
        }
    }
    // The first place at or after pos whose unit is one of set's, or not one of them ([string.find.first.of],
    // [string.find.first.not.of]).
    size_t find_first_of(const C* set, size_t pos = 0) const {
        for (size_t i = pos; i < size(); ++i)
            for (size_t k = 0; set[k] != 0; ++k)
                if (units_[i] == set[k]) return i;
        return npos;
    }
    size_t find_first_of(const basic_ustring__& set, size_t pos = 0) const { return find_first_of(set.data(), pos); }
    size_t find_first_not_of(const C* set, size_t pos = 0) const {
        for (size_t i = pos; i < size(); ++i) {
            bool in = false;
            for (size_t k = 0; set[k] != 0; ++k)
                if (units_[i] == set[k]) in = true;
            if (!in) return i;
        }
        return npos;
    }
    int compare(const basic_ustring__& o) const {
        const size_t n = size() < o.size() ? size() : o.size();
        for (size_t i = 0; i < n; ++i)
            if (units_[i] != o.units_[i]) return units_[i] < o.units_[i] ? -1 : 1;
        return size() == o.size() ? 0 : (size() < o.size() ? -1 : 1);
    }
    // compare(pos, n, str) ([string.compare] 3; Round 33, JsLibString.cpp): the units [pos, pos + n) against str.
    int compare(size_t pos, size_t n, const basic_ustring__& o) const { return substr(pos, n).compare(o); }
    int compare(size_t pos, size_t n, const C* s) const { return substr(pos, n).compare(basic_ustring__(s)); }
    bool operator==(const basic_ustring__& o) const { return compare(o) == 0; }
    bool operator!=(const basic_ustring__& o) const { return compare(o) != 0; }
    bool operator<(const basic_ustring__& o) const { return compare(o) < 0; }
    bool operator>(const basic_ustring__& o) const { return compare(o) > 0; }
    bool operator<=(const basic_ustring__& o) const { return compare(o) <= 0; }
    bool operator>=(const basic_ustring__& o) const { return compare(o) >= 0; }
    basic_ustring__ operator+(const basic_ustring__& o) const {
        basic_ustring__ r(*this);
        r.append(o);
        return r;
    }
};
// A character string or a character in front of a string ([string.op.plus]; Round 31: `L"Range: bytes=" +
// std::to_wstring(n)` in NativeHttp.hpp was added as bytes).
template <typename C> basic_ustring__<C> operator+(const C* a, const basic_ustring__<C>& b) {
    basic_ustring__<C> r(a);
    r.append(b);
    return r;
}
template <typename C> basic_ustring__<C> operator+(const basic_ustring__<C>& a, const C* b) {
    basic_ustring__<C> r(a);
    r += b;
    return r;
}
// std::u16string_view, u32string_view and wstring_view ([string.view.template]): a pointer and a length naming code
// units a basic_ustring__ (or an array) owns. Own minimal version: the members the engine uses (build from a string or a
// pointer, size, data, index, iterate, substr, compare, ==, !=, <), so a view can be the key of a map (JavaScript.hpp's
// atom table; okay-ms's unordered_map with the default hasher is ordered and needs <). Round 33.
template <typename C>
class basic_ustring_view__ {
    const C* data_;
    size_t size_;

public:
    typedef C value_type;
    typedef size_t size_type;
    typedef const C* iterator;
    typedef const C* const_iterator;
    static const size_t npos = (size_t)-1;

    basic_ustring_view__() : data_(0), size_(0) {}
    basic_ustring_view__(const C* s, size_t n) : data_(s), size_(n) {}
    basic_ustring_view__(const C* s) : data_(s), size_(0) {
        while (s[size_] != 0) ++size_;
    }
    basic_ustring_view__(const basic_ustring__<C>& s) : data_(s.data()), size_(s.size()) {}

    size_t size() const { return size_; }
    size_t length() const { return size_; }
    bool empty() const { return size_ == 0; }
    const C* data() const { return data_; }
    const C* begin() const { return data_; }
    const C* end() const { return data_ + size_; }
    const C& operator[](size_t i) const { return data_[i]; }
    basic_ustring_view__ substr(size_t pos, size_t n = npos) const {
        if (pos > size_) pos = size_;
        if (n > size_ - pos) n = size_ - pos;
        return basic_ustring_view__(data_ + pos, n);
    }
    int compare(basic_ustring_view__ o) const {
        const size_t n = size_ < o.size_ ? size_ : o.size_;
        for (size_t i = 0; i < n; ++i)
            if (data_[i] != o.data_[i]) return data_[i] < o.data_[i] ? -1 : 1;
        return size_ == o.size_ ? 0 : (size_ < o.size_ ? -1 : 1);
    }
    bool operator==(basic_ustring_view__ o) const { return compare(o) == 0; }
    bool operator!=(basic_ustring_view__ o) const { return compare(o) != 0; }
    bool operator<(basic_ustring_view__ o) const { return compare(o) < 0; }
};
typedef basic_ustring__<char16_t> u16string;
typedef basic_ustring_view__<char16_t> u16string_view;
typedef basic_ustring_view__<char32_t> u32string_view;
typedef basic_ustring_view__<wchar_t> wstring_view;
typedef basic_ustring__<char32_t> u32string;
typedef basic_ustring__<wchar_t> wstring;
// to_wstring ([string.conversions] 15): the text to_string gives, one wchar_t per character. A function template, so it
// is made only in a file that calls it (Round 29).
template <typename T> wstring to_wstring(T v) {
    const string narrow = std::to_string(v);
    wstring r;
    for (size_t i = 0; i < narrow.size(); ++i) r.push_back((wchar_t)narrow[i]);
    return r;
}
}  // namespace std
