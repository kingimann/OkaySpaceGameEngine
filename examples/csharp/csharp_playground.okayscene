  script "csharp" "using UnityEngine;
using System.Collections;

namespace Playground
{
    // Move with W A S D (or the arrow keys). Space hops; every hop is counted.
    public class PlayerMover : MonoBehaviour
    {
        [Header(\"Movement\")]
        [SerializeField] private float speed = 5f;
        [Range(0, 5)] public float hopHeight = 1.5f;

        // A property: other scripts can read it, only this class sets it.
        public int Hops { get; private set; }

        void Start()
        {
            Debug.Log(\"C# playground: move with W A S D, hop with Space.\");
        }

        void Update()
        {
            float h = Input.GetAxis(\"Horizontal\");
            float v = Input.GetAxis(\"Vertical\");
            transform.position += new Vector3(h, 0, -v) * speed * Time.deltaTime;
            if (Input.GetKeyDown(KeyCode.Space)) StartCoroutine(Hop());
        }

        // A coroutine: up, wait a quarter of a second, down.
        IEnumerator Hop()
        {
            Hops++;
            transform.Translate(0, hopHeight, 0);
            yield return new WaitForSeconds(0.25f);
            transform.Translate(0, -hopHeight, 0);
            Debug.Log($\"Hops: {Hops}\");
        }
    }
}
" "" 0
  script "csharp" "using System.Collections.Generic;
using UnityEngine;
using Playground;   // PlayerMover lives in this namespace

// How hops turn into points. Swap in another class to change the rules.
public interface IScorer
{
    int Score(int hops);
}

public class Doubler : IScorer
{
    public int Score(int hops) => hops * 2;
}

// Every three seconds: reads the hops from the PlayerMover script on the same
// object, keeps a list of scores and logs the best one so far.
public class Scoreboard : MonoBehaviour
{
    private List<int> history = new List<int>();
    private IScorer scorer;
    private float timer;

    void Start()
    {
        scorer = new Doubler();
    }

    void Update()
    {
        timer += Time.deltaTime;
        if (timer < 3f) return;
        timer = 0f;

        PlayerMover mover = GetComponent<PlayerMover>();
        if (mover == null) return;
        int points = scorer.Score(mover.Hops);
        history.Add(points);

        int best = 0;
        foreach (int p in history)
            if (p > best) best = p;

        string rank;
        switch (best)
        {
            case 0: rank = \"no hops yet\"; break;
            case 2: case 4: rank = \"warming up\"; break;
            default: rank = \"hopping well\"; break;
        }
        Debug.Log($\"Score {points}, best {best}: {rank}\");
    }
}
