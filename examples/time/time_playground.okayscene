gameobject 0 "Floor"
  active 1
  parent -1
  transform 0 -0.5 0 0 0 0 1 1 1 1
  boxcollider3d 20 1 20 0 0 0 0
end
gameobject 1 "Floor Mesh"
  active 1
  parent 0
  transform 0 -0.5 0 0 0 0 1 20 1 20
  mesh "Cube" 0.35 0.4 0.35 1 0 "" 0
  material 0 0 0 0 8 1 "" 1 1
end
gameobject 2 "Ball"
  active 1
  parent -1
  transform 0 6 0 0 0 0 1 1 1 1
  boxcollider3d 1 1 1 0 0 0 0
  rigidbody3d 0 1 1 0 0 0 0 0
  mesh "Sphere" 0.9 0.3 0.2 1 0 "" 0
  material 0 0 0 0 8 1 "" 1 1
  script "okayscript" "// A ball that is dropped again every 3 seconds. every() counts GAME time, so slow motion
// slows the drops and a pause stops them. Gravity (physics) slows too: it all runs on game time.
function start() { every(3, \"drop\"); }
function drop() { set_y(7); set_velocity(0, 0, 0); }
" "" 0
end
gameobject 3 "Game Time Spinner"
  active 1
  parent -1
  transform -3 1 0 0 0 0 1 1 1 1
  mesh "Cube" 0.2 0.5 0.9 1 0 "" 0
  material 0 0 0 0 8 1 "" 1 1
  script "okayscript" "// Turns on GAME time (dt): slows in slow motion, stops in a hit stop and while the game is paused.
function update(dt) { rotate3(0, 90 * dt, 0); }
" "" 0
end
gameobject 4 "Real Time Spinner"
  active 1
  parent -1
  transform 3 1 0 0 0 0 1 1 1 1
  mesh "Cube" 0.95 0.6 0.1 1 0 "" 0
  material 0 0 0 0 8 1 "" 1 1
  script "okayscript" "// Turns on REAL time (unscaled_dt): keeps its speed through slow motion, hit stops and the pause menu.
function update(dt) { rotate3(0, 90 * unscaled_dt(), 0); }
" "" 0
end
