// okay-ms own standard header: numeric_limits for float, int and unsigned (ISO/IEC 14882
// [numeric.limits], values from the IEEE-754 binary32 and two's complement definitions).
#pragma once
namespace std {
template <typename T> struct numeric_limits;
template <> struct numeric_limits<float> {
    static float max() { return 3.40282347e+38f; }
    static float min() { return 1.17549435e-38f; }
    static float lowest() { return -3.40282347e+38f; }
    static float epsilon() { return 1.19209290e-07f; }
    static float infinity() { return 3.40282347e+38f * 2.0f; }
};
template <> struct numeric_limits<int> {
    static int max() { return 2147483647; }
    static int min() { return -2147483647 - 1; }
    static int lowest() { return -2147483647 - 1; }
};
template <> struct numeric_limits<unsigned> {
    static unsigned max() { return 4294967295u; }
    static unsigned min() { return 0u; }
    static unsigned lowest() { return 0u; }
};
}
