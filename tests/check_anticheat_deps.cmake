# OkayAntiCheat's runtime has no launcher or editor code in it (docs/online/okay_anticheat.md, sections 1 and 5.1; round 2).
#   1. The home exists: engine/include/okay/AntiCheat/ with the entry header AntiCheat.hpp, and engine/src/AntiCheat/.
#   2. No file in the home includes a launcher/ or editor/ header: no include path that names launcher/ or editor/ or
#      climbs out with ../, and every quoted include must be found in the file's own folder, engine/include, engine/src
#      or shared/ (so a bare "AntiCheatPages.hpp" that only exists in launcher/ is refused too). <...> includes are
#      system or library headers and only checked for a launcher/ or editor/ path.
#   3. INCLUDES (optional): the include folders the okay_anticheat target is compiled with, one per line (written by
#      engine/CMakeLists.txt at generate time). None of them may be launcher/ or editor/.
#   cmake -DROOT=<repo> [-DINCLUDES=<okay_anticheat_includes.txt>] -P check_anticheat_deps.cmake
#   cmake -DROOT=<repo> -DSELFTEST=<empty scratch folder> -P check_anticheat_deps.cmake
#     builds small good and bad homes in the scratch folder and checks that the scan passes the good one and refuses
#     each bad one (so this check can fail).
# Written for this repository from the design document; no outside code.

# _ac_scan(<repo root> <out var>): the problems found in <root>'s OkayAntiCheat home, one "file: why" per entry.
function(_ac_scan root out)
    set(problems "")
    set(inc "${root}/engine/include/okay/AntiCheat")
    set(src "${root}/engine/src/AntiCheat")
    if(NOT IS_DIRECTORY "${inc}")
        list(APPEND problems "${inc}: the OkayAntiCheat header home does not exist")
    elseif(NOT EXISTS "${inc}/AntiCheat.hpp")
        list(APPEND problems "${inc}: no entry header AntiCheat.hpp")
    endif()
    if(NOT IS_DIRECTORY "${src}")
        list(APPEND problems "${src}: the OkayAntiCheat source home does not exist")
    endif()
    file(GLOB_RECURSE files "${inc}/*.hpp" "${inc}/*.h" "${inc}/*.inc" "${src}/*.cpp" "${src}/*.hpp" "${src}/*.h" "${src}/*.inc")
    set(search "${root}/engine/include" "${root}/engine/src" "${root}/shared")
    foreach(f IN LISTS files)
        get_filename_component(own "${f}" DIRECTORY)
        file(STRINGS "${f}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]")
        foreach(l IN LISTS lines)
            if(NOT l MATCHES "^[ \t]*#[ \t]*include[ \t]*([\"<])([^\">]+)[\">]")
                continue()
            endif()
            set(kind "${CMAKE_MATCH_1}")
            set(name "${CMAKE_MATCH_2}")
            if(name MATCHES "(^|/)(launcher|editor)/" OR name MATCHES "(^|/)\\.\\./")
                list(APPEND problems "${f}: includes ${name} (a launcher/ or editor/ path, or a climb out with ../)")
                continue()
            endif()
            if(kind STREQUAL "<")
                continue()
            endif()
            set(found "")
            foreach(d "${own}" ${search})
                if(EXISTS "${d}/${name}" AND NOT IS_DIRECTORY "${d}/${name}")
                    set(found "${d}/${name}")
                    break()
                endif()
            endforeach()
            if(NOT found)
                list(APPEND problems "${f}: includes \"${name}\", which is not in its own folder, engine/include, engine/src or shared/ (a launcher or editor header?)")
            endif()
        endforeach()
    endforeach()
    list(LENGTH files n)
    set(${out} "${problems}" PARENT_SCOPE)
    set(${out}_count ${n} PARENT_SCOPE)
endfunction()

if(NOT ROOT)
    message(FATAL_ERROR "pass -DROOT=<the repository folder>")
endif()

if(SELFTEST)
    # Each case is a small tree: one home with one header. The good case must pass, every bad case must be refused.
    file(REMOVE_RECURSE "${SELFTEST}")
    function(_ac_case name body)
        set(r "${SELFTEST}/${name}")
        file(WRITE "${r}/engine/include/okay/Math/Vec3.hpp" "#pragma once\n")
        file(WRITE "${r}/shared/OfficialGame.hpp" "#pragma once\n")
        file(WRITE "${r}/launcher/AntiCheatPages.hpp" "#pragma once\n")
        file(WRITE "${r}/editor/AntiCheatSetup.hpp" "#pragma once\n")
        file(WRITE "${r}/engine/include/okay/AntiCheat/Other.hpp" "#pragma once\n")
        file(WRITE "${r}/engine/src/AntiCheat/AntiCheat.cpp" "#include \"okay/AntiCheat/AntiCheat.hpp\"\n")
        file(WRITE "${r}/engine/include/okay/AntiCheat/AntiCheat.hpp" "#pragma once\n${body}\n")
    endfunction()
    _ac_case(good "#include <vector>\n#include <windows.h>\n#include \"okay/Math/Vec3.hpp\"\n#include \"OfficialGame.hpp\"\n#include \"Other.hpp\"")
    _ac_case(launcher_path "#include \"launcher/AntiCheatPages.hpp\"")
    _ac_case(editor_angle "#include <editor/AntiCheatSetup.hpp>")
    _ac_case(climb "#include \"../../../../launcher/AntiCheatPages.hpp\"")
    _ac_case(bare_launcher "#include \"AntiCheatPages.hpp\"")
    _ac_case(bare_editor "  #  include \"AntiCheatSetup.hpp\"   // indented")
    file(MAKE_DIRECTORY "${SELFTEST}/no_home")
    set(failed "")
    foreach(c good launcher_path editor_angle climb bare_launcher bare_editor no_home)
        _ac_scan("${SELFTEST}/${c}" p)
        if(c STREQUAL "good")
            if(p)
                list(APPEND failed "good tree refused: ${p}")
            endif()
        elseif(NOT p)
            list(APPEND failed "bad tree '${c}' passed")
        else()
            message("selftest ${c}: refused as expected")
        endif()
    endforeach()
    file(REMOVE_RECURSE "${SELFTEST}")
    if(failed)
        string(REPLACE ";" "\n" failed "${failed}")
        message(FATAL_ERROR "the OkayAntiCheat layering check is broken:\n${failed}")
    endif()
    message("anticheat_deps selftest: the good tree passes, 6 bad trees are refused")
    return()
endif()

_ac_scan("${ROOT}" problems)
if(INCLUDES)
    if(NOT EXISTS "${INCLUDES}")
        list(APPEND problems "${INCLUDES}: the okay_anticheat include list was not written (engine/CMakeLists.txt)")
    else()
        file(STRINGS "${INCLUDES}" dirs)
        if(NOT dirs)
            list(APPEND problems "${INCLUDES}: the okay_anticheat include list is empty")
        endif()
        foreach(d IN LISTS dirs)
            file(TO_CMAKE_PATH "${d}" d)
            if(d MATCHES "^${ROOT}/(launcher|editor)(/|$)")
                list(APPEND problems "okay_anticheat is compiled with the include folder ${d}")
            endif()
        endforeach()
    endif()
endif()
if(problems)
    string(REPLACE ";" "\n" problems "${problems}")
    message(FATAL_ERROR "OkayAntiCheat (okay_anticheat) must not use launcher or editor code:\n${problems}")
endif()
message("anticheat_deps: ${problems_count} files in engine/include/okay/AntiCheat and engine/src/AntiCheat, no launcher or editor includes")
