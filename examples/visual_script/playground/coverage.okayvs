# Every text-script builtin, plus the escape hatches. Only the safe chain runs.
node 1 OnStart
entry OnStart 1
node 2 Fn.print
default 2 0 "playground"
exec 1 0 2
node 3 GetProperty GameObject.name
node 4 SetVar name
exec 2 0 3
exec 3 0 4
data 4 0 3 0
node 5 SetProperty GameObject.tag
default 5 0 demo
exec 4 0 5
node 6 CallMethod Mathf.Abs
default 6 0 -2
node 7 GetComponent Transform
node 8 AddComponent Light
node 9 FindByTag demo
node 10 AllWithTag demo
