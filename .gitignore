# Build output
build/
build-*/
out/
cmake-build-*/
bin/
_deps/
*.o
*.obj
!examples/obj_texture_paths/*.obj
*.a
*.so
*.dylib
*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
# ...but the engine's own okay::testing sources live in folders with that name
!engine/include/okay/Testing/
!engine/src/Testing/
compile_commands.json

# Editor / IDE
.vscode/
.idea/
*.swp
.DS_Store

# Packaged distribution archives (release artifacts, not source)
OkaySpace-*.zip
OkaySpacev*.zip
winbuild.log

# Claude Code agent worktrees (temporary, local only)
.claude/worktrees/

# Mixamo sample rigs fetched by GameObject > Spawn Mixamo Player
mixamo-cache/
__pycache__/

# fixtures are checked in
!tests/data/models/*.obj

# scripts/release-local.sh working files
.release-cache/
release-out/

# Files the engine writes into the folder it runs from (prefs, save slots, creations): a stray run from the
# repository root must not be committed. Tests use tests/test_sandbox.hpp so they never write here.
/game.okayprefs
/game.okayprefs.bak
/save.okaysave
/save.okaysave.bak
/saves/
/creations/
*.okayscene.bak

# Built programs are never committed (the release workflow and scripts/build-windows-dist.sh build them; branch_lint.py "binaries" enforces it).
# dist/ keeps only its text files (CHANGELOG.txt, VERSION.txt, steam_appid.txt, character_preview.png).
dist/*.exe
dist/*.dll
dist/*.so
dist/*.dylib
dist/*.zip
build-win-dist/

# Pictures and screenshots are not stored in the repository (owner rule, 2026-11-17)
docs/images/

# Failing golden tests write their actual picture here by accident when run by hand; never commit these
*.actual.png
dbg*.png

# Files the editor writes while running (never commit)
/imgui.ini
/okay_settings.txt
/okay_recovery/
/okay_recent.txt

# Import cache: compressed texture copies the engine builds next to pictures (rebuilt on demand)
.okaycache/
